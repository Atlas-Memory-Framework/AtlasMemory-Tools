def _bounded_budget_reduce(limits: dict, state: dict, event: dict) -> dict:
    """Purely validate and apply one reservation to bounded-cycle state."""
    limit_keys = {"max_steps", "max_claims", "max_roles", "role_max", "cycle_seconds"}
    state_keys = {"steps", "claims_reserved", "roles_reserved", "cancelled", "cancel_reason"}
    event_keys = {"kind", "elapsed_seconds", "stop_requested"}

    def exact_object(value: object, keys: set[str], label: str) -> dict:
        if not isinstance(value, dict) or set(value) != keys:
            raise ValueError(f"{label} must be a dictionary with exactly {sorted(keys)}")
        return value

    def integer(value: object, label: str, minimum: int, maximum: int | None = None) -> int:
        if isinstance(value, bool) or not isinstance(value, int) or value < minimum:
            raise ValueError(f"{label} must be an integer >= {minimum}")
        if maximum is not None and value > maximum:
            raise ValueError(f"{label} must be <= {maximum}")
        return value

    def finite_number(value: object, label: str, *, positive: bool) -> int | float:
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            raise ValueError(f"{label} must be a finite number")
        if isinstance(value, float) and not math.isfinite(value):
            raise ValueError(f"{label} must be a finite number")
        if value <= 0 if positive else value < 0:
            raise ValueError(f"{label} is outside its allowed range")
        return value

    limits = exact_object(limits, limit_keys, "limits")
    state = exact_object(state, state_keys, "state")
    event = exact_object(event, event_keys, "event")

    max_steps = integer(limits["max_steps"], "max_steps", 1)
    max_claims = integer(limits["max_claims"], "max_claims", 1)
    max_roles = integer(limits["max_roles"], "max_roles", 1)
    role_max = integer(limits["role_max"], "role_max", 1, 100)
    cycle_seconds = finite_number(limits["cycle_seconds"], "cycle_seconds", positive=True)

    steps = integer(state["steps"], "steps", 0, max_steps)
    claims = integer(state["claims_reserved"], "claims_reserved", 0, max_claims)
    roles = integer(state["roles_reserved"], "roles_reserved", 0, max_roles)
    cancelled = state["cancelled"]
    reason = state["cancel_reason"]
    if not isinstance(cancelled, bool) or reason not in (None, "stop", "deadline"):
        raise ValueError("invalid cancellation state")
    if cancelled != (reason is not None):
        raise ValueError("cancelled and cancel_reason must agree")

    kind = event["kind"]
    if kind not in ("check", "step", "claim", "launch"):
        raise ValueError("unknown event kind")
    elapsed = finite_number(event["elapsed_seconds"], "elapsed_seconds", positive=False)
    stop_requested = event["stop_requested"]
    if not isinstance(stop_requested, bool):
        raise ValueError("stop_requested must be a boolean")

    if not cancelled:
        if stop_requested:
            cancelled, reason = True, "stop"
        elif elapsed >= cycle_seconds:
            cancelled, reason = True, "deadline"

    new_state = {
        "steps": steps,
        "claims_reserved": claims,
        "roles_reserved": roles,
        "cancelled": cancelled,
        "cancel_reason": reason,
    }
    if cancelled:
        return {"state": new_state, "allowed": False, "role_allowance": 0, "stop_reason": "cancelled"}
    if kind == "check":
        return {"state": new_state, "allowed": True, "role_allowance": 0, "stop_reason": None}
    if kind == "step":
        if steps == max_steps or claims == max_claims or roles == max_roles:
            return {"state": new_state, "allowed": False, "role_allowance": 0, "stop_reason": "budget_stop"}
        new_state["steps"] += 1
    elif kind == "claim":
        if claims == max_claims or roles == max_roles:
            return {"state": new_state, "allowed": False, "role_allowance": 0, "stop_reason": "budget_stop"}
        new_state["claims_reserved"] += 1
    else:
        if roles == max_roles:
            return {"state": new_state, "allowed": False, "role_allowance": 0, "stop_reason": "budget_stop"}
        allowance = min(role_max, max_roles - roles)
        new_state["roles_reserved"] += allowance
        return {"state": new_state, "allowed": True, "role_allowance": allowance, "stop_reason": None}
    return {"state": new_state, "allowed": True, "role_allowance": 0, "stop_reason": None}


def _bounded_result_assessment(result: dict, expected: dict) -> dict:
    """Assess worker-returned JSON against caller-held trusted run expectations."""
    expected_keys = {
        "source_type", "source_id", "operation_id", "work_item_id", "template_id",
        "template_workflow_kind", "request_workflow_kind", "run_id", "completed_roles_before",
        "roles", "goal_required", "context_hash", "contract_hash",
    }
    invalid = {"decision": "stop", "reason": "invalid_result", "new_completed_roles": []}

    def require(condition: bool, message: str) -> None:
        if not condition:
            raise ValueError(message)

    def nonblank(value: object) -> bool:
        return isinstance(value, str) and bool(value.strip())

    def strings(value: object, *, nonempty: bool = False, unique: bool = False) -> bool:
        return (isinstance(value, list) and (not nonempty or bool(value))
                and all(nonblank(item) for item in value)
                and (not unique or len(value) == len(set(value))))

    def valid_hash(value: object) -> bool:
        return (isinstance(value, str) and len(value) == 64
                and all(ch in "0123456789abcdef" for ch in value))

    def plain_json(value: object, seen: set[int] | None = None) -> bool:
        if value is None or type(value) in (str, bool, int):
            return True
        if type(value) is float:
            return math.isfinite(value)
        if type(value) in (list, dict):
            seen = seen if seen is not None else set()
            identity = id(value)
            if identity in seen:
                return False
            seen.add(identity)
            if type(value) is list:
                valid = all(plain_json(item, seen) for item in value)
            else:
                valid = all(type(key) is str and plain_json(item, seen) for key, item in value.items())
            seen.remove(identity)
            return valid
        return False

    require(type(expected) is dict and set(expected) == expected_keys, "expected keys must match contract")
    for key in ("source_id", "operation_id", "work_item_id", "template_id", "template_workflow_kind"):
        require(nonblank(expected[key]), f"expected {key} must be nonblank")
    require(expected["source_type"] == "atlas_work_item", "unsupported source type")
    require(expected["work_item_id"] == expected["source_id"], "work item/source identity mismatch")
    require(nonblank(expected["request_workflow_kind"]) or expected["request_workflow_kind"] == "", "invalid request workflow kind")
    require(expected["run_id"] is None or nonblank(expected["run_id"]), "invalid expected run id")
    require(type(expected["goal_required"]) is bool, "goal_required must be boolean")
    require(valid_hash(expected["context_hash"]) and valid_hash(expected["contract_hash"]), "invalid expected hash")
    roles = expected["roles"]
    require(type(roles) is list and bool(roles), "expected roles must be nonempty")
    role_ids: list[str] = []
    outputs: list[str] = []
    role_by_id: dict[str, dict] = {}
    for role in roles:
        require(type(role) is dict and set(role) == {"role_id", "required_outputs", "consumes", "goal_gate"}, "invalid expected role record")
        require(nonblank(role["role_id"]), "invalid expected role id")
        require(strings(role["required_outputs"], nonempty=True, unique=True), "invalid expected outputs")
        require(strings(role["consumes"], unique=True), "invalid expected consumes")
        require(type(role["goal_gate"]) is bool, "invalid expected goal gate")
        role_ids.append(role["role_id"])
        outputs.extend(role["required_outputs"])
        role_by_id[role["role_id"]] = role
    require(len(role_ids) == len(set(role_ids)), "duplicate expected role id")
    require(len(outputs) == len(set(outputs)), "duplicate expected output")
    id_set = set(role_ids)
    require(all(set(role["consumes"]).issubset(id_set) and role["role_id"] not in role["consumes"] for role in roles), "invalid expected dependency")
    # Compute canonical template phases and reject cycles.
    remaining, completed, phases = set(role_ids), set(), []
    while remaining:
        ready = [rid for rid in role_ids if rid in remaining and set(role_by_id[rid]["consumes"]).issubset(completed)]
        require(bool(ready), "cyclic expected role graph")
        phases.append(ready)
        completed.update(ready)
        remaining.difference_update(ready)
    baseline = expected["completed_roles_before"]
    require(strings(baseline, unique=True), "invalid expected completed baseline")
    require(baseline == sorted(baseline), "expected completed baseline must be sorted")
    baseline_set = set(baseline)
    require(baseline_set.issubset(id_set), "baseline contains unknown role")
    require(all(set(role_by_id[rid]["consumes"]).issubset(baseline_set) for rid in baseline), "baseline is not dependency closed")
    require(expected["run_id"] is not None or not baseline_set, "fresh run must have an empty baseline")
    gates = [role["role_id"] for role in roles if role["goal_gate"]]
    require(not expected["goal_required"] or (len(gates) == 1 and gates[0] != "implementation"), "required goal must have one non-implementation gate")
    if expected["goal_required"]:
        gate = role_by_id[gates[0]]
        require("implementation" not in id_set or "implementation" in gate["consumes"], "goal gate must consume implementation")
        require("test-runner" not in id_set or "test-runner" in gate["consumes"], "goal gate must consume test-runner")
    required_goal = (expected["template_workflow_kind"] in {"work-item", "review"}
                     or expected["request_workflow_kind"] in {"work-item", "review"} or bool(gates))
    require(expected["goal_required"] == required_goal, "goal_required formula mismatch")

    def stop(reason: str) -> dict:
        return {"decision": "stop", "reason": reason, "new_completed_roles": []}

    try:
        if type(result) is not dict or not plain_json(result) or set(result) != {"status", "returncode", "summary", "evidence"}:
            return invalid
        status, returncode, summary, evidence = (result[k] for k in ("status", "returncode", "summary", "evidence"))
        if not isinstance(status, str) or type(returncode) is not int or not isinstance(summary, str) or type(evidence) is not dict:
            return invalid
        if status not in {"ready", "queued", "done", "failed", "blocked"}:
            return invalid
        required_evidence = {
            "process_invocation_id", "invocation_completed", "termination_proved", "completed_roles_before",
            "completed_roles", "attempted_roles", "team_roles", "team_run_status", "missing_outputs",
            "goal_review_required", "goal_acceptance", "contract_hash", "team_run",
        }
        if not required_evidence.issubset(evidence):
            return invalid
        if not nonblank(evidence["process_invocation_id"]):
            return invalid
        if type(evidence["invocation_completed"]) is not bool or type(evidence["termination_proved"]) is not bool:
            return invalid
        if type(evidence["goal_review_required"]) is not bool or evidence["goal_review_required"] != expected["goal_required"]:
            return invalid
        if not isinstance(evidence["contract_hash"], str):
            return invalid
        if evidence["contract_hash"] != expected["contract_hash"]:
            return invalid
        if not strings(evidence["completed_roles_before"], unique=True) or set(evidence["completed_roles_before"]) != baseline_set:
            return invalid
        completed_roles = evidence["completed_roles"]
        attempted = evidence["attempted_roles"]
        team_roles = evidence["team_roles"]
        if not strings(completed_roles, unique=True) or not strings(attempted, unique=True) or not strings(team_roles, nonempty=True, unique=True):
            return invalid
        if team_roles != role_ids or not set(completed_roles).issubset(id_set) or not set(attempted).issubset(id_set):
            return invalid
        completed_set, attempted_set = set(completed_roles), set(attempted)
        if not baseline_set.issubset(completed_set) or not completed_set.issubset(attempted_set):
            return invalid
        goal = evidence["goal_acceptance"]
        if type(goal) is not dict or set(goal) != {"verdict", "reason", "evidence", "role_id", "context_hash", "contract_hash"}:
            return invalid
        if goal["context_hash"] != expected["context_hash"] or goal["contract_hash"] != expected["contract_hash"]:
            return invalid
        if not isinstance(goal["verdict"], str) or not nonblank(goal["reason"]) or not strings(goal["evidence"]):
            return invalid
        if goal["role_id"] != (gates[0] if len(gates) == 1 else None):
            return invalid
        if goal["verdict"] not in {"missing", "pass", "fail", "inconclusive"}:
            return invalid
        if type(evidence["team_run"]) is not dict:
            return invalid
        run = evidence["team_run"]
        for key in ("run_id", "template_id", "work_item_id", "workflow_kind", "status"):
            if not nonblank(run.get(key)):
                return invalid
        if run["template_id"] != expected["template_id"] or run["work_item_id"] != expected["work_item_id"] or run["workflow_kind"] != expected["template_workflow_kind"]:
            return invalid
        if expected["run_id"] is not None:
            if run["run_id"] != expected["run_id"]:
                return invalid
        elif run["run_id"] != atlas_work_items.safe_id(expected["work_item_id"]) + "-" + evidence["process_invocation_id"]:
            return invalid
        if type(run.get("roles")) is not list or len(run["roles"]) != len(roles):
            return invalid
        run_missing = {rid: role_by_id[rid]["required_outputs"] for rid in role_ids if rid not in completed_set}
        if type(run.get("missing_outputs")) is not dict or run["missing_outputs"] != run_missing:
            return invalid
        if type(evidence["missing_outputs"]) is not dict or evidence["missing_outputs"] != run_missing:
            return invalid
        if run["status"] != evidence["team_run_status"] or evidence["team_run_status"] not in {"running", "complete"}:
            return invalid
        if (evidence["team_run_status"] == "running") != bool(run_missing):
            return invalid
        if run.get("role_phases") != phases:
            return invalid
        role_failure_reason = None
        for entry, trusted_role in zip(run["roles"], roles):
            if type(entry) is not dict or set(entry) != {"role_id", "status", "required_outputs", "completed_outputs", "contract_issues", "dependency_blockers", "goal_gate", "goal_review"}:
                return invalid
            rid = trusted_role["role_id"]
            if entry["role_id"] != rid or entry["required_outputs"] != trusted_role["required_outputs"] or type(entry["goal_gate"]) is not bool or entry["goal_gate"] != trusted_role["goal_gate"]:
                return invalid
            if not strings(entry["completed_outputs"], unique=True) or not set(entry["completed_outputs"]).issubset(set(trusted_role["required_outputs"])):
                return invalid
            if not strings(entry["contract_issues"]) or not strings(entry["dependency_blockers"]):
                return invalid
            if entry["goal_review"] is not None and type(entry["goal_review"]) is not dict:
                return invalid
            if entry["goal_review"] is not None and _bounded_goal_review_issues(entry["goal_review"]):
                return invalid
            if rid not in attempted_set:
                if entry["status"] != "pending" or entry["completed_outputs"] or entry["goal_review"] is not None or entry["contract_issues"]:
                    return invalid
            elif entry["status"] not in {"complete", "failed", "blocked", "pending", "running", "incomplete", "dry-run"}:
                return invalid
            if rid in completed_set:
                if (entry["status"] != "complete" or set(entry["completed_outputs"]) != set(trusted_role["required_outputs"])
                    or entry["contract_issues"] or not set(trusted_role["consumes"]).issubset(completed_set)):
                    return invalid
                if trusted_role["goal_gate"] and not _bounded_goal_review_valid(entry["goal_review"]):
                    return invalid
            if entry["status"] in {"failed", "blocked", "incomplete"} or entry["contract_issues"]:
                if role_failure_reason is None:
                    role_failure_reason = "failed" if entry["status"] != "blocked" else "blocked"
        gate_result = next((role for role in run["roles"] if role["role_id"] in gates), None)
        if status in {"ready", "queued"}:
            cont = evidence.get("workflow_continuation")
            if (type(cont) is not dict or set(cont) != {"reason", "next_status"}
                or not nonblank(cont.get("reason")) or cont.get("next_status") != status):
                return invalid
            if evidence["team_run_status"] != "running" or not run_missing:
                return invalid
        else:
            cont = None
        if gate_result is not None and type(gate_result.get("goal_review")) is dict:
            review = gate_result["goal_review"]
            if goal["verdict"] != review["verdict"] or goal["reason"] != review["reason"] or goal["evidence"] != review["evidence"]:
                return invalid
        if goal["verdict"] in {"fail", "inconclusive"} and (
            gate_result is None or type(gate_result.get("goal_review")) is not dict
        ):
            return invalid
        if goal["verdict"] == "pass":
            if (gate_result is None or not _bounded_goal_review_valid(gate_result.get("goal_review"))
                or gate_result["goal_review"] != {k: goal[k] for k in ("verdict", "reason", "evidence")}):
                return invalid
        # Validate candidate-specific relationships before classifying any
        # otherwise-valid result as a semantic stop (for example, no progress
        # or uncertain process termination).
        if status in {"ready", "queued"} and goal["verdict"] == "missing":
            if not expected["goal_required"]:
                return invalid
            gate_id = gates[0]
            if gate_id in attempted_set or gate_id in completed_set:
                return invalid
            gate_entry = next(role for role in run["roles"] if role["role_id"] == gate_id)
            if gate_entry["status"] != "pending" or gate_entry["goal_review"] is not None:
                return invalid
        if status == "done":
            if evidence["team_run_status"] != "complete" or run_missing or completed_set != id_set:
                return invalid
            if expected["goal_required"] and goal["verdict"] != "pass":
                return invalid
            gate_entry = next((role for role in run["roles"] if role["role_id"] in gates), None)
            if expected["goal_required"] and (gate_entry is None or gate_entry["goal_review"] != {k: goal[k] for k in ("verdict", "reason", "evidence")}):
                return invalid
        if expected["goal_required"] and (goal["verdict"] in {"fail", "inconclusive"}
            or (gate_result is not None and type(gate_result.get("goal_review")) is dict
                and gate_result["goal_review"].get("verdict") in {"fail", "inconclusive"})):
            return stop("goal_review_failed")
        if not evidence["invocation_completed"] or not evidence["termination_proved"]:
            return stop("process_uncertain")
        if role_failure_reason is not None:
            return stop(role_failure_reason)
        if returncode != 0:
            return stop("blocked" if status == "blocked" else "failed")
        new_roles = sorted(completed_set - baseline_set)
        if status in {"ready", "queued"}:
            if not new_roles:
                return stop("zero_progress")
            return {"decision": "continue_candidate", "reason": None, "new_completed_roles": new_roles}
        if status == "done":
            return {"decision": "done_candidate", "reason": None, "new_completed_roles": new_roles}
        return stop("blocked" if status == "blocked" else "failed")
    except (KeyError, TypeError, ValueError, AttributeError, RecursionError):
        return invalid


def _bounded_goal_review_valid(review: object) -> bool:
    return type(review) is dict and not _bounded_goal_review_issues(review) and review.get("verdict") == "pass"


def _bounded_goal_review_issues(review: object) -> list[str]:
    import atlas_workflows

    if type(review) is not dict:
        return ["goal review is not an object"]
    return atlas_workflows.goal_review_issues(review)


def _decode_cycle_pins(raw: bytes) -> dict:
    """Decode and validate a pins-v1 JSON value without observing the filesystem."""
    def reject(message: str) -> None:
        raise ValueError(message)

    if type(raw) is not bytes:
        reject("pins input must be bytes")

    def pairs_no_duplicates(pairs: list[tuple[str, object]]) -> dict:
        value: dict = {}
        for key, item in pairs:
            if key in value:
                reject("duplicate JSON object key")
            value[key] = item
        return value

    def reject_constant(value: str) -> None:
        reject(f"nonfinite JSON number: {value}")

    try:
        text = raw.decode("utf-8", errors="strict")
        decoded = json.loads(text, object_pairs_hook=pairs_no_duplicates, parse_constant=reject_constant)
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as exc:
        raise ValueError("pins must be one strict UTF-8 JSON object") from exc
    if type(decoded) is not dict:
        reject("pins root must be an object")

    def exact(obj: object, keys: set[str], label: str) -> dict:
        if type(obj) is not dict or set(obj) != keys:
            reject(f"{label} has missing or extra keys")
        return obj

    def string(value: object, label: str, *, nonblank: bool = True) -> str:
        if type(value) is not str or (nonblank and not value.strip()):
            reject(f"{label} must be a string" + (" with nonblank content" if nonblank else ""))
        return value

    def array(value: object, label: str, *, nonempty: bool = False) -> list:
        if type(value) is not list or (nonempty and not value):
            reject(f"{label} must be a list" + (" with at least one item" if nonempty else ""))
        return value

    def ordered_unique(values: list, label: str, key=lambda value: value) -> None:
        projected = [key(value) for value in values]
        if projected != sorted(projected) or len(projected) != len(set(projected)):
            reject(f"{label} must be sorted and unique")

    def digest(value: object, label: str, *, nullable: bool = False) -> None:
        if nullable and value is None:
            return
        if type(value) is not str or len(value) != 64 or any(ch not in "0123456789abcdef" for ch in value):
            reject(f"{label} must be a lowercase SHA-256 digest" + (" or null" if nullable else ""))

    def git_head(value: object, label: str) -> None:
        if type(value) is not str or len(value) not in (40, 64) or any(ch not in "0123456789abcdef" for ch in value):
            reject(f"{label} must be a lowercase full Git object id")

    def path(value: object, label: str, *, absolute: bool) -> str:
        value = string(value, label)
        if "\x00" in value or "\\" in value or any(ch in value for ch in "*?[]:"):
            reject(f"{label} contains a forbidden path character")
        if absolute:
            if not value.startswith("/") or value == "/" or value.endswith("/"):
                reject(f"{label} must be a non-root absolute path without trailing slash")
            components = value[1:].split("/")
        else:
            if value.startswith("/") or value.startswith("~") or value.endswith("/"):
                reject(f"{label} must be a relative path without a home prefix or trailing slash")
            components = value.split("/")
        if any(part in ("", ".", "..") for part in components):
            reject(f"{label} has a noncanonical component")
        if not absolute and any(part == ".git" for part in components):
            reject(f"{label} cannot name .git")
        return value

    root_keys = {"schema_version", "kind", "queue_path", "runtime", "execution_checkouts", "inputs", "admitted_item_ids", "item_closure", "template_source"}
    exact(decoded, root_keys, "pins")
    if type(decoded["schema_version"]) is not int or decoded["schema_version"] != 1:
        reject("unsupported pins schema_version")
    if decoded["kind"] != "atlas-local-supervisor-pins":
        reject("unknown pins kind")
    path(decoded["queue_path"], "queue_path", absolute=True)

    runtime = exact(decoded["runtime"], {"checkout_path", "head"}, "runtime")
    runtime_path = path(runtime["checkout_path"], "runtime.checkout_path", absolute=True)
    git_head(runtime["head"], "runtime.head")

    checkouts = array(decoded["execution_checkouts"], "execution_checkouts", nonempty=True)
    checkout_paths = []
    for checkout in checkouts:
        checkout = exact(checkout, {"checkout_path", "head", "entry_changes"}, "execution checkout")
        checkout["checkout_path"] = path(checkout["checkout_path"], "execution checkout path", absolute=True)
        git_head(checkout["head"], "execution checkout head")
        checkout_paths.append(checkout["checkout_path"])
        entries = array(checkout["entry_changes"], "entry_changes")
        for entry in entries:
            entry = exact(entry, {"path", "index_sha256", "worktree_sha256", "index_state", "worktree_state"}, "entry change")
            entry["path"] = path(entry["path"], "entry path", absolute=False)
            digest(entry["index_sha256"], "index_sha256", nullable=True)
            digest(entry["worktree_sha256"], "worktree_sha256", nullable=True)
            index_state, worktree_state = entry["index_state"], entry["worktree_state"]
            if type(index_state) is not str or type(worktree_state) is not str:
                reject("entry states must be strings")
            if index_state not in {"unchanged", "added", "modified", "deleted", "untracked"}:
                reject("unknown index_state")
            if worktree_state not in {"unchanged", "modified", "deleted", "untracked"}:
                reject("unknown worktree_state")
            index_present = index_state in {"unchanged", "added", "modified"}
            worktree_present = worktree_state in {"unchanged", "modified", "untracked"}
            if (entry["index_sha256"] is not None) != index_present or (entry["worktree_sha256"] is not None) != worktree_present:
                reject("entry state contradicts declared digest presence")
            if worktree_state == "untracked" and index_state != "untracked":
                reject("untracked worktree entry requires an untracked index state")
            if index_state == "untracked" and worktree_state != "untracked":
                reject("untracked index entry has contradictory worktree state")
            if index_state == "deleted" and worktree_state not in {"deleted", "untracked"}:
                reject("deleted index entry has contradictory worktree state")
        ordered_unique(entries, "entry_changes", lambda entry: entry["path"])
    ordered_unique(checkouts, "execution_checkouts", lambda checkout: checkout["checkout_path"])

    inputs = array(decoded["inputs"], "inputs", nonempty=True)
    for item in inputs:
        item = exact(item, {"kind", "path", "sha256"}, "input")
        if type(item["kind"]) is not str or item["kind"] not in {"plan", "spec", "role_command_config", "team_template", "registry", "agent_instruction", "entry_file"}:
            reject("unknown input kind")
        item["path"] = path(item["path"], "input path", absolute=True)
        digest(item["sha256"], "input sha256")
    ordered_unique(inputs, "inputs", lambda item: item["path"])
    input_paths = {item["path"] for item in inputs}
    entry_file_inputs = {item["path"]: item for item in inputs if item["kind"] == "entry_file"}
    input_digests = [item["sha256"] for item in inputs]
    if len(input_digests) != len(set(input_digests)):
        reject("input digests must be unique")
    if sum(item["kind"] == "role_command_config" for item in inputs) != 1:
        reject("exactly one role_command_config input is required")
    for checkout in checkouts:
        for entry in checkout["entry_changes"]:
            changed_present = (entry["worktree_sha256"] is not None and
                               (entry["index_state"] != "unchanged" or entry["worktree_state"] != "unchanged"))
            declared = checkout["checkout_path"].rstrip("/") + "/" + entry["path"]
            if changed_present and declared not in input_paths:
                reject("changed present entry file must be declared as an input")
            if changed_present and not any(item["path"] == declared and item["kind"] == "entry_file" for item in inputs):
                reject("changed present entry file must use entry_file input kind")
            if changed_present and entry_file_inputs[declared]["sha256"] != entry["worktree_sha256"]:
                reject("entry_file input digest must match declared worktree digest")

    admitted = array(decoded["admitted_item_ids"], "admitted_item_ids", nonempty=True)
    for item_id in admitted:
        string(item_id, "admitted item id")
    ordered_unique(admitted, "admitted_item_ids")

    closure = array(decoded["item_closure"], "item_closure", nonempty=True)
    for item in closure:
        item = exact(item, {"item_id", "operation_id", "execution_checkout", "depends_on", "immutable_sha256"}, "closure item")
        string(item["item_id"], "closure item_id")
        string(item["operation_id"], "closure operation_id")
        path(item["execution_checkout"], "closure execution_checkout", absolute=True)
        deps = array(item["depends_on"], "depends_on")
        for dependency in deps:
            string(dependency, "dependency id")
        ordered_unique(deps, "depends_on")
        digest(item["immutable_sha256"], "immutable_sha256")
    ordered_unique(closure, "item_closure", lambda item: item["item_id"])
    closure_ids = [item["item_id"] for item in closure]
    operation_ids = [item["operation_id"] for item in closure]
    if len(operation_ids) != len(set(operation_ids)):
        reject("closure operation ids must be unique")
    closure_by_id = {item["item_id"]: item for item in closure}
    if not set(admitted).issubset(closure_by_id):
        reject("every admitted item must exist in closure")
    if not set(item["execution_checkout"] for item in closure).issubset(set(checkout_paths)):
        reject("every closure checkout must be enumerated")
    for item in closure:
        if not set(item["depends_on"]).issubset(closure_by_id):
            reject("dangling closure dependency")
    reachable: set[str] = set()
    complete: set[str] = set()
    for admitted_id in admitted:
        if admitted_id in complete:
            continue
        active: set[str] = {admitted_id}
        stack: list[tuple[str, int]] = [(admitted_id, 0)]
        while stack:
            item_id, next_dependency = stack[-1]
            dependencies = closure_by_id[item_id]["depends_on"]
            if next_dependency == len(dependencies):
                stack.pop()
                active.remove(item_id)
                complete.add(item_id)
                reachable.add(item_id)
                continue
            dependency = dependencies[next_dependency]
            stack[-1] = (item_id, next_dependency + 1)
            if dependency in active:
                reject("closure dependency cycle")
            if dependency not in complete:
                active.add(dependency)
                stack.append((dependency, 0))
    if reachable != set(closure_ids):
        reject("item_closure must be exactly the complete admitted dependency closure")

    source = exact(decoded["template_source"], {"mode", "path", "candidates"}, "template_source")
    if type(source["mode"]) is not str or source["mode"] not in {"directory", "file"}:
        reject("unknown template source mode")
    source["path"] = path(source["path"], "template_source.path", absolute=True)
    candidates = array(source["candidates"], "template_source.candidates", nonempty=True)
    for candidate in candidates:
        path(candidate, "template candidate", absolute=True)
    ordered_unique(candidates, "template candidates")
    templates = {item["path"] for item in inputs if item["kind"] == "team_template"}
    if source["mode"] == "file":
        if candidates != [source["path"]] or templates != {source["path"]}:
            reject("file template source must name exactly one declared team_template input")
    else:
        for candidate in candidates:
            parent, _, basename = candidate.rpartition("/")
            if parent != source["path"] or not basename.endswith(".json") or candidate not in templates:
                reject("directory candidates must be immediate declared JSON template inputs")
        if not templates.issubset(set(candidates)):
            reject("every team_template input must be a directory candidate")

    return copy.deepcopy(decoded)


def _decode_cycle_receipt(raw: bytes) -> list[dict]:
    """Decode strict receipt-v1 JSONL while preserving every recorded observation."""
    if type(raw) is not bytes or not raw or not raw.endswith(b"\n") or b"\r" in raw:
        raise ValueError("receipt must be nonempty LF-terminated bytes without CR")
    event_keys = {
        "schema_version", "kind", "queue_path", "queue_key", "cycle_id", "seq", "event",
        "elapsed_seconds", "prior_event_acknowledged", "initialization_ack", "pins_sha256",
        "admitted_fingerprints", "limits", "counters", "operation_id", "source_id", "claim_key",
        "invocation_id", "effects", "result_sha256", "stored_result_sha256", "controller_reason",
        "terminal_outcome", "unresolved",
    }
    limit_keys = {"max_steps", "max_claims", "max_roles", "role_max", "cycle_seconds", "worker_timeout_seconds", "worker_termination_grace_seconds", "stop_file"}
    counter_keys = {"steps", "claims_reserved", "roles_reserved", "observed_completed_roles"}
    effect_keys = {"claim", "launch", "result"}
    reason_values = {
        "no_work", "budget_stop", "stop", "deadline", "signal", "stop_inspection_error", "claim_unknown",
        "launch_unknown", "result_unknown", "receipt_unknown", "queue_disagreement", "process_uncertain",
        "invalid_result", "goal_review_failed", "zero_progress", "input_changed", "out_of_scope_change",
        "completed", "blocked", "failed",
    }
    event_values = {"opened", "step_started", "claim_intent", "claimed", "claim_not_acquired", "launch_intent", "worker_returned", "result_intent", "result_acknowledged", "claim_settled", "terminal", "closed"}
    terminal_values = {None, "no_work", "budget_stop", "cancelled", "blocked", "failed", "input_changed", "completed"}

    def reject(message: str) -> None:
        raise ValueError(message)

    def parse_pairs(pairs: list[tuple[str, object]]) -> dict:
        value = {}
        for key, item in pairs:
            if key in value:
                reject("duplicate receipt JSON key")
            value[key] = item
        return value

    def bad_constant(value: str) -> None:
        reject(f"nonfinite receipt JSON number: {value}")

    def exact(obj: object, keys: set[str], label: str) -> dict:
        if type(obj) is not dict or set(obj) != keys:
            reject(f"{label} has missing or extra keys")
        return obj

    def sha(value: object, label: str) -> None:
        if type(value) is not str or len(value) != 64 or any(ch not in "0123456789abcdef" for ch in value):
            reject(f"{label} must be a lowercase SHA-256 digest")

    def absolute_path(value: object, label: str) -> None:
        if type(value) is not str or not value.strip() or not value.startswith("/") or value == "/" or value.endswith("/"):
            reject(f"{label} must be a non-root absolute path")
        if "\x00" in value or "\\" in value or any(ch in value for ch in "*?[]:"):
            reject(f"{label} contains forbidden path characters")
        if any(part in ("", ".", "..") for part in value[1:].split("/")):
            reject(f"{label} has a noncanonical path component")

    def nonblank(value: object, label: str) -> None:
        if type(value) is not str or not value.strip():
            reject(f"{label} must be a nonblank string")

    def finite_number(value: object, label: str, *, positive: bool = False) -> None:
        if type(value) not in (int, float) or (type(value) is float and not math.isfinite(value)):
            reject(f"{label} must be finite numeric data")
        if value < 0 or (positive and value <= 0):
            reject(f"{label} is outside its allowed range")

    def integer(value: object, label: str, minimum: int = 0) -> None:
        if type(value) is not int or value < minimum:
            reject(f"{label} must be an integer >= {minimum}")

    def parse_line(line: bytes) -> dict:
        if not line.strip():
            reject("receipt contains a blank line")
        try:
            value = json.loads(line.decode("utf-8", errors="strict"), object_pairs_hook=parse_pairs, parse_constant=bad_constant)
        except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as exc:
            raise ValueError("receipt line is not strict UTF-8 JSON") from exc
        return exact(value, event_keys, "receipt event")

    try:
        events = [parse_line(line) for line in raw[:-1].split(b"\n")]
    except RecursionError as exc:
        raise ValueError("receipt nesting is too deep") from exc
    previous = None
    stable_fields = None
    prior_elapsed = 0
    prior_counters = None
    for index, event in enumerate(events):
        if type(event["schema_version"]) is not int or event["schema_version"] != 1:
            reject("unsupported receipt schema version")
        if (event["kind"] != "atlas-local-supervisor-event" or type(event["event"]) is not str
            or event["event"] not in event_values):
            reject("unknown receipt kind or event")
        absolute_path(event["queue_path"], "queue_path")
        sha(event["queue_key"], "queue_key")
        if event["queue_key"] != hashlib.sha256(event["queue_path"].encode("utf-8")).hexdigest():
            reject("queue_key does not match queue_path")
        if type(event["cycle_id"]) is not str or len(event["cycle_id"]) != 32 or any(ch not in "0123456789abcdef" for ch in event["cycle_id"]):
            reject("cycle_id must be 32 lowercase hexadecimal characters")
        integer(event["seq"], "seq")
        if event["seq"] != index:
            reject("receipt sequence must begin at zero and be consecutive")
        if event["prior_event_acknowledged"] is not None:
            integer(event["prior_event_acknowledged"], "prior_event_acknowledged")
        if event["prior_event_acknowledged"] != (None if previous is None else previous["seq"]):
            reject("receipt prior acknowledgment does not match the prior sequence")
        if type(event["initialization_ack"]) is not str or event["initialization_ack"] != "acknowledged":
            reject("receipt initialization acknowledgment is invalid")
        finite_number(event["elapsed_seconds"], "elapsed_seconds")
        if event["elapsed_seconds"] < prior_elapsed:
            reject("receipt elapsed time cannot decrease")
        sha(event["pins_sha256"], "pins_sha256")

        fingerprints = event["admitted_fingerprints"]
        if type(fingerprints) is not dict or not fingerprints:
            reject("admitted_fingerprints must be a nonempty object")
        for item_id, fingerprint in fingerprints.items():
            nonblank(item_id, "fingerprint item id")
            sha(fingerprint, "item fingerprint")

        limits = exact(event["limits"], limit_keys, "limits")
        for name in ("max_steps", "max_claims", "max_roles"):
            integer(limits[name], name, 1)
        integer(limits["role_max"], "role_max", 1)
        if limits["role_max"] > 100:
            reject("role_max cannot exceed 100")
        finite_number(limits["cycle_seconds"], "cycle_seconds", positive=True)
        finite_number(limits["worker_timeout_seconds"], "worker_timeout_seconds", positive=True)
        finite_number(limits["worker_termination_grace_seconds"], "worker_termination_grace_seconds")
        absolute_path(limits["stop_file"], "stop_file")

        counters = exact(event["counters"], counter_keys, "counters")
        for name in counter_keys:
            integer(counters[name], name)
        if counters["steps"] > limits["max_steps"] or counters["claims_reserved"] > limits["max_claims"] or counters["roles_reserved"] > limits["max_roles"]:
            reject("receipt counter exceeds configured budget")
        if counters["observed_completed_roles"] > counters["roles_reserved"]:
            reject("observed roles cannot exceed reserved roles")
        if prior_counters is not None and any(counters[name] < prior_counters[name] for name in counter_keys):
            reject("receipt counters cannot decrease")

        for name in ("operation_id", "source_id", "invocation_id"):
            value = event[name]
            if value is not None:
                nonblank(value, name)
        claim_key = event["claim_key"]
        if claim_key is not None:
            sha(claim_key, "claim_key")
        effects = exact(event["effects"], effect_keys, "effects")
        for effect_name in effect_keys:
            effect = exact(effects[effect_name], {"attempted", "ack"}, f"{effect_name} effect")
            if (type(effect["attempted"]) is not bool or type(effect["ack"]) is not str
                or effect["ack"] not in {"not_attempted", "pending", "acknowledged", "unknown"}):
                reject(f"invalid {effect_name} effect type or acknowledgment")
            if ((effect["ack"] == "not_attempted" and effect["attempted"])
                or (effect["ack"] in {"acknowledged", "unknown"} and not effect["attempted"])
                or (effect["ack"] == "pending" and effect["attempted"])):
                reject(f"inconsistent {effect_name} effect observation")
        for name in ("result_sha256", "stored_result_sha256"):
            if event[name] is not None:
                sha(event[name], name)
        reason = event["controller_reason"]
        if reason is not None and (type(reason) is not str or reason not in reason_values):
            reject("unknown controller_reason")
        if event["terminal_outcome"] is not None and type(event["terminal_outcome"]) is not str:
            reject("terminal_outcome must be a string or null")
        if event["terminal_outcome"] not in terminal_values:
            reject("unknown terminal_outcome")
        if type(event["unresolved"]) is not bool:
            reject("unresolved must be a boolean")

        if stable_fields is None:
            stable_fields = {
                "queue_path": event["queue_path"], "queue_key": event["queue_key"], "cycle_id": event["cycle_id"],
                "initialization_ack": event["initialization_ack"], "pins_sha256": event["pins_sha256"],
                "admitted_fingerprints": event["admitted_fingerprints"], "limits": event["limits"],
            }
        elif any(event[name] != stable_fields[name] for name in stable_fields):
            reject("receipt identity, pins, admission, or limits changed")
        previous = event
        prior_elapsed = event["elapsed_seconds"]
        prior_counters = counters
    return copy.deepcopy(events)


class _RecoveryProtocol:
    """Pure v2 shape checks. Readable history supplies candidates, never authority."""
    FIELDS = {"controller_epoch", "origin", "recovery_state", "revalidated_prefix_sha256", "old_tail_acknowledgment"}
    BOUNDARIES = {"recovery_ready", "claim_settled", "recovery_admitted", "terminal", "closed"}

    @staticmethod
    def require(ok: bool, message: str) -> None:
        if not ok:
            raise ValueError(message)

    @classmethod
    def exact(cls, value, keys, label):
        cls.require(type(value) is dict and set(value) == set(keys), f"invalid {label} fields")
        return value

    @classmethod
    def text(cls, value, label):
        cls.require(type(value) is str and bool(value.strip()), f"invalid {label}")

    @classmethod
    def hex(cls, value, lengths, label):
        cls.require(type(value) is str and len(value) in lengths
                    and all(ch in "0123456789abcdef" for ch in value), f"invalid {label}")

    @classmethod
    def number(cls, value, label):
        try:
            valid = type(value) in (int, float) and math.isfinite(value) and value >= 0
        except OverflowError:
            valid = False
        cls.require(valid, f"invalid finite nonnegative {label}")

    @classmethod
    def integer(cls, value, label):
        cls.require(type(value) is int and value >= 0, f"invalid {label}")

    @classmethod
    def strings(cls, value, label, *, nonempty=False):
        cls.require(type(value) is list and (bool(value) or not nonempty), f"invalid {label}")
        for item in value:
            cls.text(item, label)
        cls.require(value == sorted(set(value)), f"{label} must be sorted and unique")

    @classmethod
    def path(cls, value, *, absolute=True):
        cls.text(value, "path")
        cls.require(not any(ch in value for ch in "\x00\\*?[]:") and not value.endswith("/")
                    and value.startswith("/") == absolute and not value.startswith("~")
                    and all(part not in {"", ".", ".."} for part in (value[1:] if absolute else value).split("/"))
                    and (absolute or ".git" not in value.split("/")), "invalid canonical path")

    @classmethod
    def origin(cls, value):
        cls.exact(value, {"boot_id", "entry_monotonic", "pins_path"}, "origin")
        cls.require(type(value["boot_id"]) is str and re.fullmatch(
            r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", value["boot_id"]) is not None,
            "invalid Linux boot UUID")
        cls.number(value["entry_monotonic"], "entry_monotonic")
        cls.path(value["pins_path"])

    @classmethod
    def snapshot(cls, snapshot, admitted):
        cls.exact(snapshot, {"input_digests", "template_candidates", "runtime_head", "execution_heads",
                            "entry_changes", "immutable_inputs", "expected_static"}, "source_snapshot")
        digests = snapshot["input_digests"]
        cls.require(type(digests) is dict and bool(digests), "invalid input_digests")
        for path, digest in digests.items():
            cls.path(path)
            cls.hex(digest, {64}, "input digest")
        candidates = snapshot["template_candidates"]
        cls.strings(candidates, "template_candidates", nonempty=True)
        cls.require(set(candidates).issubset(digests), "template candidate lacks input digest")
        for path in candidates:
            cls.path(path)
        cls.hex(snapshot["runtime_head"], {40, 64}, "runtime_head")
        heads = snapshot["execution_heads"]
        cls.require(type(heads) is dict and bool(heads), "invalid execution_heads")
        for path, head in heads.items():
            cls.path(path)
            cls.hex(head, {40, 64}, "execution head")
        cls.exact(snapshot["entry_changes"], heads, "entry_changes")
        for entries in snapshot["entry_changes"].values():
            cls.require(type(entries) is list, "invalid entry_changes list")
            paths = []
            for entry in entries:
                cls.exact(entry, {"path", "index_sha256", "worktree_sha256", "index_state", "worktree_state"}, "entry change")
                cls.path(entry["path"], absolute=False)
                paths.append(entry["path"])
                for layer in ("index", "worktree"):
                    state = entry[layer + "_state"]
                    states = {"unchanged", "modified", "deleted", "untracked"} | ({"added"} if layer == "index" else set())
                    cls.require(type(state) is str and state in states, "invalid entry layer state")
                    digest = entry[layer + "_sha256"]
                    present = state in {"unchanged", "modified", "added" if layer == "index" else "untracked"}
                    cls.require((digest is not None) == present, "entry layer digest/state mismatch")
                    if digest is not None:
                        cls.hex(digest, {64}, "entry layer digest")
                cls.require((entry["index_state"] == "untracked") == (entry["worktree_state"] == "untracked")
                            and (entry["index_state"] != "deleted" or entry["worktree_state"] in {"deleted", "untracked"}),
                            "entry layers disagree")
            cls.strings(paths, "entry paths")
        immutable = snapshot["immutable_inputs"]
        cls.require(type(immutable) is dict and set(admitted).issubset(immutable), "invalid immutable_inputs")
        operations = []
        for sid, item in immutable.items():
            cls.text(sid, "immutable source id")
            cls.exact(item, {"source_id", "operation_id", "source_type", "title", "target_repo", "execution_repo",
                             "base_branch", "write_scope", "depends_on", "context", "scheduling"}, "immutable input")
            cls.require(item["source_id"] == sid and item["source_type"] == "atlas_work_item", "immutable source mismatch")
            cls.text(item["operation_id"], "immutable operation id")
            operations.append(item["operation_id"])
            for key in ("title", "target_repo", "base_branch"):
                cls.require(type(item[key]) is str, f"invalid immutable {key}")
            cls.path(item["execution_repo"])
            cls.require(item["execution_repo"] in heads, "immutable checkout is not enumerated")
            cls.strings(item["write_scope"], "write_scope")
            for path in item["write_scope"]:
                cls.path(path, absolute=False)
            cls.strings(item["depends_on"], "depends_on")
            cls.require(set(item["depends_on"]).issubset(immutable), "missing immutable dependency")
            cls.require(type(item["context"]) is dict, "invalid immutable context")
            cls.exact(item["scheduling"], {"priority", "parallel_group", "critical_path_rank", "combine_policy",
                                         "validation_tier", "workflow_kind", "team_template", "required_outputs"}, "scheduling")
            if sid in admitted:
                cls.require(atlas_work_items.content_hash(item) == admitted[sid], "immutable fingerprint mismatch")
        cls.require(len(operations) == len(set(operations)), "duplicate immutable operation")
        reachable, active = set(), set()
        def visit(sid):
            cls.require(sid not in active, "cyclic immutable dependency")
            if sid in reachable:
                return
            active.add(sid)
            for dependency in immutable[sid]["depends_on"]:
                visit(dependency)
            active.remove(sid)
            reachable.add(sid)
        for sid in admitted:
            visit(sid)
        cls.require(reachable == set(immutable), "immutable closure is not exact")
        cls.exact(snapshot["expected_static"], admitted, "expected_static")
        for sid, expected in snapshot["expected_static"].items():
            cls.require(type(expected) is dict and "run_id" not in expected and "completed_roles_before" not in expected,
                        "expected_static contains progress")
            _bounded_result_assessment({}, expected | {"run_id": None, "completed_roles_before": []})
            cls.require(expected["source_id"] == sid and expected["operation_id"] == immutable[sid]["operation_id"],
                        "static expectation identity mismatch")

    @classmethod
    def capsule(cls, event, previous):
        state = event["recovery_state"]
        cls.exact(state, {"source_snapshot", "progress_by_item", "done_ids", "cancellation", "jobs_identity",
                          "disposition", "settlement"}, "recovery_state")
        cls.snapshot(state["source_snapshot"], event["admitted_fingerprints"])
        progress, static = state["progress_by_item"], state["source_snapshot"]["expected_static"]
        cls.exact(progress, event["admitted_fingerprints"], "progress_by_item")
        for sid, record in progress.items():
            cls.exact(record, {"run_id", "completed_roles"}, "progress record")
            if record["run_id"] is not None:
                cls.text(record["run_id"], "progress run id")
            cls.strings(record["completed_roles"], "completed roles")
            _bounded_result_assessment({}, static[sid] | {"run_id": record["run_id"], "completed_roles_before": record["completed_roles"]})
        cls.strings(state["done_ids"], "done_ids")
        complete = {sid for sid in progress if set(progress[sid]["completed_roles"]) == {r["role_id"] for r in static[sid]["roles"]}}
        cls.require(set(state["done_ids"]).issubset(complete), "done item lacks complete roles")
        cancel = cls.exact(state["cancellation"], {"cancelled", "cancel_reason"}, "cancellation")
        cls.require(type(cancel["cancelled"]) is bool and cancel["cancel_reason"] in {None, "stop", "deadline"}
                    and cancel["cancelled"] == (cancel["cancel_reason"] is not None), "invalid cancellation latch")
        jobs = state["jobs_identity"]
        if jobs is not None:
            cls.exact(jobs, {"device", "inode"}, "jobs_identity")
            for key in jobs:
                cls.integer(jobs[key], "jobs " + key)
        cls.require(jobs is not None, "published boundary lacks jobs identity")
        disposition = cls.exact(state["disposition"], {"action", "reason", "outcome"}, "disposition")
        cls.require(type(disposition["action"]) is str and disposition["action"] in {"continue", "done", "halt"}, "invalid disposition action")
        # Reuse v1's closed reason/outcome domains without changing its decoder.
        probe = {key: value for key, value in event.items() if key not in cls.FIELDS}
        probe.update(schema_version=1, seq=0, prior_event_acknowledged=None, event="opened",
                     controller_reason=disposition["reason"], terminal_outcome=disposition["outcome"])
        _decode_cycle_receipt(_CycleJournal._line(probe))
        cls.require(not cancel["cancelled"] or disposition["action"] == "halt", "cancelled boundary cannot continue")
        if disposition["action"] != "halt":
            cls.require(disposition["reason"] is None and disposition["outcome"] is None, "continuing disposition has halt reason")
        else:
            cls.require(disposition["reason"] is not None and disposition["outcome"] is not None, "halt lacks reason/outcome")
        if previous is not None:
            cls.require(state["source_snapshot"] == previous["source_snapshot"] and jobs == previous["jobs_identity"], "boundary baseline changed")
            cls.require(not previous["cancellation"]["cancelled"] or cancel == previous["cancellation"], "cancellation latch cleared")
            cls.require(set(previous["done_ids"]).issubset(state["done_ids"]), "done ids decreased")
            for sid, old in previous["progress_by_item"].items():
                new = progress[sid]
                cls.require((old["run_id"] is None or new["run_id"] == old["run_id"])
                            and set(old["completed_roles"]).issubset(new["completed_roles"]), "accepted progress decreased or changed run")
        settlement = state["settlement"]
        if event["event"] == "recovery_ready":
            cls.require(previous is None and settlement is None and disposition == {"action": "continue", "reason": None, "outcome": None}
                        and not cancel["cancelled"], "invalid initial recovery boundary")
        elif event["event"] == "claim_settled":
            cls.require(previous is not None, "settlement lacks initial boundary")
            cls.exact(settlement, {"result", "claim", "trusted_expectation", "assessment"}, "settlement")
            result, claim, expected, assessment = (settlement[key] for key in ("result", "claim", "trusted_expectation", "assessment"))
            cls.exact(claim, {"claimed_by", "claimed_at", "pid", "operation"}, "settled claim")
            cls.text(claim["claimed_by"], "claimed_by")
            cls.text(claim["claimed_at"], "claimed_at")
            cls.integer(claim["pid"], "claim pid")
            cls.require(claim["pid"] > 0, "invalid claim pid")
            operation = cls.exact(claim["operation"], {"operation_id", "source_type", "source_id", "title", "state", "ready", "blockers", "labels",
                "target_repo", "execution_repo", "base_branch", "write_scope", "metadata", "work_item_context"}, "claim operation")
            sid = event["source_id"]
            cls.require(sid in progress and operation["source_id"] == sid and operation["operation_id"] == event["operation_id"]
                        and operation["source_type"] == "atlas_work_item", "settlement source identity mismatch")
            for key in ("title", "state", "target_repo", "execution_repo", "base_branch"):
                cls.require(type(operation[key]) is str, "invalid claim operation string")
            cls.require(operation["ready"] is True and operation["state"] in atlas_work_items.READY_STATES
                        and operation["blockers"] == [] and type(operation["metadata"]) is dict
                        and type(operation["work_item_context"]) is dict, "invalid ready claim operation")
            for key in ("labels", "write_scope"):
                cls.require(type(operation[key]) is list and all(type(value) is str and value.strip() for value in operation[key]), "invalid claim operation list")
            cls.require(_cycle_guard_immutable(operation, state["source_snapshot"]["immutable_inputs"][sid]["depends_on"])
                        == state["source_snapshot"]["immutable_inputs"][sid], "claim changed immutable operation")
            old = previous["progress_by_item"][sid]
            cls.require(expected == static[sid] | {"run_id": old["run_id"], "completed_roles_before": old["completed_roles"]}, "settlement expectation changed")
            cls.require(atlas_work_items.content_hash(claim) == event["claim_key"]
                        and atlas_work_items.content_hash(result) == event["result_sha256"] == event["stored_result_sha256"], "settlement digest mismatch")
            cls.exact(assessment, {"decision", "reason", "new_completed_roles"}, "assessment")
            if event["effects"]["launch"]["attempted"]:
                computed = _bounded_result_assessment(result, expected)
                evidence = result.get("evidence") if type(result) is dict else None
                cls.require(type(evidence) is dict and evidence.get("invocation_completed") is True and evidence.get("termination_proved") is True
                            and event["invocation_id"] == evidence.get("process_invocation_id"), "settlement lacks exact process completion proof")
            else:
                cls.require(result == {"status": "blocked", "returncode": 125, "summary": "Bounded supervisor did not launch this held claim.",
                                       "evidence": {"supervisor_no_launch": True}}, "invalid no-launch result")
                computed = {"decision": "stop", "reason": None, "new_completed_roles": []}
            cls.require(assessment == computed, "settlement assessment mismatch")
            wanted = copy.deepcopy(previous["progress_by_item"])
            done = set(previous["done_ids"])
            if assessment["decision"] in {"continue_candidate", "done_candidate"}:
                wanted[sid] = {"run_id": result["evidence"]["team_run"]["run_id"], "completed_roles": sorted(result["evidence"]["completed_roles"])}
                if assessment["decision"] == "done_candidate":
                    done.add(sid)
            cls.require(progress == wanted and done.issubset(state["done_ids"])
                        and (set(state["done_ids"]) - done).issubset({item for item in progress if previous["progress_by_item"][item] == progress[item]
                            and set(progress[item]["completed_roles"]) == {role["role_id"] for role in static[item]["roles"]}}), "settlement invents accepted progress")
            cls.require(disposition["action"] == "halt" or disposition["action"] == {"continue_candidate": "continue", "done_candidate": "done"}.get(assessment["decision"]), "disposition contradicts assessment")
        elif previous is not None:
            cls.require(progress == previous["progress_by_item"] and settlement == previous["settlement"], "non-settlement boundary changed accepted progress")
        if event["event"] in {"terminal", "closed"}:
            if event["controller_reason"] == "completed" or event["terminal_outcome"] == "completed":
                cls.require(set(state["done_ids"]) == set(progress), "completed terminal lacks every admitted done item")
            cls.require(disposition == {"action": "halt", "reason": event["controller_reason"], "outcome": event["terminal_outcome"]}, "terminal capsule lacks full halt state")


def _decode_cycle_receipt_v2(raw: bytes) -> list[dict]:
    """Validate every canonical v2 row and its complete capsule/epoch lineage."""
    check = _RecoveryProtocol
    check.require(type(raw) is bytes and bool(raw) and raw.endswith(b"\n") and b"\r" not in raw, "invalid complete v2 JSONL receipt")
    def pairs(values):
        result = {}
        for key, value in values:
            check.require(key not in result, "duplicate v2 JSON key")
            result[key] = value
        return result
    def constant(value):
        raise ValueError("nonfinite v2 JSON number: " + value)
    try:
        events = [json.loads(line.decode("utf-8", errors="strict"), object_pairs_hook=pairs, parse_constant=constant) for line in raw[:-1].split(b"\n")]
        check.require(all(type(event) is dict and check.FIELDS.issubset(event) for event in events), "missing v2 fields")
        check.require(b"".join(_CycleJournal._line(event) for event in events) == raw, "v2 receipt bytes are not canonical")
        projection, prefix = [], b""
        for index, event in enumerate(events):
            check.require(type(event["schema_version"]) is int and event["schema_version"] == 2, "unsupported v2 schema")
            check.hex(event["controller_epoch"], {32}, "controller_epoch")
            check.origin(event["origin"])
            previous = events[index - 1] if index else None
            if previous is not None:
                check.require(event["origin"] == previous["origin"], "original boot, clock or pins path changed")
            if event["event"] == "recovery_admitted":
                check.require(previous is not None and event["controller_epoch"] not in {row["controller_epoch"] for row in events[:index]}
                              and event["prior_event_acknowledged"] is None and event["old_tail_acknowledgment"] == "unknown"
                              and event["revalidated_prefix_sha256"] == hashlib.sha256(prefix).hexdigest(), "invalid recovery epoch admission or prefix")
            else:
                check.require((event["prior_event_acknowledged"] is None if not index else
                               type(event["prior_event_acknowledged"]) is int and event["prior_event_acknowledged"] == index - 1)
                              and event["revalidated_prefix_sha256"] is None and event["old_tail_acknowledgment"] is None
                              and (previous is None or event["controller_epoch"] == previous["controller_epoch"]), "invalid ordinary epoch or acknowledgment")
            row = {key: value for key, value in event.items() if key not in check.FIELDS}
            row.update(schema_version=1, prior_event_acknowledged=index - 1 if index else None)
            row["event"] = {"recovery_ready": "opened", "recovery_admitted": "opened", "step_reserved": "step_started"}.get(event["event"], event["event"])
            projection.append(row)
            prefix += _CycleJournal._line(event)
        _decode_cycle_receipt(b"".join(_CycleJournal._line(row) for row in projection))
        virtual, capsule = [], None
        for index, event in enumerate(events):
            name, row = event["event"], copy.deepcopy(projection[index])
            previous = events[index - 1] if index else None
            if name in {"recovery_ready", "recovery_admitted"}:
                check.require(previous is not None, "boundary cannot open history")
                if name == "recovery_ready":
                    check.require(previous["event"] == "opened", "recovery_ready must follow opened")
                else:
                    check.require(previous["event"] in {"recovery_ready", "claim_settled", "recovery_admitted"}
                                  and previous["recovery_state"]["disposition"]["action"] in {"continue", "done"}
                                  and not previous["unresolved"] and event["elapsed_seconds"] < event["limits"]["cycle_seconds"],
                                  "recovery admission requires the exact safe unexpired tail")
                    check.require(event["recovery_state"] == previous["recovery_state"], "readmission changed substantive capsule")
                check.require(all(event[key] == previous[key] for key in _CycleJournal._PATCH if key not in {"event", "elapsed_seconds"}), "boundary changed substantive row state")
            elif name == "step_reserved":
                check.require(previous is not None and previous["event"] in {"recovery_ready", "claim_settled", "recovery_admitted", "claim_not_acquired"}, "invalid step reservation predecessor")
                budget = {key: event["limits"][key] for key in ("max_steps", "max_claims", "max_roles", "role_max", "cycle_seconds")}
                reservation = _bounded_budget_reduce(budget,
                    {key: previous["counters"][key] for key in ("steps", "claims_reserved", "roles_reserved")}
                    | {"cancelled": False, "cancel_reason": None}, {"kind": "step", "elapsed_seconds": 0, "stop_requested": False})
                check.require(reservation["allowed"] and event["counters"] == {
                    key: reservation["state"].get(key, previous["counters"][key]) for key in previous["counters"]}
                    and all(event[key] == previous[key] for key in _CycleJournal._PATCH if key not in {"event", "elapsed_seconds", "counters"}),
                    "step_reserved must charge once and retain settled observations")
                virtual.append(row)
            elif name == "step_started":
                check.require(previous is not None and previous["event"] == "step_reserved"
                              and event["counters"] == previous["counters"]
                              and all(event[key] is None for key in _CycleJournal._IDENTITY)
                              and event["effects"] == _CycleJournal._empty_effects() and not event["unresolved"]
                              and event["controller_reason"] is None and event["terminal_outcome"] is None,
                              "step_started must retain reservation and reset settled observations")
                virtual[-1] = row
            else:
                check.require(name != "opened" or not virtual, "opened may only begin history")
                if name in {"terminal", "closed"} and previous is not None:
                    check.require(event["counters"] == previous["counters"], "terminal cannot invent an unreserved step")
                _CycleJournal._transition(virtual, row)
                virtual.append(row)
            state = event["recovery_state"]
            if name == "closed":
                check.require(state == previous["recovery_state"], "closed must preserve terminal recovery capsule exactly")
            if name in check.BOUNDARIES and (capsule is not None or name in {"recovery_ready", "claim_settled", "recovery_admitted"}):
                check.capsule(event, capsule)
                if name == "claim_settled":
                    added = len(state["settlement"]["assessment"]["new_completed_roles"])
                    check.require(event["counters"]["observed_completed_roles"] - previous["counters"]["observed_completed_roles"] == added, "observed role charge disagrees with assessment")
                capsule = state
            else:
                check.require(state is None, "unexpected recovery capsule")
            if event["source_id"] is not None:
                check.require(capsule is not None and event["source_id"] in capsule["progress_by_item"]
                              and event["operation_id"] == capsule["source_snapshot"]["immutable_inputs"][event["source_id"]]["operation_id"],
                              "row source or operation is outside original admission")
            if name == "step_reserved" and capsule is not None:
                check.require(capsule["disposition"]["action"] != "halt" and not capsule["cancellation"]["cancelled"], "halted capsule cannot reserve work")
        return copy.deepcopy(events)
    except (UnicodeError, json.JSONDecodeError, TypeError, KeyError, AttributeError, RecursionError, OverflowError) as exc:
        raise ValueError("invalid v2 receipt structure") from exc


def _same_boot_recovery_elapsed(origin: dict, boot_id: str, monotonic: int | float, last_elapsed: int | float) -> int | float:
    """Charge original same-boot elapsed time, including controller downtime."""
    check = _RecoveryProtocol
    check.origin(origin)
    check.require(type(boot_id) is str and boot_id == origin["boot_id"], "recovery boot mismatch")
    check.number(monotonic, "current monotonic")
    check.number(last_elapsed, "last elapsed")
    elapsed = monotonic - origin["entry_monotonic"]
    check.number(elapsed, "recovered elapsed")
    check.require(elapsed >= last_elapsed, "recovery clock moved backward")
    return elapsed


def _validate_recovery_candidate(raw: bytes, *, boot_id: str, monotonic: int | float) -> dict:
    """Classify the exact tail; this result grants no source or execution authority."""
    events = _decode_cycle_receipt_v2(raw)
    tail = events[-1]
    elapsed = _same_boot_recovery_elapsed(tail["origin"], boot_id, monotonic, tail["elapsed_seconds"])
    name, state = tail["event"], tail["recovery_state"]
    status, reason = "reconciliation_required", "unsafe_frontier"
    if name in {"opened", "step_reserved", "step_started", "claim_not_acquired"}:
        reason = "unsupported_frontier"
    elif name in {"terminal", "closed"} and state is not None and not tail["unresolved"]:
        status, reason = "report_only", "terminal"
    elif name in {"recovery_ready", "claim_settled", "recovery_admitted"} and state is not None and not tail["unresolved"]:
        status, reason = (("report_only", "halt") if state["disposition"]["action"] == "halt"
                          else ("continuation_candidate", None))
    if status == "continuation_candidate" and elapsed >= tail["limits"]["cycle_seconds"]:
        status, reason = "report_only", "deadline"
    return {"status": status, "reason": reason, "cycle_id": tail["cycle_id"], "controller_epoch": tail["controller_epoch"],
            "frontier": name, "seq": tail["seq"], "prefix_sha256": hashlib.sha256(raw).hexdigest(),
            "old_tail_acknowledgment": "unknown", "origin": copy.deepcopy(tail["origin"]),
            "limits": copy.deepcopy(tail["limits"]), "counters": copy.deepcopy(tail["counters"]),
            "elapsed_seconds": elapsed, "recovery_state": copy.deepcopy(state)}


class _CycleJournal:
    """Durable local receipt writer; successful returns alone acknowledge writes."""
    _PATCH = {"event", "elapsed_seconds", "counters", "operation_id", "source_id", "claim_key",
              "invocation_id", "effects", "result_sha256", "stored_result_sha256",
              "controller_reason", "terminal_outcome", "unresolved"}
    _IDENTITY = ("operation_id", "source_id", "claim_key", "invocation_id", "result_sha256", "stored_result_sha256")

    def __init__(self, queue_path: str, pins: dict, pins_raw_sha256: str, limits: dict, *,
                 cycle_id: str, acknowledged_closures: dict):
        self._initialize_state(queue_path, pins, pins_raw_sha256, limits,
                               cycle_id=cycle_id, acknowledged_closures=acknowledged_closures)
        probe = {"event": "opened", "elapsed_seconds": 0, "counters": dict.fromkeys(
            ("steps", "claims_reserved", "roles_reserved", "observed_completed_roles"), 0),
            **dict.fromkeys(self._IDENTITY), "effects": self._empty_effects(), "controller_reason": None,
            "terminal_outcome": None, "unresolved": False}
        _decode_cycle_receipt(self._line(self._event(probe, [])))

    def _initialize_state(self, queue_path: str, pins: dict, pins_raw_sha256: str, limits: dict, *,
                          cycle_id: str, acknowledged_closures: dict) -> None:
        self._pins = _decode_cycle_pins(self._line(pins)[:-1])
        if queue_path != self._pins["queue_path"] or type(acknowledged_closures) is not dict:
            raise ValueError("journal queue or closure custody mismatch")
        self._owned = {"schema_version": 1, "kind": "atlas-local-supervisor-event", "queue_path": queue_path,
            "queue_key": hashlib.sha256(queue_path.encode("utf-8")).hexdigest(), "cycle_id": cycle_id,
            "initialization_ack": "acknowledged", "pins_sha256": pins_raw_sha256,
            "admitted_fingerprints": {row["item_id"]: row["immutable_sha256"] for row in self._pins["item_closure"]
                                      if row["item_id"] in self._pins["admitted_item_ids"]}, "limits": copy.deepcopy(limits)}
        self._operations = {row["item_id"]: row["operation_id"] for row in self._pins["item_closure"]}
        self._closures = acknowledged_closures
        self._pid = os.getpid()
        self._fds = []
        self._stream = None
        self._directory = self._lock = None
        self._events, self._raw = [], b""
        self._opened = self._closed = self._poisoned = self._released = self._started = False

    @staticmethod
    def _line(value: dict) -> bytes:
        return (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True,
                           allow_nan=False) + "\n").encode("utf-8")

    @staticmethod
    def _empty_effects() -> dict:
        return {key: {"attempted": False, "ack": "not_attempted"} for key in ("claim", "launch", "result")}

    def _event(self, patch: dict, events: list) -> dict:
        if type(patch) is not dict or set(patch) != self._PATCH:
            raise ValueError("journal requires exactly the thirteen adapter fields")
        return copy.deepcopy(patch) | copy.deepcopy(self._owned) | {
            "seq": len(events), "prior_event_acknowledged": len(events) - 1 if events else None}

    @classmethod
    def _transition(cls, events: list, current: dict) -> None:
        def require(ok, message):
            if not ok:
                raise ValueError(message)
        name = current["event"]
        none = cls._empty_effects()
        if not events:
            require(name == "opened" and not any(current["counters"].values())
                and all(current[key] is None for key in cls._IDENTITY)
                and current["effects"] == none and not current["unresolved"]
                and current["controller_reason"] is None and current["terminal_outcome"] is None,
                "invalid initial opened patch")
            return
        previous = events[-1]
        before = previous["event"]
        edges = {"opened": {"step_started", "terminal"}, "step_started": {"claim_intent", "terminal"},
            "claim_intent": {"claimed", "claim_not_acquired", "terminal"},
            "claimed": {"launch_intent", "result_intent", "terminal"},
            "claim_not_acquired": {"step_started", "terminal"},
            "launch_intent": {"worker_returned", "result_intent", "terminal"},
            "worker_returned": {"result_intent", "terminal"},
            "result_intent": {"result_acknowledged", "terminal"},
            "result_acknowledged": {"claim_settled", "terminal"},
            "claim_settled": {"step_started", "terminal"}, "terminal": {"closed"}, "closed": set()}
        require(name in edges[before], "illegal receipt transition")
        delta = {key: current["counters"][key] - previous["counters"][key] for key in current["counters"]}
        aborted_step = name == "terminal" and before in {"opened", "claim_not_acquired", "claim_settled"}
        reservation_kind = {"step_started": "step", "claim_intent": "claim", "launch_intent": "launch"}.get(name)
        if aborted_step and delta["steps"] == 1:
            reservation_kind = "step"
        reservation = None
        if reservation_kind is not None:
            # Check only A1's integer admission from the prior counters. Receipt
            # time is observed after reservation and cannot reconstruct its
            # earlier cancellation/deadline observation.
            budget = {key: current["limits"][key] for key in
                      ("max_steps", "max_claims", "max_roles", "role_max", "cycle_seconds")}
            state = {key: previous["counters"][key] for key in ("steps", "claims_reserved", "roles_reserved")}
            reservation = _bounded_budget_reduce(budget, state | {"cancelled": False, "cancel_reason": None},
                {"kind": reservation_kind, "elapsed_seconds": 0, "stop_requested": False})
            require(reservation["allowed"], "reservation contradicts prior integer budget capacity")
        if name == "step_started":
            require(delta == {"steps": 1, "claims_reserved": 0, "roles_reserved": 0, "observed_completed_roles": 0}
                and all(current[key] is None for key in cls._IDENTITY) and current["effects"] == none,
                "step must reserve once and reset only settled identities")
        else:
            allowed = "claims_reserved" if name == "claim_intent" else "roles_reserved" if name == "launch_intent" else "observed_completed_roles" if name == "claim_settled" else "steps" if aborted_step else None
            require(all(value == 0 for key, value in delta.items() if key != allowed), "unexpected counter change")
            if name == "claim_intent":
                require(delta[allowed] == 1, "claim requires one reservation")
            elif name == "launch_intent":
                require(delta[allowed] == reservation["role_allowance"], "launch requires the exact remaining role allowance")
            elif name == "claim_settled":
                claimed = next(event for event in reversed(events) if event["event"] == "claimed")
                allowance = current["counters"]["roles_reserved"] - claimed["counters"]["roles_reserved"]
                require(0 <= delta[allowed] <= allowance, "observed progress exceeds this claim's reservation")
            elif aborted_step:
                require(0 <= delta["steps"] <= 1, "terminal can retain only one aborted step reservation")
            if name != "claim_intent":
                additions = {"claimed": {"claim_key"}, "worker_returned": {"invocation_id", "result_sha256"},
                    "result_intent": {"result_sha256"} if before in {"claimed", "launch_intent"} else set(),
                    "claim_settled": {"stored_result_sha256"},
                    "terminal": {"stored_result_sha256"} if before == "result_acknowledged" else set()}.get(name, set())
                for key in cls._IDENTITY:
                    if previous[key] is not None or key not in additions:
                        require(current[key] == previous[key], "held identity or digest changed")
            if name not in {"terminal", "closed"}:
                require(current["operation_id"] is not None and current["source_id"] is not None,
                        "claim event needs operation and source identity")
        effects = copy.deepcopy(previous["effects"])
        if name == "claim_intent":
            effects = none
            effects["claim"] = {"attempted": False, "ack": "pending"}
            require(current["claim_key"] is None and current["invocation_id"] is None
                and current["result_sha256"] is None and current["stored_result_sha256"] is None,
                "claim intent invents later observations")
        elif name in {"claimed", "claim_not_acquired"}:
            effects["claim"] = {"attempted": True, "ack": "acknowledged"}
            require((current["claim_key"] is not None) == (name == "claimed")
                and all(current[key] is None for key in ("invocation_id", "result_sha256", "stored_result_sha256")),
                "claim acknowledgment has invalid observations")
        elif name == "launch_intent":
            effects["launch"] = {"attempted": False, "ack": "pending"}
            require(current["claim_key"] is not None and all(current[key] is None for key in
                ("invocation_id", "result_sha256", "stored_result_sha256")), "launch intent lacks held claim")
        elif name == "worker_returned":
            effects["launch"] = {"attempted": True, "ack": "acknowledged"}
            require(current["result_sha256"] is not None and current["stored_result_sha256"] is None,
                    "worker return needs the original result digest")
        elif name == "result_intent":
            if before in {"claimed", "launch_intent"}:
                effects["launch"] = none["launch"]
                require(current["invocation_id"] is None, "no-launch settlement invents invocation")
            effects["result"] = {"attempted": False, "ack": "pending"}
            require(current["result_sha256"] is not None and current["stored_result_sha256"] is None,
                    "result intent needs original result only")
        elif name == "result_acknowledged":
            effects["result"] = {"attempted": True, "ack": "acknowledged"}
            require(current["stored_result_sha256"] is None, "result acknowledgment precedes verifying read")
        elif name == "claim_settled":
            require(current["result_sha256"] is not None and current["stored_result_sha256"] == current["result_sha256"],
                    "settlement requires matching fresh result digest")
            require(current["effects"]["launch"]["attempted"] or delta["observed_completed_roles"] == 0,
                    "no-launch settlement cannot observe new completed roles")
        if name == "step_started":
            effects = none
        if name == "terminal":
            require(current["controller_reason"] is not None and current["terminal_outcome"] is not None,
                    "terminal requires explicit assessment")
            settled = before in {"opened", "step_started", "claim_not_acquired", "claim_settled"}
            require(settled or current["unresolved"], "unfinished effect cannot close as settled")
            for key in effects:
                old, new = effects[key], current["effects"][key]
                require(new == old or (current["unresolved"] and old["ack"] == "pending"
                    and new["attempted"] and new["ack"] in {"acknowledged", "unknown"}),
                    "terminal erased or invented effect observation")
            require(current["unresolved"] or all(v["ack"] not in {"pending", "unknown"} for v in current["effects"].values()),
                    "unresolved effect cannot close")
        elif name == "closed":
            require(not previous["unresolved"] and not current["unresolved"], "uncertain cycle cannot close")
            require(all(current[key] == previous[key] for key in cls._PATCH if key != "event"),
                    "closed must preserve the terminal patch exactly")
        else:
            require(current["effects"] == effects, "effect observation contradicts transition")
            require(not current["unresolved"] and current["controller_reason"] is None
                and current["terminal_outcome"] is None, "nonterminal event contains terminal assessment")

    def _decode_history(self, raw: bytes) -> list[dict]:
        return _decode_cycle_receipt(raw)

    def _validate_transition(self, events: list[dict], current: dict) -> None:
        self._transition(events, current)

    def _receipt_access(self) -> int:
        return os.O_WRONLY

    def _before_append(self, patch: dict, *, creation=False) -> None:
        pass

    def _usable(self):
        if os.getpid() != self._pid or self._poisoned or self._released or self._closed:
            raise ValueError("journal is poisoned, closed, released or inherited")

    def _regular(self, fd):
        import stat
        value = os.fstat(fd)
        if not stat.S_ISREG(value.st_mode) or value.st_nlink != 1:
            raise ValueError("journal requires singly linked regular files")
        return value

    def _directory_child(self, parent, name):
        try:
            os.mkdir(name, mode=0o700, dir_fd=parent)
        except FileExistsError:
            pass
        fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
        self._fds.append(fd)
        os.fsync(fd)
        os.fsync(parent)
        return fd

    def _read_regular(self, parent, name):
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
        try:
            self._regular(fd)
            with os.fdopen(fd, "rb", closefd=False) as stream:
                return stream.read()
        finally:
            os.close(fd)

    def _inspect_queue(self, parent, name):
        # Normalize only the accepted store's container aliases; never mutate it.
        def pairs(rows):
            result = {}
            for key, value in rows:
                if key in result:
                    raise ValueError("duplicate queue key")
                result[key] = value
            return result
        payload = json.loads(self._read_regular(parent, name).decode("utf-8"), object_pairs_hook=pairs,
            parse_constant=lambda value: (_ for _ in ()).throw(ValueError("nonfinite queue constant")))
        rows = payload if type(payload) is list else payload.get("work_items", payload.get("items", [])) if type(payload) is dict else None
        if type(rows) is dict:
            rows = list(rows.values())
        if type(rows) is not list or any(type(row) is not dict for row in rows):
            raise ValueError("invalid queue work items")
        for row in rows:
            uncertainty = row.get("process_uncertainty")
            state = atlas_work_items.item_state(row)
            if state in atlas_work_items.ACTIVE_STATES or (
                row.get("claim") is not None and state not in atlas_work_items.TERMINAL_STATES | {"blocked"}
            ) or (uncertainty is not None and (
                type(uncertainty) is not dict or uncertainty.get("status") != "resolved")
            ):
                raise ValueError("queue retains active claim or process uncertainty")

    def _inspect_history(self):
        names = sorted(os.listdir(self._directory))
        for key in self._closures:
            if type(key) is tuple and key and key[0] == self._owned["queue_key"]:
                if (len(key) != 2 or type(key[1]) is not str or re.fullmatch("[0-9a-f]{32}", key[1]) is None
                    or key[1] + ".jsonl" not in names):
                    raise ValueError("known prior closure receipt is missing or misidentified")
        for name in names:
            if name == "controller.lock":
                continue
            if re.fullmatch("[0-9a-f]{32}\\.jobs", name):
                fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=self._directory)
                os.close(fd)
                if name[:-5] != self._owned["cycle_id"] and name[:-5] + ".jsonl" not in names:
                    raise ValueError("jobs directory has no prior receipt")
                continue
            if re.fullmatch("[0-9a-f]{32}\\.jsonl", name) is None:
                raise ValueError("unrecognized queue-state entry")
            raw = self._read_regular(self._directory, name)
            events = self._decode_history(raw)
            if raw != b"".join(self._line(event) for event in events):
                raise ValueError("receipt bytes are not canonical")
            for index, event in enumerate(events):
                self._validate_transition(events[:index], event)
            last = events[-1]
            key = (self._owned["queue_key"], name[:-6])
            if (last["event"] != "closed" or last["unresolved"] or last["queue_path"] != self._owned["queue_path"]
                or last["cycle_id"] != name[:-6] or self._closures.get(key) != hashlib.sha256(raw.splitlines(keepends=True)[-1]).hexdigest()):
                raise ValueError("prior receipt lacks still-held closure acknowledgment")

    def acquire_and_open(self, open_patch: dict) -> None:
        import fcntl
        self._usable()
        if self._started:
            raise ValueError("journal initialization cannot repeat")
        self._started = True
        try:
            event = self._event(open_patch, [])
            self._decode_history(self._line(event))
            self._validate_transition([], event)
            # Each ancestor is opened individually without following a link.
            parent = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            self._fds.append(parent)
            components = self._owned["queue_path"].split("/")[1:]
            for component in components[:-1]:
                parent = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
                self._fds.append(parent)
            self._inspect_queue(parent, components[-1])
            state = self._directory_child(parent, ".atlas-supervisor")
            self._directory = self._directory_child(state, self._owned["queue_key"])
            try:
                self._lock = os.open("controller.lock", os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                                     0o600, dir_fd=self._directory)
            except FileExistsError:
                self._lock = os.open("controller.lock", os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK,
                                     dir_fd=self._directory)
            self._regular(self._lock)
            fcntl.flock(self._lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            os.fsync(self._lock)
            os.fsync(self._directory)
            self._inspect_history()
            # Reobserve the replaceable queue after lock acquisition, without
            # binding its inode as the durable queue identity.
            self._inspect_queue(parent, components[-1])
            fd = os.open(self._owned["cycle_id"] + ".jsonl", self._receipt_access() | os.O_APPEND | os.O_CREAT
                         | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=self._directory)
            try:
                self._regular(fd)
                self._stream = os.fdopen(fd, "ab", buffering=0)
            except Exception:
                os.close(fd)
                raise
            self._opened = True
            self._append(open_patch, creation=True)
        except Exception:
            self._poisoned = True
            raise

    def _append(self, patch: dict, *, creation=False) -> None:
        self._usable()
        if not self._opened:
            raise ValueError("journal has not opened")
        try:
            self._before_append(patch, creation=creation)
            event = self._event(patch, self._events)
            line = self._line(event)
            self._decode_history(self._raw + line)
            self._validate_transition(self._events, event)
            if event["source_id"] is not None and (event["source_id"] not in self._owned["admitted_fingerprints"]
                or event["operation_id"] != self._operations[event["source_id"]]):
                raise ValueError("receipt operation is outside admitted identity")
            if self._stream.write(line) != len(line):
                raise OSError("short receipt write; acknowledgment unknown")
            self._stream.flush()
            os.fsync(self._stream.fileno())
            if creation:
                os.fsync(self._directory)
            self._events.append(event)
            self._raw += line
        except Exception:
            self._poisoned = True
            raise

    def append(self, patch: dict) -> None:
        if type(patch) is dict and patch.get("event") in {"opened", "closed"}:
            self._poisoned = True
            raise ValueError("opened and closed belong to their lifecycle methods")
        self._append(patch)

    def close(self, final_patch: dict) -> tuple[str, str, str]:
        self._usable()
        if type(final_patch) is not dict or final_patch.get("event") != "terminal" or final_patch.get("unresolved") is not False:
            self._poisoned = True
            raise ValueError("close requires a settled terminal patch")
        self._append(final_patch)
        closed = copy.deepcopy(final_patch)
        closed["event"] = "closed"
        self._append(closed)
        digest = hashlib.sha256(self._line(self._events[-1])).hexdigest()
        key = (self._owned["queue_key"], self._owned["cycle_id"])
        self._closures[key] = digest
        self._closed = True
        return (*key, digest)

    def release(self) -> None:
        if self._released:
            return
        self._released = True
        error = None
        descriptors = list(reversed(self._fds))
        if self._lock is not None:
            descriptors.insert(0, self._lock)
        try:
            if self._stream is not None:
                self._stream.close()
        except Exception as exc:
            error = exc
        for fd in descriptors:
            try:
                os.close(fd)
            except Exception as exc:
                error = error or exc
        if error is not None:
            self._poisoned = True
            raise error


class _LockedCycleRecoveryCandidate:
    """Move-only descriptor custody and copied untrusted history; never a seed."""
    _regular = _CycleJournal._regular
    release = _CycleJournal.release

    def __init__(self):
        self._pid = os.getpid()
        self._fds, self._links = [], []
        self._stream = self._lock = self._directory = self._receipt = self._jobs = None
        self._released = self._poisoned = self._transferred = False
        self._raw, self._events = b"", []

    def _usable(self):
        if os.getpid() != self._pid or self._released or self._poisoned or self._transferred:
            raise ValueError("recovery custody is released, transferred, poisoned or inherited")

    @staticmethod
    def _identity(value):
        return value.st_dev, value.st_ino

    def _remember(self, parent, name, fd, directory):
        self._links.append((parent, name, fd, directory, self._identity(os.fstat(fd))))

    def _open_directory(self, parent, name):
        fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
        self._fds.append(fd)
        self._remember(parent, name, fd, True)
        return fd

    def _read_held(self):
        self._regular(self._receipt)
        chunks, offset = [], 0
        while True:
            chunk = os.pread(self._receipt, 65536, offset)
            if not chunk:
                return b"".join(chunks)
            chunks.append(chunk)
            offset += len(chunk)

    def _verify(self):
        try:
            self._verify_held()
        except Exception:
            self._poisoned = True
            raise

    def _verify_held(self):
        import stat
        self._usable()
        for parent, name, fd, directory, identity in self._links:
            held = os.fstat(fd)
            named = os.stat(name, dir_fd=parent, follow_symlinks=False)
            valid_type = stat.S_ISDIR if directory else stat.S_ISREG
            if (not valid_type(held.st_mode) or not valid_type(named.st_mode)
                or self._identity(held) != identity or self._identity(named) != identity
                or (not directory and (held.st_nlink != 1 or named.st_nlink != 1))):
                raise ValueError("held recovery identity changed")
        if set(os.listdir(self._directory)) != self._expected_names or self._read_held() != self._raw:
            raise ValueError("held recovery names or exact raw prefix changed")
        # The store replaces the queue inode. Check its current canonical path
        # and regular-file type, never bind that replaceable inode as authority.
        fd = os.open(self._queue_name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=self._queue_parent)
        try:
            self._regular(fd)
        finally:
            os.close(fd)

    def snapshot(self) -> dict:
        return copy.deepcopy({"queue_path": self._queue_path, "queue_key": self._queue_key,
            "cycle_id": self._cycle_id, "raw": self._raw, "prefix_sha256": hashlib.sha256(self._raw).hexdigest(),
            "events": self._events, "tail": self._events[-1], "jobs_identity": self._jobs_identity,
            "held_identities": self._observed_identities, "old_tail_acknowledgment": "unknown"})

    @classmethod
    def acquire(cls, queue_path: str, cycle_id: str):
        import fcntl
        _RecoveryProtocol.path(queue_path)
        _RecoveryProtocol.hex(cycle_id, {32}, "cycle_id")
        owner = cls()
        owner._queue_path, owner._cycle_id = queue_path, cycle_id
        owner._queue_key = hashlib.sha256(queue_path.encode("utf-8")).hexdigest()
        try:
            parent = owner._open_directory(None, "/")
            components = queue_path.split("/")[1:]
            for name in components[:-1]:
                parent = owner._open_directory(parent, name)
            owner._queue_parent, owner._queue_name = parent, components[-1]
            state = owner._open_directory(parent, ".atlas-supervisor")
            owner._directory = owner._open_directory(state, owner._queue_key)
            owner._lock = os.open("controller.lock", os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=owner._directory)
            owner._regular(owner._lock)
            owner._remember(owner._directory, "controller.lock", owner._lock, False)
            fcntl.flock(owner._lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            owner._expected_names = {"controller.lock", cycle_id + ".jsonl", cycle_id + ".jobs"}
            if set(os.listdir(owner._directory)) != owner._expected_names:
                raise ValueError("selected recovery history/root is missing or has unsupported siblings")
            owner._receipt = os.open(cycle_id + ".jsonl", os.O_RDWR | os.O_APPEND | os.O_NOFOLLOW | os.O_NONBLOCK,
                                     dir_fd=owner._directory)
            owner._fds.append(owner._receipt)
            owner._regular(owner._receipt)
            owner._remember(owner._directory, cycle_id + ".jsonl", owner._receipt, False)
            owner._raw = owner._read_held()
            owner._events = _decode_cycle_receipt_v2(owner._raw)
            tail = owner._events[-1]
            if tail["queue_path"] != queue_path or tail["queue_key"] != owner._queue_key or tail["cycle_id"] != cycle_id:
                raise ValueError("selected recovery receipt identity mismatch")
            owner._jobs = owner._open_directory(owner._directory, cycle_id + ".jobs")
            identity = os.fstat(owner._jobs)
            owner._jobs_identity = {"device": identity.st_dev, "inode": identity.st_ino}
            capsules = [row["recovery_state"] for row in owner._events if row["recovery_state"] is not None]
            if not capsules or any(state["jobs_identity"] != owner._jobs_identity for state in capsules):
                raise ValueError("recovery root lacks its exact published identity")
            owner._verify()
            owner._observed_identities = [{"name": name, "directory": directory, "device": identity[0], "inode": identity[1]}
                                         for _, name, _, directory, identity in owner._links]
            return owner
        except Exception:
            owner._poisoned = True
            owner.release()
            raise


class _RecoverableCycleJournal(_CycleJournal):
    """V2 storage custody; fresh admission still requires the caller's live guard."""
    _PATCH = _CycleJournal._PATCH | {"recovery_state"}
    _identity = staticmethod(_LockedCycleRecoveryCandidate._identity)
    _remember = _LockedCycleRecoveryCandidate._remember
    _read_held = _LockedCycleRecoveryCandidate._read_held
    _verify = _LockedCycleRecoveryCandidate._verify
    _verify_held = _LockedCycleRecoveryCandidate._verify_held

    def __init__(self, queue_path: str, pins: dict, pins_raw_sha256: str, limits: dict, *,
                 cycle_id: str, acknowledged_closures: dict, controller_epoch: str, origin: dict):
        self._initialize_state(queue_path, pins, pins_raw_sha256, limits,
                               cycle_id=cycle_id, acknowledged_closures=acknowledged_closures)
        _RecoveryProtocol.hex(controller_epoch, {32}, "controller_epoch")
        _RecoveryProtocol.origin(origin)
        self._owned.update(schema_version=2, controller_epoch=controller_epoch, origin=copy.deepcopy(origin))
        self._awaiting_recovery = self._admitting = self._publishing_ready = self._jobs_attempted = self._recovered = False
        self._links, self._jobs, self._receipt = [], None, None
        self._owner_token = object()
        self._local_recovery_ack = self._recovery_prefix_sha256 = None
        probe = {"event": "opened", "elapsed_seconds": 0, "counters": dict.fromkeys(
            ("steps", "claims_reserved", "roles_reserved", "observed_completed_roles"), 0),
            **dict.fromkeys(self._IDENTITY), "effects": self._empty_effects(), "controller_reason": None,
            "terminal_outcome": None, "unresolved": False, "recovery_state": None}
        self._decode_history(self._line(self._event(probe, [])))

    def _decode_history(self, raw: bytes) -> list[dict]:
        return _decode_cycle_receipt_v2(raw)

    def _validate_transition(self, events: list[dict], current: dict) -> None:
        # The v2 full-history decoder already validates every transition.
        pass

    def _receipt_access(self) -> int:
        return os.O_RDWR

    def _event(self, patch: dict, events: list) -> dict:
        if type(patch) is not dict or set(patch) != self._PATCH:
            raise ValueError("v2 journal requires adapter fields plus recovery_state only")
        admitted = patch["event"] == "recovery_admitted" and self._admitting
        return copy.deepcopy(patch) | copy.deepcopy(self._owned) | {
            "seq": len(events), "prior_event_acknowledged": None if admitted or not events else len(events) - 1,
            "revalidated_prefix_sha256": hashlib.sha256(self._raw).hexdigest() if admitted else None,
            "old_tail_acknowledgment": "unknown" if admitted else None}

    def _capture_fresh_custody(self):
        components = self._owned["queue_path"].split("/")[1:]
        self._queue_parent, self._queue_name = self._fds[-3], components[-1]
        names = ["/", *components[:-1], ".atlas-supervisor", self._owned["queue_key"]]
        parent = None
        for fd, name in zip(self._fds, names):
            self._remember(parent, name, fd, True)
            parent = fd
        self._receipt = self._stream.fileno()
        self._remember(self._directory, "controller.lock", self._lock, False)
        self._remember(self._directory, self._owned["cycle_id"] + ".jsonl", self._receipt, False)
        self._expected_names.add(self._owned["cycle_id"] + ".jsonl")

    def _inspect_history(self):
        names = set(os.listdir(self._directory))
        super()._inspect_history()
        if set(os.listdir(self._directory)) != names:
            raise ValueError("history membership changed during validation")
        self._expected_names = names

    def _before_append(self, patch: dict, *, creation=False) -> None:
        if creation:
            self._capture_fresh_custody()
        if self._awaiting_recovery and not self._admitting:
            raise ValueError("loaded history has no fresh recovery acknowledgment")
        name = patch.get("event") if type(patch) is dict else None
        if name == "recovery_admitted" and not self._admitting:
            raise ValueError("recovery admission belongs to its lifecycle method")
        if name == "recovery_ready" and not self._publishing_ready:
            raise ValueError("recovery readiness belongs to root initialization")
        self._verify()

    @classmethod
    def acquire_for_recovery(cls, queue_path: str, cycle_id: str) -> _LockedCycleRecoveryCandidate:
        return _LockedCycleRecoveryCandidate.acquire(queue_path, cycle_id)

    @staticmethod
    def _continuable_tail(tail):
        state = tail["recovery_state"]
        return (tail["event"] in {"recovery_ready", "claim_settled", "recovery_admitted"}
                and state is not None and state["disposition"]["action"] in {"continue", "done"}
                and not state["cancellation"]["cancelled"] and not tail["unresolved"])

    @classmethod
    def from_recovery_candidate(cls, candidate: _LockedCycleRecoveryCandidate, pins: dict,
                                pins_raw_sha256: str, limits: dict, *, controller_epoch: str,
                                acknowledged_closures: dict):
        if type(candidate) is not _LockedCycleRecoveryCandidate:
            raise ValueError("recovery requires the exact descriptor owner")
        candidate._usable()
        candidate._verify()
        tail = candidate._events[-1]
        # Storage adoption also supports held read-only inspection of refused
        # tails. Only acknowledge_recovery may admit a continuing frontier.
        journal = cls(candidate._queue_path, pins, pins_raw_sha256, limits, cycle_id=candidate._cycle_id,
                      acknowledged_closures=acknowledged_closures, controller_epoch=controller_epoch, origin=tail["origin"])
        for key in ("queue_path", "queue_key", "cycle_id", "initialization_ack", "pins_sha256", "admitted_fingerprints", "limits"):
            if journal._owned[key] != tail[key]:
                raise ValueError("original journal pins, admission or limits disagree")
        if controller_epoch in {row["controller_epoch"] for row in candidate._events}:
            raise ValueError("recovery epoch must be fresh")
        journal._events, journal._raw = copy.deepcopy(candidate._events), candidate._raw
        journal._recovery_prefix_sha256 = hashlib.sha256(candidate._raw).hexdigest()
        journal._opened = journal._started = journal._recovered = journal._awaiting_recovery = True
        # closefd=False keeps ownership in the raw descriptor bundle, including
        # if wrapping fails. Nothing below reopens the receipt or releases lock.
        stream = os.fdopen(candidate._receipt, "ab", buffering=0, closefd=False)
        journal._stream = stream
        journal._fds, journal._lock = candidate._fds, candidate._lock
        for key in ("_directory", "_receipt", "_jobs", "_links", "_queue_parent", "_queue_name", "_expected_names"):
            setattr(journal, key, getattr(candidate, key))
        candidate._fds, candidate._links, candidate._lock = [], [], None
        candidate._stream = candidate._receipt = candidate._jobs = None
        candidate._transferred = candidate._released = True
        return journal

    def recovery_evidence(self) -> dict:
        self._verify()
        return {"owner_token": self._owner_token, "raw": self._raw, "tail": copy.deepcopy(self._events[-1]),
            "events": copy.deepcopy(self._events), "queue_path": self._owned["queue_path"], "cycle_id": self._owned["cycle_id"],
            "controller_epoch": self._owned["controller_epoch"], "prefix_sha256": hashlib.sha256(self._raw).hexdigest(),
            "revalidated_prefix_sha256": self._recovery_prefix_sha256,
            "local_recovery_ack": None if self._local_recovery_ack is None else dict(self._local_recovery_ack),
            "old_tail_acknowledgment": "unknown", "held_identities": [
                {"name": name, "directory": directory, "device": identity[0], "inode": identity[1]}
                for _, name, _, directory, identity in self._links]}

    def owned_jobs_identity(self) -> dict:
        """Copy the healthy held root identity, independent of the current row."""
        self._verify()
        if self._jobs is None:
            raise ValueError("journal has no held jobs root")
        value = os.fstat(self._jobs)
        return {"device": value.st_dev, "inode": value.st_ino}

    def acknowledge_recovery(self, recovery_patch: dict, *, expected_prefix_sha256: str) -> None:
        self._usable()
        try:
            if (type(recovery_patch) is not dict or not self._awaiting_recovery or self._local_recovery_ack is not None
                or not self._continuable_tail(self._events[-1]) or recovery_patch.get("event") != "recovery_admitted"
                or expected_prefix_sha256 != hashlib.sha256(self._raw).hexdigest()):
                raise ValueError("recovery admission lacks its exact unacknowledged prefix")
            self._inspect_queue(self._queue_parent, self._queue_name)
            self._admitting = True
            self._append(recovery_patch)
            self._local_recovery_ack = {"owner_token": self._owner_token, "controller_epoch": self._owned["controller_epoch"],
                "seq": self._events[-1]["seq"], "revalidated_prefix_sha256": expected_prefix_sha256,
                "acknowledged_prefix_sha256": hashlib.sha256(self._raw).hexdigest()}
            self._awaiting_recovery = False
        except Exception:
            self._poisoned = True
            raise
        finally:
            self._admitting = False

    def initialize_jobs_and_ready(self, ready_patch: dict) -> tuple[int, int]:
        self._usable()
        try:
            if (self._recovered or self._jobs_attempted or not self._opened or self._events[-1]["event"] != "opened"
                or type(ready_patch) is not dict or ready_patch.get("event") != "recovery_ready"):
                raise ValueError("jobs readiness requires one freshly opened cycle")
            self._jobs_attempted = True
            ready = copy.deepcopy(ready_patch)
            if ready["recovery_state"]["jobs_identity"] is not None:
                raise ValueError("jobs identity is journal-owned")
            # Validate the proposed complete capsule before creating any root.
            ready["recovery_state"]["jobs_identity"] = {"device": 0, "inode": 0}
            self._decode_history(self._raw + self._line(self._event(ready, self._events)))
            self._verify()
            name = self._owned["cycle_id"] + ".jobs"
            os.mkdir(name, mode=0o700, dir_fd=self._directory)
            self._jobs = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=self._directory)
            self._fds.append(self._jobs)
            value = os.fstat(self._jobs)
            self._remember(self._directory, name, self._jobs, True)
            self._expected_names.add(name)
            os.fsync(self._jobs)
            os.fsync(self._directory)
            ready["recovery_state"]["jobs_identity"] = {"device": value.st_dev, "inode": value.st_ino}
            self._publishing_ready = True
            self._append(ready)
            return value.st_dev, value.st_ino
        except Exception:
            self._poisoned = True
            raise
        finally:
            self._publishing_ready = False

    def append(self, patch: dict) -> None:
        if type(patch) is dict and patch.get("event") in {"opened", "closed", "recovery_ready", "recovery_admitted"}:
            self._poisoned = True
            raise ValueError("v2 lifecycle event requires its owning method")
        self._append(patch)



def _run_bounded_cycle(inputs: dict, *, provider, worker_factory, monotonic,
                       cancellation, journal, guard, recovery_seed=None,
                       recovery_capsule_factory=None) -> dict:
    """Run one private finite cycle through acknowledged public seams only.

    The journal owns durability. The guard owns source observations and trusted
    expectations. Neither a returned count nor a matching read repairs a lost
    acknowledgment. Production entry points deliberately do not call this unit.
    """
    class CycleStop(Exception):
        def __init__(self, reason: str, outcome: str, uncertain: bool = False):
            self.reason, self.outcome, self.uncertain = reason, outcome, uncertain

    state = {"steps": 0, "claims_reserved": 0, "roles_reserved": 0,
             "cancelled": False, "cancel_reason": None}
    observed = 0
    elapsed = 0.0
    clock_bad = inspection_bad = False
    opened = False
    healthy = True
    unresolved = False
    outcome, failure, witness = "blocked", None, None
    recoverable = type(journal) is _RecoverableCycleJournal
    accepted_capsule = None
    accepted_progress: dict = {}
    done_ids: set[str] = set()
    identities = {key: None for key in ("operation_id", "source_id", "claim_key",
                                        "invocation_id", "result_sha256", "stored_result_sha256")}
    effects = {key: {"attempted": False, "ack": "not_attempted"}
               for key in ("claim", "launch", "result")}

    def stop(reason: str, terminal: str = "blocked", uncertain: bool = False) -> None:
        raise CycleStop(reason, terminal, uncertain)

    def digest(value: object) -> str:
        return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"),
                                        ensure_ascii=True, allow_nan=False).encode("utf-8")).hexdigest()

    def counters() -> dict:
        return {key: state[key] for key in ("steps", "claims_reserved", "roles_reserved")} | {
            "observed_completed_roles": observed}

    def sample() -> float:
        nonlocal elapsed, clock_bad
        try:
            now = monotonic()
            if type(now) not in (int, float) or not math.isfinite(now):
                raise ValueError("invalid clock")
            delta = now - inputs["entry_monotonic"]
            if not math.isfinite(delta):
                raise ValueError("invalid elapsed clock")
            if delta < elapsed or delta < 0:
                raise ValueError("backward clock")
            elapsed = delta
        except Exception:
            clock_bad = True
        return elapsed

    def check() -> bool:
        nonlocal state, inspection_bad
        sample()
        try:
            requested = cancellation.is_set()
            if type(requested) is not bool:
                raise ValueError("invalid cancellation observation")
        except Exception:
            inspection_bad, requested = True, True
        state = _bounded_budget_reduce(budget, state, {
            "kind": "check", "elapsed_seconds": elapsed,
            "stop_requested": requested or clock_bad,
        })["state"]
        return not state["cancelled"]

    def stop_observation() -> tuple[str, str]:
        if clock_bad:
            return "invalid_result", "blocked"
        if inspection_bad:
            return "stop_inspection_error", "cancelled"
        return ("deadline" if state["cancel_reason"] == "deadline" else "stop"), "cancelled"

    def reserve(kind: str) -> dict:
        nonlocal state
        check()
        decision = _bounded_budget_reduce(budget, state, {
            "kind": kind, "elapsed_seconds": elapsed, "stop_requested": state["cancelled"],
        })
        if recoverable and kind == "step" and decision["allowed"]:
            # The proposed charge must be acknowledged before volatile install
            # and before a guard may observe the next step.
            proposed = patch("step_reserved")
            proposed["counters"].update({key: decision["state"][key]
                for key in ("steps", "claims_reserved", "roles_reserved")})
            append_patch(proposed)
        state = decision["state"]
        return decision

    class CycleCancellation:
        def is_set(self) -> bool:
            return not check()

    token = CycleCancellation()

    def patch(event: str, reason: str | None = None, terminal: str | None = None) -> dict:
        sample()
        row = {"event": event, "elapsed_seconds": elapsed, "counters": counters(),
               **copy.deepcopy(identities), "effects": copy.deepcopy(effects),
               "controller_reason": reason, "terminal_outcome": terminal, "unresolved": unresolved}
        if recoverable:
            row["recovery_state"] = None
            if event == "terminal" and accepted_capsule is not None:
                row["recovery_state"] = capsule(accepted_progress, done_ids,
                    {"action": "halt", "reason": reason, "outcome": terminal}, accepted_capsule["settlement"])
        return row

    def capsule(candidate_progress, candidate_done, disposition, settlement):
        result = copy.deepcopy(accepted_capsule)
        result.update(progress_by_item=copy.deepcopy(candidate_progress), done_ids=sorted(candidate_done),
            cancellation={key: state[key] for key in ("cancelled", "cancel_reason")},
            disposition=copy.deepcopy(disposition), settlement=copy.deepcopy(settlement))
        return result

    def append_patch(row: dict) -> None:
        nonlocal healthy
        try:
            journal.append(row)
        except Exception:
            healthy = False
            stop("receipt_unknown", uncertain=True)

    def emit(event: str) -> None:
        append_patch(patch(event))

    def restore_progress() -> None:
        progress.clear()
        progress.update(copy.deepcopy(accepted_progress))

    def observe(checkpoint: str, operation=None, operation_snapshot=None) -> tuple[dict | None, str | None]:
        # B4 initializes entry once; after that the accepted map is A3-owned.
        before = copy.deepcopy(accepted_progress)
        try:
            operation_dict = operation_snapshot if operation_snapshot is not None else (None if operation is None else operation.to_dict())
            frame = copy.deepcopy(guard(checkpoint, copy.deepcopy(operation_dict)))
            if type(frame) is not dict or set(frame) != {"changed", "reason", "head_changed", "trusted_expectation"}:
                raise ValueError("invalid guard frame")
            if type(frame["changed"]) is not bool or type(frame["head_changed"]) is not bool:
                raise ValueError("invalid guard booleans")
            if frame["reason"] not in (None, "input_changed", "out_of_scope_change"):
                raise ValueError("invalid guard reason")
            if frame["changed"] != (frame["reason"] is not None) or (frame["head_changed"] and not frame["changed"]):
                raise ValueError("inconsistent guard assessment")
            if checkpoint != "entry" and progress != before:
                raise ValueError("guard changed accepted progress")
            expectation = frame["trusted_expectation"]
            if operation is None or frame["changed"]:
                if expectation is not None:
                    raise ValueError("unexpected guard expectation")
            else:
                if type(expectation) is not dict:
                    raise ValueError("missing guard expectation")
                # The accepted pure helper validates expected before it examines
                # the deliberately empty result; no envelope supplies trust.
                _bounded_result_assessment({}, expectation)
                item_progress = accepted_progress[operation.source_id]
                if (expectation["source_type"] != operation.source_type
                    or expectation["source_id"] != operation.source_id
                    or expectation["operation_id"] != operation.operation_id
                    or expectation["run_id"] != item_progress["run_id"]
                    or expectation["completed_roles_before"] != item_progress["completed_roles"]):
                    raise ValueError("guard expectation disagrees with held identity/progress")
            return frame, None
        except Exception:
            restore_progress()
            return None, "invalid_result"

    def drift(frame: dict | None, error: str | None) -> tuple[str, str] | None:
        if error:
            return error, "blocked"
        if frame["changed"]:
            return frame["reason"], "input_changed"
        return None

    def queue_item() -> tuple[dict, dict]:
        # One fresh load per named observation. Never retry or reuse a stale
        # snapshot for claim binding or result verification.
        payload = provider.store.load()
        if type(payload) is not dict or type(payload.get("work_items")) is not list:
            raise ValueError("invalid fresh queue")
        by_id = {}
        for item in payload["work_items"]:
            if type(item) is not dict:
                raise ValueError("invalid queue item")
            item_id = atlas_work_items.item_id(item)
            if not item_id or item_id in by_id:
                raise ValueError("ambiguous queue identity")
            by_id[item_id] = item
        item = by_id.get(identities["source_id"])
        if item is None:
            raise ValueError("held item absent")
        return item, by_id

    try:
        # Fail before any effect on a malformed caller contract. Finally still
        # releases the injected journal, even when it was never opened.
        keys = {"queue_path", "pins_path", "pins_raw_sha256", "cycle_id", "entry_monotonic",
                "limits", "admitted_item_ids", "progress_by_item"}
        if type(inputs) is not dict or set(inputs) != keys:
            raise ValueError("bounded cycle inputs must match the exact handoff")
        for name in ("queue_path", "pins_path"):
            value = inputs[name]
            if type(value) is not str or not value.startswith("/") or "\\" in value or "\x00" in value or any(
                part in {"", ".", ".."} for part in value.split("/")[1:]
            ):
                raise ValueError("cycle path must be lexical canonical absolute")
        if type(inputs["pins_raw_sha256"]) is not str or re.fullmatch("[0-9a-f]{64}", inputs["pins_raw_sha256"]) is None:
            raise ValueError("invalid raw pins digest")
        if type(inputs["cycle_id"]) is not str or re.fullmatch("[0-9a-f]{32}", inputs["cycle_id"]) is None:
            raise ValueError("invalid cycle identity")
        if type(inputs["entry_monotonic"]) not in (int, float) or not math.isfinite(inputs["entry_monotonic"]):
            raise ValueError("invalid entry clock")
        limits = inputs["limits"]
        budget_keys = {"max_steps", "max_claims", "max_roles", "role_max", "cycle_seconds"}
        if type(limits) is not dict or set(limits) != budget_keys | {
            "worker_timeout_seconds", "worker_termination_grace_seconds", "stop_file"
        }:
            raise ValueError("invalid full cycle limits")
        budget = {key: limits[key] for key in budget_keys}
        _bounded_budget_reduce(budget, state, {"kind": "check", "elapsed_seconds": 0, "stop_requested": False})
        for name, minimum in (("worker_timeout_seconds", 0), ("worker_termination_grace_seconds", -1)):
            value = limits[name]
            if type(value) not in (int, float) or not math.isfinite(value) or value < 0 or (minimum == 0 and value == 0):
                raise ValueError("invalid worker duration")
        if type(limits["stop_file"]) is not str or not limits["stop_file"].startswith("/"):
            raise ValueError("stop file must be absolute")
        admitted = inputs["admitted_item_ids"]
        if (type(admitted) is not list or not admitted or any(type(v) is not str or not v.strip() for v in admitted)
            or admitted != sorted(set(admitted))):
            raise ValueError("invalid admitted IDs")
        admitted_set = set(admitted)
        progress = inputs["progress_by_item"]
        if type(progress) is not dict or (recovery_seed is None and progress):
            raise ValueError("fresh cycle requires an empty mutable progress map")
        if (not recoverable and (recovery_seed is not None or recovery_capsule_factory is not None)):
            raise ValueError("recovery seams require the v2 journal")
        if recoverable and recovery_seed is None and not callable(recovery_capsule_factory):
            raise ValueError("fresh v2 cycle requires an explicit capsule factory")

        try:
            if recovery_seed is not None:
                restored = _consume_recovery_seed(recovery_seed, inputs, journal=journal)
                state = {key: restored["counters"][key] for key in ("steps", "claims_reserved", "roles_reserved")}
                state.update(restored["capsule"]["cancellation"])
                observed, elapsed = restored["counters"]["observed_completed_roles"], restored["elapsed_seconds"]
                accepted_capsule = copy.deepcopy(restored["capsule"])
                accepted_progress = copy.deepcopy(accepted_capsule["progress_by_item"])
                done_ids = set(accepted_capsule["done_ids"])
                identities = {key: copy.deepcopy(restored["tail_patch"][key]) for key in identities}
                effects = copy.deepcopy(restored["tail_patch"]["effects"])
                opened = True
            else:
                frame, error = observe("entry")
                problem = drift(frame, error)
                if problem:
                    restore_progress()
                    stop(*problem)
                if set(progress) != admitted_set:
                    restore_progress()
                    stop("invalid_result")
                for record in progress.values():
                    if (type(record) is not dict or set(record) != {"run_id", "completed_roles"}
                        or (record["run_id"] is not None and (type(record["run_id"]) is not str or not record["run_id"].strip()))
                        or type(record["completed_roles"]) is not list
                        or any(type(role) is not str or not role.strip() for role in record["completed_roles"])
                        or record["completed_roles"] != sorted(set(record["completed_roles"]))
                        or (record["completed_roles"] and record["run_id"] is None)):
                        restore_progress()
                        stop("invalid_result")
                accepted_progress = copy.deepcopy(progress)
                try:
                    journal.acquire_and_open(patch("opened"))
                    opened = True
                except Exception:
                    healthy = False
                    stop("receipt_unknown", uncertain=True)
                if recoverable:
                    if not check():
                        stop(*stop_observation())
                    wanted = {"progress_by_item": copy.deepcopy(accepted_progress), "done_ids": sorted(done_ids),
                        "cancellation": {key: state[key] for key in ("cancelled", "cancel_reason")},
                        "disposition": {"action": "continue", "reason": None, "outcome": None}, "settlement": None}
                    try:
                        proposed = copy.deepcopy(recovery_capsule_factory(**copy.deepcopy(wanted)))
                        if (type(proposed) is not dict or set(proposed) != set(wanted) | {"source_snapshot", "jobs_identity"}
                            or proposed["jobs_identity"] is not None
                            or any(_CycleJournal._line(proposed[key]) != _CycleJournal._line(value) for key, value in wanted.items())):
                            raise ValueError("factory changed adapter-owned capsule fields")
                        _RecoveryProtocol.snapshot(proposed["source_snapshot"],
                            journal.recovery_evidence()["tail"]["admitted_fingerprints"])
                        if progress != accepted_progress:
                            raise ValueError("factory changed live progress")
                    except Exception:
                        restore_progress()
                        stop("invalid_result")
                    # A callback may take time or trigger stop. No root is
                    # published until the ordinary stop/deadline check passes.
                    if not check():
                        stop(*stop_observation())
                    ready = patch("recovery_ready") | {"recovery_state": proposed}
                    try:
                        journal.initialize_jobs_and_ready(ready)
                        proposed["jobs_identity"] = journal.owned_jobs_identity()
                    except Exception:
                        healthy = False
                        stop("receipt_unknown", uncertain=True)
                    accepted_capsule = copy.deepcopy(proposed)
            while True:
                decision = reserve("step")
                if not decision["allowed"]:
                    if state["cancelled"]:
                        stop(*stop_observation())
                    stop("budget_stop", "budget_stop")
                frame, error = observe("before_step")
                problem = drift(frame, error)
                if problem:
                    stop(*problem)
                for key in identities:
                    identities[key] = None
                effects = {key: {"attempted": False, "ack": "not_attempted"} for key in effects}
                emit("step_started")
                if not check():
                    stop(*stop_observation())
                try:
                    ready = provider.ready_operations()
                except Exception:
                    stop("queue_disagreement", uncertain=True)
                check()
                if type(ready) is not list or any(not isinstance(op, atlas_work_items.OperationState) for op in ready):
                    stop("invalid_result")
                if not check():
                    stop(*stop_observation())
                candidates = [op for op in ready if op.source_id in admitted_set and op.source_id not in done_ids]
                selected = None
                for candidate in candidates:
                    if not candidate.ready or candidate.source_type != "atlas_work_item":
                        stop("invalid_result")
                    frame, error = observe("before_claim", candidate)
                    problem = drift(frame, error)
                    if problem:
                        stop(*problem)
                    expected = frame["trusted_expectation"]
                    # A2 validates the complete trusted role graph and held
                    # baseline before this comparison. A resumed completed run
                    # needs no claim, role reservation, worker or result write.
                    if set(expected["completed_roles_before"]) == {role["role_id"] for role in expected["roles"]}:
                        done_ids.add(candidate.source_id)
                        continue
                    selected, before_claim_frame = candidate, frame
                    break
                if selected is None:
                    stop("completed" if done_ids == admitted_set else "no_work",
                         "completed" if done_ids == admitted_set else "no_work")
                if not reserve("claim")["allowed"]:
                    if state["cancelled"]:
                        stop(*stop_observation())
                    stop("budget_stop", "budget_stop")
                identities.update(operation_id=selected.operation_id, source_id=selected.source_id)
                selected_dict = copy.deepcopy(selected.to_dict())
                effects["claim"] = {"attempted": False, "ack": "pending"}
                emit("claim_intent")
                if not check():
                    stop(*stop_observation(), uncertain=True)
                effects["claim"]["attempted"] = True
                try:
                    held = provider.claim(selected)
                except Exception:
                    effects["claim"]["ack"] = "unknown"
                    stop("claim_unknown", uncertain=True)
                effects["claim"]["ack"] = "acknowledged"
                check()
                if held is None:
                    emit("claim_not_acquired")
                    continue
                if (not isinstance(held, atlas_work_items.OperationState)
                    or held.source_id != selected.source_id or held.operation_id != selected.operation_id
                    or held.source_type != selected.source_type):
                    stop("queue_disagreement", uncertain=True)
                held_dict = copy.deepcopy(held.to_dict())
                # Cancellation may forbid launch but not this single claim
                # observation or its subsequent already-held settlement.
                check()
                try:
                    item, _ = queue_item()
                    claim = copy.deepcopy(item.get("claim"))
                    if (type(claim) is not dict or claim.get("operation") != selected_dict
                        or claim.get("claimed_by") != provider.claimed_by
                        or type(claim.get("claimed_at")) is not str or not claim["claimed_at"].strip()
                        or atlas_work_items.item_state(item) not in atlas_work_items.ACTIVE_STATES):
                        raise ValueError("fresh claim disagrees")
                    identities["claim_key"] = digest(claim)
                except Exception:
                    stop("queue_disagreement", uncertain=True)
                check()
                emit("claimed")
                frame, error = observe("after_claim", held, held_dict)
                problem = drift(frame, error)
                if not problem and frame["trusted_expectation"] != before_claim_frame["trusted_expectation"]:
                    problem = ("invalid_result", "blocked")
                held_frame = copy.deepcopy(frame) if not problem else None
                if not check() and not problem:
                    problem = stop_observation()
                allowance = 0
                if not problem:
                    decision = reserve("launch")
                    if not decision["allowed"]:
                        problem = stop_observation() if state["cancelled"] else ("budget_stop", "budget_stop")
                    else:
                        allowance = decision["role_allowance"]
                        effects["launch"] = {"attempted": False, "ack": "pending"}
                        emit("launch_intent")
                        if not check():
                            problem = stop_observation()
                no_launch = problem is not None
                if no_launch:
                    effects["launch"] = {"attempted": False, "ack": "not_attempted"}
                    result = atlas_work_items.OperationResult(
                        status="blocked", returncode=125,
                        summary="Bounded supervisor did not launch this held claim.",
                        evidence={"supervisor_no_launch": True},
                    )
                    original = result.to_dict()
                else:
                    try:
                        worker = worker_factory(allowance)
                    except Exception:
                        # No worker was called; this claim is still safe to
                        # settle once through the explicit no-launch path.
                        no_launch, problem = True, ("invalid_result", "blocked")
                        effects["launch"] = {"attempted": False, "ack": "not_attempted"}
                        result = atlas_work_items.OperationResult(
                            status="blocked", returncode=125,
                            summary="Bounded supervisor did not launch this held claim.",
                            evidence={"supervisor_no_launch": True},
                        )
                        original = result.to_dict()
                    else:
                        if not check():
                            no_launch, problem = True, stop_observation()
                            effects["launch"] = {"attempted": False, "ack": "not_attempted"}
                            result = atlas_work_items.OperationResult(
                                status="blocked", returncode=125,
                                summary="Bounded supervisor did not launch this held claim.",
                                evidence={"supervisor_no_launch": True},
                            )
                            original = result.to_dict()
                        else:
                            effects["launch"]["attempted"] = True
                            try:
                                result = worker.run(held, provider.store.path, cancel_event=token)
                            except Exception:
                                effects["launch"]["ack"] = "unknown"
                                stop("launch_unknown", uncertain=True)
                            effects["launch"]["ack"] = "acknowledged"
                            check()
                            if not isinstance(result, atlas_work_items.OperationResult):
                                stop("invalid_result", uncertain=True)
                            try:
                                original = copy.deepcopy(result.to_dict())
                                identities["result_sha256"] = digest(original)
                            except Exception:
                                stop("invalid_result", uncertain=True)
                            evidence = original.get("evidence")
                            invocation = evidence.get("process_invocation_id") if type(evidence) is dict else None
                            if type(invocation) is str and invocation.strip():
                                identities["invocation_id"] = invocation
                            emit("worker_returned")
                            after, error = observe("after_worker", held, held_dict)
                            problem = drift(after, error)
                            if not problem and after["trusted_expectation"] != held_frame["trusted_expectation"]:
                                problem = ("invalid_result", "blocked")
                            if not check() and not problem:
                                problem = stop_observation()
                identities["result_sha256"] = digest(original)
                # Settlement always records the unchanged actual return (or the
                # explicit no-launch result), even after cancellation/drift.
                effects["result"] = {"attempted": False, "ack": "pending"}
                emit("result_intent")
                check()
                effects["result"]["attempted"] = True
                try:
                    provider.record_result(held, result)
                except Exception:
                    effects["result"]["ack"] = "unknown"
                    stop("result_unknown", uncertain=True)
                effects["result"]["ack"] = "acknowledged"
                check()
                emit("result_acknowledged")
                check()
                try:
                    item, by_id = queue_item()
                    stored = copy.deepcopy(item.get("result"))
                    fresh = provider.project(item, by_id)
                    if (stored != original or digest(stored) != identities["result_sha256"]
                        or fresh.source_id != held.source_id or fresh.operation_id != held.operation_id
                        or fresh.state != original["status"] or result.to_dict() != original):
                        raise ValueError("fresh result disagrees")
                    if original["status"] in atlas_work_items.READY_STATES:
                        if item.get("claim") is not None or not item.get("previous_claims") or item["previous_claims"][-1] != claim:
                            raise ValueError("held claim was not exactly settled")
                    elif item.get("claim") != claim:
                        raise ValueError("held claim changed")
                    identities["stored_result_sha256"] = digest(stored)
                except Exception:
                    stop("queue_disagreement", uncertain=True)
                check()
                uncertainty = item.get("process_uncertainty")
                if type(uncertainty) is dict and uncertainty.get("status") == "unresolved":
                    stop("process_uncertain", uncertain=True)
                if no_launch:
                    assessment = {"decision": "stop", "reason": None, "new_completed_roles": []}
                else:
                    assessment = _bounded_result_assessment(original, held_frame["trusted_expectation"])
                    evidence = original["evidence"]
                    if (type(evidence) is not dict or evidence.get("invocation_completed") is not True
                        or evidence.get("termination_proved") is not True):
                        stop("process_uncertain", uncertain=True)
                    if len(assessment["new_completed_roles"]) > allowance:
                        assessment = {"decision": "stop", "reason": "invalid_result", "new_completed_roles": []}
                    observed += len(assessment["new_completed_roles"])
                candidate_progress, candidate_done = copy.deepcopy(accepted_progress), set(done_ids)
                if recoverable:
                    # Compute the complete accepted candidate before publishing
                    # it. A lost append return never installs volatile progress.
                    if not no_launch and _bounded_result_assessment(original, held_frame["trusted_expectation"]) != assessment:
                        stop("invalid_result", uncertain=True)
                    if assessment["decision"] in {"continue_candidate", "done_candidate"}:
                        run = original["evidence"]["team_run"]
                        candidate_progress[held.source_id] = {"run_id": run["run_id"],
                            "completed_roles": sorted(original["evidence"]["completed_roles"])}
                        if assessment["decision"] == "done_candidate":
                            candidate_done.add(held.source_id)
                    if assessment["decision"] == "continue_candidate" and not fresh.ready and not problem:
                        problem = ("queue_disagreement", "blocked")
                    if not check() and not problem:
                        problem = stop_observation()
                    halt = problem or ((assessment["reason"] or "blocked",
                        "failed" if assessment["reason"] == "failed" else "blocked") if assessment["decision"] == "stop" else None)
                    disposition = ({"action": "halt", "reason": halt[0], "outcome": halt[1]} if halt else {
                        "action": "done" if assessment["decision"] == "done_candidate" else "continue", "reason": None, "outcome": None})
                    settled = capsule(candidate_progress, candidate_done, disposition,
                        {"result": original, "claim": claim, "trusted_expectation": before_claim_frame["trusted_expectation"], "assessment": assessment})
                    append_patch(patch("claim_settled") | {"recovery_state": settled})
                    accepted_capsule = copy.deepcopy(settled)
                    accepted_progress, done_ids = candidate_progress, candidate_done
                    restore_progress()
                else:
                    emit("claim_settled")
                if not check() and not problem:
                    problem = stop_observation()
                if problem:
                    stop(*problem)
                if assessment["decision"] == "stop":
                    stop(assessment["reason"] or "blocked", "failed" if assessment["reason"] == "failed" else "blocked")
                if assessment["decision"] == "continue_candidate" and not fresh.ready:
                    stop("queue_disagreement")
                # The acknowledged claim_settled event precedes this only
                # accepted progress update. No result envelope can reset it.
                if not recoverable:
                    run = original["evidence"]["team_run"]
                    updated = {"run_id": run["run_id"], "completed_roles": sorted(original["evidence"]["completed_roles"])}
                    accepted_progress[held.source_id] = copy.deepcopy(updated)
                    progress[held.source_id] = copy.deepcopy(updated)
                    if assessment["decision"] == "done_candidate":
                        done_ids.add(held.source_id)
        except CycleStop as exc:
            outcome, failure, unresolved = exc.outcome, exc.reason, exc.uncertain

        if opened and healthy:
            terminal = patch("terminal", failure, outcome)
            terminal["unresolved"] = unresolved
            try:
                if unresolved:
                    journal.append(terminal)
                else:
                    witness = journal.close(terminal)
                    if (type(witness) is not tuple or len(witness) != 3
                        or witness[0] != hashlib.sha256(inputs["queue_path"].encode("utf-8")).hexdigest()
                        or witness[1] != inputs["cycle_id"] or type(witness[2]) is not str
                        or re.fullmatch("[0-9a-f]{64}", witness[2]) is None):
                        raise ValueError("invalid closure acknowledgment")
            except Exception:
                healthy, unresolved, witness = False, True, None
                outcome, failure = "blocked", "receipt_unknown"
        sample()
    finally:
        try:
            journal.release()
        except Exception:
            unresolved, witness, outcome, failure = True, None, "blocked", "receipt_unknown"
    return {"terminal_outcome": outcome, "unresolved": unresolved, "counters": counters(),
            "elapsed_seconds": elapsed, "closure_witness": witness,
            "progress_by_item": copy.deepcopy(accepted_progress), "failure": failure}


def _cycle_guard_json(raw: bytes):
    """Read strict JSON without permitting duplicate keys or nonfinite values."""
    def pairs(rows):
        result = {}
        for key, value in rows:
            if key in result:
                raise ValueError("duplicate JSON key")
            result[key] = value
        return result

    def constant(value):
        raise ValueError("nonfinite JSON")

    return json.loads(raw.decode("utf-8", errors="strict"), object_pairs_hook=pairs,
                      parse_constant=constant)


def _cycle_guard_path(value: str, *, absolute: bool = True) -> tuple[str, ...]:
    """Validate lexical paths before probing any selected target."""
    if (type(value) is not str or not value or "\x00" in value or "\\" in value
        or any(ch in value for ch in "*?[]:") or value.endswith("/")
        or value.startswith("/") != absolute or value.startswith("~")):
        raise ValueError("noncanonical guard path")
    parts = value.split("/")[1:] if absolute else value.split("/")
    if not parts or any(part in {"", ".", "..", ".git"} for part in parts):
        raise ValueError("unsafe guard path component")
    return tuple(parts)


def _cycle_guard_open(path: str, *, directory: bool = False) -> int:
    """Open each ancestor without following links; never adopt an alias."""
    import stat
    parts = _cycle_guard_path(path)
    descriptor = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for index, part in enumerate(parts):
            is_directory = index < len(parts) - 1 or directory
            flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
            if is_directory:
                flags |= os.O_DIRECTORY
            next_descriptor = os.open(part, flags, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = next_descriptor
            observed = os.fstat(descriptor)
            if is_directory:
                if not stat.S_ISDIR(observed.st_mode):
                    raise ValueError("guard ancestor is not a directory")
            elif not stat.S_ISREG(observed.st_mode) or observed.st_nlink != 1:
                raise ValueError("guard input is not a singly linked regular file")
        returned, descriptor = descriptor, None
        return returned
    finally:
        if descriptor is not None:
            os.close(descriptor)


def _cycle_guard_scope(checkout: str, relative: str, *, exact_file: bool) -> None:
    """Refuse existing symlink ancestors and nonregular write targets."""
    import stat
    parts = _cycle_guard_path(relative, absolute=False)
    descriptor = _cycle_guard_open(checkout, directory=True)
    try:
        for index, part in enumerate(parts):
            try:
                observed = os.stat(part, dir_fd=descriptor, follow_symlinks=False)
            except FileNotFoundError:
                return  # Remaining lexical components stay within the checkout.
            if stat.S_ISLNK(observed.st_mode):
                raise ValueError("write scope follows a symbolic link")
            if index == len(parts) - 1:
                if not stat.S_ISREG(observed.st_mode) and (exact_file or not stat.S_ISDIR(observed.st_mode)):
                    raise ValueError("write scope names a nonregular target")
            else:
                next_descriptor = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
                os.close(descriptor)
                descriptor = next_descriptor
    finally:
        os.close(descriptor)


def _cycle_guard_read(path: str) -> bytes:
    with os.fdopen(_cycle_guard_open(path), "rb") as stream:
        return stream.read()


def _cycle_guard_directory(path: str) -> None:
    os.close(_cycle_guard_open(path, directory=True))


def _cycle_guard_git(checkout: str, *arguments: str) -> bytes:
    """Use local Git plumbing with external helpers and ambient config disabled."""
    environment = {"PATH": os.defpath, "LC_ALL": "C", "HOME": "/dev/null",
        "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_OPTIONAL_LOCKS": "0", "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_NO_LAZY_FETCH": "1", "GIT_TERMINAL_PROMPT": "0"}
    return subprocess.run(["git", "--no-pager", "--literal-pathspecs", "-c", "core.fsmonitor=false",
        "-c", "core.hooksPath=/dev/null", "-c", "core.attributesFile=/dev/null",
        "-c", "diff.external=", "-c", "diff.renames=false", *arguments], cwd=checkout,
        env=environment, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE).stdout


def _cycle_guard_checkout(checkout: str, *, implementation_only: bool = False) -> tuple[str, dict, dict, set[str]]:
    _cycle_guard_directory(checkout)
    if _cycle_guard_git(checkout, "rev-parse", "--show-toplevel").decode().rstrip("\n") != checkout:
        raise ValueError("checkout is an alias or nested directory")
    head = _cycle_guard_git(checkout, "rev-parse", "--verify", "HEAD").decode().strip()
    if re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", head) is None:
        raise ValueError("checkout has no full HEAD")
    path_filter = ["--", "templates/local-automation-runtime"] if implementation_only else []
    if implementation_only:
        _cycle_guard_directory(checkout + "/templates/local-automation-runtime")
    tree, index = {}, {}
    for row in _cycle_guard_git(checkout, "ls-tree", "-r", "-z", "HEAD", *path_filter).split(b"\0"):
        if not row:
            continue
        metadata, raw_path = row.split(b"\t", 1)
        mode, kind, oid = metadata.decode().split()
        path = os.fsdecode(raw_path)
        _cycle_guard_path(path, absolute=False)
        tree[path] = (mode, oid)
    for row in _cycle_guard_git(checkout, "ls-files", "--stage", "-z", *path_filter).split(b"\0"):
        if not row:
            continue
        metadata, raw_path = row.split(b"\t", 1)
        mode, oid, stage = metadata.decode().split()
        path = os.fsdecode(raw_path)
        _cycle_guard_path(path, absolute=False)
        if stage != "0" or path in index:
            raise ValueError("unresolved index")
        index[path] = (mode, oid)
    # Compare raw blobs rather than porcelain status: status/diff may invoke a
    # repository clean filter or hide raw-byte changes through EOL conversion.
    # --no-filters never runs a filter, textconv, diff driver or fsmonitor.
    import stat
    changes = {path for path in set(tree) | set(index) if tree.get(path) != index.get(path)}
    for path, (mode, oid) in index.items():
        _cycle_guard_scope(checkout, path, exact_file=True)
        try:
            observed = os.stat(checkout + "/" + path, follow_symlinks=False)
        except FileNotFoundError:
            changes.add(path)
            continue
        if not stat.S_ISREG(observed.st_mode) or observed.st_nlink != 1:
            raise ValueError("nonregular execution entry")
        raw_oid = _cycle_guard_git(checkout, "hash-object", "--no-filters", "--", path).decode().strip()
        if raw_oid != oid or bool(observed.st_mode & 0o111) != (mode == "100755"):
            changes.add(path)
    # Include ignored untracked files too: ignore rules grant no write authority.
    changes.update(os.fsdecode(row) for row in _cycle_guard_git(checkout, "ls-files", "--others", "-z", *path_filter).split(b"\0") if row)
    for path in changes:
        _cycle_guard_path(path, absolute=False)
    return head, tree, index, changes


def _cycle_guard_changes(checkout: str, tree: dict, index: dict, paths: set[str]) -> list[dict]:
    """Hash only paths whose membership has already passed entry/scope admission."""
    rows = []
    for path in sorted(paths):
        before, staged = tree.get(path), index.get(path)
        if any(record is not None and record[0] not in {"100644", "100755"} for record in (before, staged)):
            raise ValueError("nonregular Git entry")
        index_bytes = None if staged is None else _cycle_guard_git(checkout, "cat-file", "blob", staged[1])
        try:
            worktree_bytes = _cycle_guard_read(checkout + "/" + path)
        except FileNotFoundError:
            worktree_bytes = None
        index_state = ("untracked" if before is None and staged is None else "deleted" if staged is None
                       else "added" if before is None else "unchanged" if before == staged else "modified")
        worktree_state = ("deleted" if worktree_bytes is None else "untracked" if staged is None
                          else "unchanged" if worktree_bytes == index_bytes else "modified")
        if index_state == "deleted" and worktree_bytes is not None:
            raise ValueError("deleted index has a conflicting untracked replacement")
        # Worktree mode changes are modifications even when content is identical.
        if staged is not None and worktree_bytes is not None:
            executable = bool(os.stat(checkout + "/" + path, follow_symlinks=False).st_mode & 0o111)
            if executable != (staged[0] == "100755"):
                worktree_state = "modified"
        rows.append({"path": path, "index_sha256": None if index_bytes is None else hashlib.sha256(index_bytes).hexdigest(),
            "worktree_sha256": None if worktree_bytes is None else hashlib.sha256(worktree_bytes).hexdigest(),
            "index_state": index_state, "worktree_state": worktree_state})
    return rows


def _cycle_guard_project(item: dict, by_id: dict) -> dict:
    # Projection precedence is the accepted provider's. Readiness stays with the
    # provider; computing immutable inputs must not probe Azure/config discovery.
    class Projection(atlas_work_items.AtlasWorkItemOperationProvider):
        def blockers(self, item, by_id):
            return []
    return Projection.__new__(Projection).project(item, by_id).to_dict()


def _cycle_guard_immutable(operation: dict, depends_on: list[str]) -> dict:
    context = copy.deepcopy(operation["work_item_context"])
    for key in ("write_scope", "depends_on"):
        if key in context:
            context[key] = sorted(set(context[key]))
    scheduling = {key: copy.deepcopy(operation["metadata"].get(key)) for key in (
        "priority", "parallel_group", "critical_path_rank", "combine_policy", "validation_tier",
        "workflow_kind", "team_template", "required_outputs")}
    scheduling["priority"] = atlas_work_items.priority_value(scheduling["priority"], operation["labels"])
    return {key: operation[key] for key in ("source_id", "operation_id", "source_type", "title", "target_repo",
        "execution_repo", "base_branch")} | {"write_scope": sorted(set(operation["write_scope"])),
        "depends_on": sorted(set(depends_on)), "context": context, "scheduling": scheduling}


def _cycle_guard_selectors(pins: dict, templates: list, registry) -> dict:
    """Derive worker selectors solely from declared, already-pinned inputs.

    The caller checks candidate/cardinality/path/digest barriers first. This
    routine does not read instruction contents. B5 can reuse the same derivation.
    """
    inputs = pins["inputs"]
    configurations = [row["path"] for row in inputs if row["kind"] == "role_command_config"]
    registries = [row["path"] for row in inputs if row["kind"] == "registry"]
    if len(configurations) != 1 or len(registries) > 1:
        raise ValueError("ambiguous explicit selectors")
    instructions = {row["path"] for row in inputs if row["kind"] == "agent_instruction"}
    relative_refs, absolute_refs = set(), set()
    for template in templates:
        for role in template.roles:
            resolved = registry.resolve(role.agent_ref) if registry is not None else None
            if resolved is not None:
                if resolved.source:
                    _cycle_guard_path(resolved.source)
                    if resolved.source not in instructions:
                        raise ValueError("undeclared registry instruction")
                continue
            ref = role.agent_ref
            if ":" in ref:
                raise ValueError("unresolved URI agent reference")
            if ref.endswith(".md") or "/" in ref:
                if ref.startswith("/"):
                    _cycle_guard_path(ref)
                    if ref not in instructions:
                        raise ValueError("undeclared absolute instruction")
                    absolute_refs.add(ref)
                else:
                    _cycle_guard_path(ref, absolute=False)
                    relative_refs.add(ref)
    roots = None
    for ref in sorted(relative_refs):
        suffix = _cycle_guard_path(ref, absolute=False)
        candidates = set()
        for instruction in instructions:
            parts = _cycle_guard_path(instruction)
            if len(parts) > len(suffix) and parts[-len(suffix):] == suffix:
                candidates.add("/" + "/".join(parts[:-len(suffix)]))
        roots = candidates if roots is None else roots & candidates
    if relative_refs:
        if len(roots) != 1:
            raise ValueError("relative instructions lack one common declared root")
        agent_root = next(iter(roots))
    else:
        agent_root = str(Path(pins["queue_path"]).parent) if absolute_refs else None
    if agent_root is not None:
        _cycle_guard_directory(agent_root)
    return {"command_config": configurations[0], "templates_dir": pins["template_source"]["path"],
        "agent_registry_path": registries[0] if registries else None, "agent_root": agent_root}


def _cycle_guard_expected(operation: dict, template) -> dict:
    import atlas_local_sizing
    sizing = {}
    context = operation["work_item_context"]
    if "local_execution_v1" in context:
        sizing = atlas_local_sizing.qualify(context, roles=[{"role_id": role.id, "goal_gate": role.goal_gate}
                                                         for role in template.roles])
        if sizing["status"] != "qualified":
            raise ValueError("unqualified local execution")
    payload = {"context": context, "template": template.to_dict()}
    if sizing:
        payload["local_sizing"] = sizing
    request = operation["metadata"].get("workflow_kind") or ""
    expected = {"source_type": operation["source_type"], "source_id": operation["source_id"],
        "operation_id": operation["operation_id"], "work_item_id": operation["source_id"],
        "template_id": template.id, "template_workflow_kind": template.workflow_kind,
        "request_workflow_kind": request, "roles": [{"role_id": role.id, "required_outputs": list(role.must_produce),
            "consumes": list(role.consumes), "goal_gate": role.goal_gate} for role in template.roles],
        "goal_required": template.workflow_kind in {"work-item", "review"} or request in {"work-item", "review"}
                         or any(role.goal_gate for role in template.roles),
        "context_hash": atlas_work_items.content_hash(context), "contract_hash": atlas_work_items.content_hash(payload)}
    _bounded_result_assessment({}, expected | {"run_id": None, "completed_roles_before": []})
    if expected["goal_required"] and (not any(context.get(key) for key in ("goal", "objective", "description", "body", "task"))
                                      or not context.get("acceptance_criteria")):
        raise ValueError("goal workflow lacks substantive context")
    return expected


def _cycle_guard_resume(item: dict, operation: dict, template, expected: dict, pins: dict,
                       frozen: dict, checkpoint: str) -> dict:
    import atlas_workflows
    held = None if checkpoint == "entry" else frozen["progress_by_item"][operation["source_id"]]
    runs = item.get("workflow_runs") if type(item.get("workflow_runs")) is list else []
    for record in reversed(runs):
        if type(record) is not dict:
            continue
        summary = record.get("team_run")
        if type(summary) is not dict:
            raise ValueError("malformed resumable summary")
        if (summary.get("template_id") != template.id or record.get("contract_hash") != expected["contract_hash"]
            or type(record.get("rework_count", 0)) is not int
            or record.get("rework_count", 0) != operation["metadata"].get("rework_count", 0)):
            if expected["goal_required"]:
                raise ValueError("resume contract or rework changed")
            continue
        path = record.get("artifacts", {}).get("team_run_path") if type(record.get("artifacts")) is dict else None
        _cycle_guard_path(path)
        declared = next((row for row in pins["inputs"] if row["kind"] == "entry_file" and row["path"] == path), None)
        if declared is None:
            if held is None or held["run_id"] is None:
                raise ValueError("undeclared pre-entry resume artifact")
            queue = Path(pins["queue_path"])
            root = queue.parent / ".atlas-supervisor" / hashlib.sha256(str(queue).encode("utf-8")).hexdigest() / (frozen["cycle_id"] + ".jobs")
            parts = Path(path).parts
            prefix = "atlas-work-item-" + atlas_work_items.safe_id(operation["source_id"]) + "-"
            if (len(parts) != len(root.parts) + 2 or tuple(parts[:-2]) != root.parts
                or not parts[-2].startswith(prefix) or re.fullmatch(r"[0-9a-f]{32}", parts[-2][len(prefix):]) is None
                or parts[-1] != "team-run.json"):
                raise ValueError("resume artifact is outside the held invocation root")
        # Admission above precedes even an existence check on a selected target.
        raw = _cycle_guard_read(path)
        if declared is not None and hashlib.sha256(raw).hexdigest() != declared["sha256"]:
            raise ValueError("declared resume artifact drift")
        value = _cycle_guard_json(raw)
        if (type(value) is not dict or set(value) != {"id", "template_id", "work_item_id", "status", "created_at", "role_results"}
            or any(type(value[key]) is not str or not value[key].strip() for key in ("id", "template_id", "work_item_id", "status", "created_at"))
            or value["template_id"] != template.id or value["work_item_id"] != operation["source_id"]
            or value["status"] not in {"running", "complete"} or type(value["role_results"]) is not dict):
            raise ValueError("invalid loaded resume identity")
        roles = {role.id: role for role in template.roles}
        for role_id, result in value["role_results"].items():
            if (role_id not in roles or type(result) is not dict
                or set(result) != {"role_id", "status", "outputs", "evidence", "notes", "contract_issues", "goal_review"}
                or result["role_id"] != role_id or result["status"] not in {"complete", "pending", "running", "dry-run"}
                or type(result["outputs"]) is not dict or not set(result["outputs"]).issubset(roles[role_id].must_produce)
                or any(type(output) is not str for output in result["outputs"].values())
                or type(result["notes"]) is not str or type(result["evidence"]) is not list
                or any(type(entry) is not str or not entry.strip() for entry in result["evidence"])
                or result["contract_issues"] != [] or type(result["contract_issues"]) is not list
                or (result["goal_review"] is not None and atlas_workflows.goal_review_issues(result["goal_review"]))):
                raise ValueError("invalid loaded role evidence")
        run = atlas_workflows.TeamRun.from_dict(value)
        completed = sorted(role.id for role in template.roles
                           if atlas_workflows.role_result_satisfies_outputs(role, run.role_results.get(role.id)))
        if (any(result["status"] == "complete" and role_id not in completed for role_id, result in value["role_results"].items())
            or any(roles[role_id].goal_gate and result["goal_review"] is not None
                   and (atlas_workflows.goal_review_issues(result["goal_review"]) or result["goal_review"].get("verdict") != "pass")
                   for role_id, result in value["role_results"].items())
            or any(not set(roles[role_id].consumes).issubset(completed) for role_id in completed)):
            raise ValueError("resume outputs or dependency/goal evidence fail satisfaction")
        run.refresh_status(template)
        if run.status != value["status"] or atlas_workflows.team_run_summary(template, run) != summary:
            raise ValueError("loaded run disagrees with stored summary")
        progress = {"run_id": run.id, "completed_roles": completed}
        if held is not None and progress != held:
            raise ValueError("resume disagrees with held accepted progress")
        _bounded_result_assessment({}, expected | {"run_id": run.id, "completed_roles_before": completed})
        return progress
    progress = {"run_id": None, "completed_roles": []}
    if held is not None and held != progress:
        raise ValueError("held resume run disappeared")
    return progress


def _observe_cycle_inputs(pins: dict, frozen: dict, checkpoint: str, operation: dict | None) -> dict:
    """Observe local declared inputs; install trust only after complete entry validation."""
    import atlas_workflows
    frame = {"changed": False, "reason": None, "head_changed": False, "trusted_expectation": None}
    reason = "input_changed"
    try:
        if (type(frozen) is not dict or set(frozen) != {"pins_path", "pins_raw_sha256", "cycle_id", "source_snapshot", "progress_by_item"}
            or type(frozen["cycle_id"]) is not str or re.fullmatch(r"[0-9a-f]{32}", frozen["cycle_id"]) is None
            or type(frozen["pins_raw_sha256"]) is not str or re.fullmatch(r"[0-9a-f]{64}", frozen["pins_raw_sha256"]) is None
            or type(frozen["progress_by_item"]) is not dict
            or checkpoint not in {"entry", "before_step", "before_claim", "after_claim", "after_worker"}
            or (operation is None) != (checkpoint in {"entry", "before_step"})):
            raise ValueError("invalid guard call context")
        raw_pins = _cycle_guard_read(frozen["pins_path"])
        if hashlib.sha256(raw_pins).hexdigest() != frozen["pins_raw_sha256"] or _decode_cycle_pins(raw_pins) != pins:
            raise ValueError("pins raw bytes or decoded object changed")
        snapshot = frozen["source_snapshot"]
        if checkpoint == "entry":
            if snapshot is not None or frozen["progress_by_item"]:
                raise ValueError("entry initialization is not fresh")
        elif (type(snapshot) is not dict or set(snapshot) != {"input_digests", "template_candidates", "runtime_head", "execution_heads",
                "entry_changes", "immutable_inputs", "expected_static"}
              or set(frozen["progress_by_item"]) != set(pins["admitted_item_ids"])):
            raise ValueError("missing complete held snapshot/progress")
        for progress in frozen["progress_by_item"].values():
            if (type(progress) is not dict or set(progress) != {"run_id", "completed_roles"}
                or (progress["run_id"] is not None and (type(progress["run_id"]) is not str or not progress["run_id"].strip()))
                or type(progress["completed_roles"]) is not list
                or any(type(role) is not str or not role.strip() for role in progress["completed_roles"])
                or progress["completed_roles"] != sorted(set(progress["completed_roles"]))
                or (progress["run_id"] is None and progress["completed_roles"])):
                raise ValueError("invalid held progress")
        registries = [row for row in pins["inputs"] if row["kind"] == "registry"]
        if len(registries) > 1:
            raise ValueError("multiple declared registries")
        source = pins["template_source"]
        if source["mode"] == "directory":
            _cycle_guard_directory(source["path"])
            candidates = sorted(str(Path(source["path"]) / name) for name in os.listdir(source["path"]) if name.endswith(".json"))
        else:
            candidates = [source["path"]]
        # No template contents are touched until the COMPLETE name/type barrier passes.
        if candidates != source["candidates"]:
            raise ValueError("template candidate membership changed")
        for path in candidates:
            os.close(_cycle_guard_open(path))
        input_by_path = {row["path"]: row for row in pins["inputs"]}
        data, digests = {}, {}
        def read_input(path):
            if path not in input_by_path:
                raise ValueError("undeclared referenced input")
            raw = _cycle_guard_read(path)
            actual = hashlib.sha256(raw).hexdigest()
            if actual != input_by_path[path]["sha256"]:
                raise ValueError("pinned input digest drift")
            data[path], digests[path] = raw, actual
            return raw
        templates = []
        for path in candidates:
            template = atlas_workflows.TeamTemplate.from_dict(_cycle_guard_json(read_input(path)))
            if template.validate():
                raise ValueError("invalid pinned template")
            templates.append(template)
        registry = None
        if registries:
            registry_value = _cycle_guard_json(read_input(registries[0]["path"]))
            if type(registry_value) is not dict:
                raise ValueError("invalid registry")
            registry = atlas_workflows.AgentRegistry.from_dict(registry_value)
        queue_value = _cycle_guard_json(_cycle_guard_read(pins["queue_path"]))
        if type(queue_value) is list:
            items = queue_value
        elif type(queue_value) is dict:
            items = queue_value.get("work_items", queue_value.get("items", []))
            if type(items) is dict:
                items = [{"id": key, **value} if type(value) is dict else {"id": key, "value": value} for key, value in items.items()]
        else:
            raise ValueError("invalid queue")
        if type(items) is not list or any(type(item) is not dict for item in items):
            raise ValueError("invalid queue items")
        by_id = {atlas_work_items.item_id(item): item for item in items}
        if len(by_id) != len(items) or any(not key for key in by_id):
            raise ValueError("ambiguous queue source identity")
        operation_ids = [str(item.get("operation_id") or "atlas-work-item:" + atlas_work_items.item_id(item)) for item in items]
        if len(set(operation_ids)) != len(operation_ids):
            raise ValueError("ambiguous queue operation identity")
        closure = {row["item_id"]: row for row in pins["item_closure"]}
        projected, immutable, expected_static, selected = {}, {}, {}, {}
        scopes = {row["checkout_path"]: set() for row in pins["execution_checkouts"]}
        for source_id, row in closure.items():
            if source_id not in by_id:
                raise ValueError("closure item missing")
            item = by_id[source_id]
            current = _cycle_guard_project(item, by_id)
            scheduler = item.get("scheduler") if type(item.get("scheduler")) is dict else {}
            dependencies = sorted(set(atlas_work_items.list_value(scheduler.get("depends_on") or item.get("depends_on"))))
            if (current["source_id"] != source_id or current["operation_id"] != row["operation_id"]
                or current["execution_repo"] != row["execution_checkout"] or dependencies != row["depends_on"]):
                raise ValueError("closure identity or dependency changed")
            value = _cycle_guard_immutable(current, dependencies)
            if atlas_work_items.content_hash(value) != row["immutable_sha256"]:
                raise ValueError("immutable queue instructions changed")
            projected[source_id], immutable[source_id] = current, value
            context = current["work_item_context"]
            references = [(context.get("spec_path"), "spec", context.get("spec_hash"))]
            plan = context.get("source_plan")
            if type(plan) is dict:
                references.append((plan.get("path"), "plan", plan.get("hash")))
            for path, kind, expected_hash in references:
                if path is not None:
                    _cycle_guard_path(path)
                    declaration = input_by_path.get(path)
                    if declaration is None or declaration["kind"] != kind or (expected_hash and expected_hash != declaration["sha256"]):
                        raise ValueError("undeclared or unbound plan/spec")
            if source_id not in pins["admitted_item_ids"]:
                continue
            if not current["write_scope"]:
                raise ValueError("empty admitted write scope")
            for scope in current["write_scope"]:
                try:
                    _cycle_guard_scope(current["execution_repo"], scope, exact_file=True)
                except ValueError:
                    if checkpoint != "entry":
                        reason = "out_of_scope_change"
                    raise
                scopes[current["execution_repo"]].add(scope)
            template = atlas_workflows.select_team_template_for_work_item(templates, item)
            if template is None:
                raise ValueError("no pinned selected workflow")
            selected[source_id] = template
            expected_static[source_id] = _cycle_guard_expected(current, template)
        if len({op["operation_id"] for op in projected.values()}) != len(projected):
            raise ValueError("duplicate operation identities")
        selectors = _cycle_guard_selectors(pins, list(selected.values()), registry)
        # A selected record's contract/rework/path admission precedes ANY read
        # of that artifact, including generic entry_file hashing and Git reads.
        progress = {}
        for source_id in pins["admitted_item_ids"]:
            progress[source_id] = _cycle_guard_resume(by_id[source_id], projected[source_id], selected[source_id],
                expected_static[source_id], pins, frozen, checkpoint)
        for path in input_by_path:
            if path not in data:
                read_input(path)
        # Exercise the accepted resolver only after all possible instruction reads
        # have passed declaration, selector, no-follow and digest admission.
        for template in selected.values():
            for role in template.roles:
                atlas_workflows.resolve_role_agent(role, registry=registry, agent_root=selectors["agent_root"])
        runtime = pins["runtime"]["checkout_path"]
        runtime_head, runtime_tree, runtime_index, runtime_changes = _cycle_guard_checkout(runtime, implementation_only=True)
        if any(record[0] not in {"100644", "100755"} for entries in (runtime_tree, runtime_index)
               for path, record in entries.items() if path.startswith("templates/local-automation-runtime/")):
            raise ValueError("runtime implementation contains a nonregular Git entry")
        frame["head_changed"] = runtime_head != pins["runtime"]["head"]
        if any(path == "templates/local-automation-runtime" or path.startswith("templates/local-automation-runtime/") for path in runtime_changes):
            raise ValueError("runtime implementation is dirty")
        heads, entry_changes = {}, {}
        for checkout in pins["execution_checkouts"]:
            path = checkout["checkout_path"]
            head, tree, index, changed_paths = _cycle_guard_checkout(path)
            heads[path] = head
            frame["head_changed"] |= head != checkout["head"]
            entry = checkout["entry_changes"] if checkpoint == "entry" else snapshot["entry_changes"][path]
            entry_paths = {row["path"] for row in entry}
            if checkpoint == "entry" and changed_paths != entry_paths:
                raise ValueError("unexpected entry changes")
            committed = set()
            if head != checkout["head"]:
                committed = {os.fsdecode(value) for value in _cycle_guard_git(path, "diff", "--no-ext-diff", "--no-textconv",
                    "--no-renames", "--name-only", "-z", checkout["head"], head).split(b"\0") if value}
            for changed in (changed_paths - entry_paths) | committed:
                _cycle_guard_path(changed, absolute=False)
                if not any(changed == scope for scope in scopes[path]):
                    reason = "out_of_scope_change"
                    raise ValueError("change escaped admitted write scope")
            observed = _cycle_guard_changes(path, tree, index, changed_paths)
            if checkpoint == "entry":
                if observed != entry:
                    raise ValueError("entry layer state/digest mismatch")
                entry_changes[path] = observed
            else:
                for old in entry:
                    now = next((row for row in observed if row["path"] == old["path"]), None)
                    if now != old and not any(old["path"] == scope for scope in scopes[path]):
                        reason = "out_of_scope_change"
                        raise ValueError("pre-existing change drifted outside scope")
                entry_changes[path] = copy.deepcopy(entry)
        if frame["head_changed"]:
            raise ValueError("pinned HEAD changed")
        observed_snapshot = {"input_digests": digests, "template_candidates": candidates,
            "runtime_head": runtime_head, "execution_heads": heads, "entry_changes": entry_changes,
            "immutable_inputs": immutable, "expected_static": expected_static}
        if checkpoint != "entry" and observed_snapshot != snapshot:
            raise ValueError("held source snapshot changed")
        if operation is not None:
            if (type(operation) is not dict or operation.get("source_id") not in pins["admitted_item_ids"]
                or set(operation) != set(projected[operation["source_id"]])):
                raise ValueError("operation does not belong to the admitted cycle")
            source_id = operation["source_id"]
            if _cycle_guard_immutable(operation, closure[source_id]["depends_on"]) != immutable[source_id]:
                raise ValueError("held operation immutable inputs changed")
            frame["trusted_expectation"] = copy.deepcopy(expected_static[source_id]) | {
                "run_id": progress[source_id]["run_id"], "completed_roles_before": list(progress[source_id]["completed_roles"])}
            _bounded_result_assessment({}, frame["trusted_expectation"])
        if checkpoint == "entry":
            # All observations and validations precede either custody mutation.
            installed_snapshot, installed_progress = copy.deepcopy(observed_snapshot), copy.deepcopy(progress)
            frozen["progress_by_item"].update(installed_progress)
            frozen["source_snapshot"] = installed_snapshot
        return copy.deepcopy(frame)
    except (ValueError, TypeError, KeyError, AttributeError, OSError, subprocess.SubprocessError, UnicodeError, RecursionError):
        return {"changed": True, "reason": reason, "head_changed": frame["head_changed"], "trusted_expectation": None}


class _CycleRecoverySeed:
    """Private, process-local sealed state. No live guard or adapter is mutated."""
    __slots__ = ("_payload", "_owner", "_journal", "_pid", "_consumed", "_cancellation")
    _SEAL = object()

    def __init__(self, payload: dict, owner, journal, cancellation, *, seal):
        if seal is not self._SEAL:
            raise ValueError("recovery seed requires staged validation")
        self._payload = _CycleJournal._line(payload)
        self._owner, self._journal, self._cancellation = owner, journal, cancellation
        self._pid, self._consumed = os.getpid(), False

    def admission_patch(self, *, elapsed_seconds: float) -> dict:
        evidence, payload = _recovery_seed_evidence(self, journal=self._journal, acknowledged=False)
        _RecoveryProtocol.number(elapsed_seconds, "admission elapsed")
        if not payload["elapsed_seconds"] <= elapsed_seconds < payload["limits"]["cycle_seconds"]:
            raise ValueError("recovery admission clock is backward or expired")
        if self._cancellation.is_set() is not False:
            raise ValueError("recovery admission is stopped")
        patch = copy.deepcopy(payload["tail_patch"])
        patch.update(event="recovery_admitted", elapsed_seconds=elapsed_seconds)
        return patch


def _recovery_seed_evidence(seed, *, journal, acknowledged: bool) -> tuple[dict, dict]:
    if (type(seed) is not _CycleRecoverySeed or type(journal) is not _RecoverableCycleJournal
        or seed._journal is not journal or seed._pid != os.getpid() or seed._consumed):
        raise ValueError("recovery seed is foreign, inherited or consumed")
    evidence = journal.recovery_evidence()
    payload = _cycle_guard_json(seed._payload)
    if (evidence["owner_token"] is not seed._owner or evidence["cycle_id"] != payload["cycle_id"]
        or evidence["queue_path"] != payload["queue_path"] or evidence["controller_epoch"] != payload["controller_epoch"]
        or evidence["revalidated_prefix_sha256"] != payload["prefix_sha256"]):
        raise ValueError("recovery seed lost original custody")
    ack = evidence["local_recovery_ack"]
    if acknowledged:
        if (type(ack) is not dict or ack["owner_token"] is not seed._owner
            or ack["controller_epoch"] != payload["controller_epoch"] or ack["seq"] != payload["seq"] + 1
            or ack["revalidated_prefix_sha256"] != payload["prefix_sha256"]
            or ack["acknowledged_prefix_sha256"] != evidence["prefix_sha256"]
            or evidence["tail"]["seq"] != payload["seq"] + 1 or evidence["tail"]["event"] != "recovery_admitted"):
            raise ValueError("recovery seed lacks this process's fresh epoch acknowledgment")
        patch = {key: evidence["tail"][key] for key in _RecoverableCycleJournal._PATCH}
        expected = payload["tail_patch"] | {"event": "recovery_admitted", "elapsed_seconds": patch["elapsed_seconds"]}
        if (_CycleJournal._line(patch) != _CycleJournal._line(expected)
            or patch["elapsed_seconds"] < payload["elapsed_seconds"]):
            raise ValueError("acknowledged recovery changed staged state")
    elif ack is not None or evidence["prefix_sha256"] != payload["prefix_sha256"] or evidence["tail"]["seq"] != payload["seq"]:
        raise ValueError("recovery seed prefix is no longer awaiting admission")
    return evidence, payload


def _recovery_seed_state(seed: _CycleRecoverySeed, *, journal) -> dict:
    """Return independent installation copies only after a local durable return."""
    evidence, state = _recovery_seed_evidence(seed, journal=journal, acknowledged=True)
    state["elapsed_seconds"] = evidence["tail"]["elapsed_seconds"]
    state["tail_patch"] = {key: copy.deepcopy(evidence["tail"][key]) for key in _RecoverableCycleJournal._PATCH}
    return state


def _consume_recovery_seed(seed: _CycleRecoverySeed, inputs: dict, *, journal) -> dict:
    state = _recovery_seed_state(seed, journal=journal)
    expected = {key: state[key] for key in ("queue_path", "pins_path", "pins_raw_sha256", "cycle_id", "limits", "admitted_item_ids")}
    expected.update(entry_monotonic=state["origin"]["entry_monotonic"], progress_by_item=state["frozen"]["progress_by_item"])
    if type(inputs) is not dict or _CycleJournal._line(inputs) != _CycleJournal._line(expected):
        raise ValueError("resumed inputs differ from the original sealed cycle")
    seed._consumed = True
    return state


def _recovery_queue(path: str) -> tuple[bytes, dict]:
    raw = _cycle_guard_read(path)
    value = _cycle_guard_json(raw)
    rows = value if type(value) is list else value.get("work_items", value.get("items", [])) if type(value) is dict else None
    if type(rows) is dict:
        rows = [{"id": key, **item} if type(item) is dict else {"id": key, "value": item} for key, item in rows.items()]
    if type(rows) is not list or any(type(item) is not dict for item in rows):
        raise ValueError("invalid recovery queue")
    by_id = {atlas_work_items.item_id(item): item for item in rows}
    operations = [str(item.get("operation_id") or "atlas-work-item:" + atlas_work_items.item_id(item)) for item in rows]
    if len(by_id) != len(rows) or any(not sid for sid in by_id) or len(set(operations)) != len(operations):
        raise ValueError("ambiguous recovery queue identities")
    return raw, by_id


def _recovery_bind_snapshot(pins: dict, state: dict) -> None:
    import atlas_local_sizing
    snapshot = state["source_snapshot"]
    exact = {"input_digests": {row["path"]: row["sha256"] for row in pins["inputs"]},
        "template_candidates": pins["template_source"]["candidates"], "runtime_head": pins["runtime"]["head"],
        "execution_heads": {row["checkout_path"]: row["head"] for row in pins["execution_checkouts"]},
        "entry_changes": {row["checkout_path"]: row["entry_changes"] for row in pins["execution_checkouts"]}}
    if any(_CycleJournal._line(snapshot[key]) != _CycleJournal._line(value) for key, value in exact.items()):
        raise ValueError("saved baseline differs from original pins")
    closure = {row["item_id"]: row for row in pins["item_closure"]}
    if set(snapshot["immutable_inputs"]) != set(closure):
        raise ValueError("saved immutable closure differs from original pins")
    for sid, row in closure.items():
        value = snapshot["immutable_inputs"][sid]
        if (value["source_id"] != sid or value["operation_id"] != row["operation_id"]
            or value["execution_repo"] != row["execution_checkout"] or value["depends_on"] != row["depends_on"]
            or atlas_work_items.content_hash(value) != row["immutable_sha256"]):
            raise ValueError("saved closure fingerprint differs from original pins")
    if set(snapshot["expected_static"]) != set(pins["admitted_item_ids"]) or set(state["progress_by_item"]) != set(pins["admitted_item_ids"]):
        raise ValueError("saved admission differs from original pins")
    for sid in pins["admitted_item_ids"]:
        context, expected = snapshot["immutable_inputs"][sid]["context"], snapshot["expected_static"][sid]
        if (type(context.get("local_execution_v1")) is not dict or atlas_local_sizing.qualify(context,
            [{"role_id": role["role_id"], "goal_gate": role["goal_gate"]} for role in expected["roles"]])["status"] != "qualified"):
            raise ValueError("recovery requires qualified explicit local model routing")


def _recovery_settlement_metadata(item: dict, row: dict, *, pins: dict, staged: dict, selectors: dict, allowance: int) -> dict | None:
    """Admit exact invocation paths and metadata before any selected target read."""
    settlement, sid = row["recovery_state"]["settlement"], row["source_id"]
    result, claim = settlement["result"], settlement["claim"]
    operation = _cycle_guard_project(item, {sid: item})
    if (operation["source_id"] != sid or operation["operation_id"] != row["operation_id"]
        or operation["state"] != result["status"] or item.get("result") != result
        or atlas_work_items.content_hash(item.get("result")) != row["result_sha256"]
        or atlas_work_items.content_hash(claim) != row["claim_key"]):
        raise ValueError("current result or source disagrees with latest settlement")
    if result["status"] in atlas_work_items.READY_STATES:
        previous = item.get("previous_claims")
        if item.get("claim") is not None or type(previous) is not list or not previous or previous[-1] != claim:
            raise ValueError("latest settled claim is not the current previous claim")
    elif item.get("claim") != claim:
        raise ValueError("current retained claim disagrees with latest settlement")
    if not row["effects"]["launch"]["attempted"]:
        return None
    evidence, invocation = result["evidence"], row["invocation_id"]
    _RecoveryProtocol.hex(invocation, {32}, "settled invocation")
    root = Path(pins["queue_path"]).parent / ".atlas-supervisor" / hashlib.sha256(pins["queue_path"].encode()).hexdigest() / (staged["cycle_id"] + ".jobs")
    job = root / ("atlas-work-item-" + atlas_work_items.safe_id(sid) + "-" + invocation)
    paths = {"job_dir": str(job), "operation_path": str(job / "operation.json"), "output_path": str(job / "worker-output.txt"),
        "team_run_path": str(job / "team-run.json"), "team_rollup_path": str(job / "team-rollup.md"),
        "team_role_tasks_path": str(job / "team-role-tasks.json"), "team_role_results_path": str(job / "team-role-results.json")}
    if any(evidence.get(key) != value for key, value in paths.items()):
        raise ValueError("latest settlement artifact path is outside its exact invocation")
    if evidence.get("invocation_completed") is not True or evidence.get("termination_proved") is not True or evidence.get("process_invocation_id") != invocation:
        raise ValueError("settled invocation lacks completion proof")
    marker = item.get("process_uncertainty")
    required = {"status", "invocation_id", "command_sha256", "started_at", "job_dir", "resolved_at"}
    if (type(marker) is not dict or not required.issubset(marker) or set(marker) - required - {"pid", "pgid", "cancelled_before_start"}
        or marker["status"] != "resolved" or marker["invocation_id"] != invocation or marker["job_dir"] != str(job)
        or marker.get("cancelled_before_start", False) is not False):
        raise ValueError("current invocation marker is missing, foreign or unresolved")
    for key in ("started_at", "resolved_at"):
        _RecoveryProtocol.text(marker[key], "marker " + key)
    for key in ("pid", "pgid"):
        if key in marker and (type(marker[key]) is not int or marker[key] <= 0):
            raise ValueError("malformed optional marker process identity")
    command = [str(Path(pins["runtime"]["checkout_path"]) / "templates/local-automation-runtime/atlas-agent-role-runner"),
               "--command-config", selectors["command_config"], "--max-roles", str(allowance)]
    if marker["command_sha256"] != hashlib.sha256(json.dumps(command).encode()).hexdigest():
        raise ValueError("invocation command differs from pinned canonical routing")
    runs = item.get("workflow_runs")
    record = next((value for value in reversed(runs) if type(value) is dict), None) if type(runs) is list else None
    projected = {"contract_hash": evidence.get("contract_hash"), "rework_count": evidence.get("rework_count", 0),
        "goal_acceptance": evidence.get("goal_acceptance"), "status": evidence["team_run"].get("status"),
        "team_run": evidence["team_run"], "workflow_selection": evidence.get("workflow_selection") if type(evidence.get("workflow_selection")) is dict else {},
        "artifacts": {key: paths[key] for key in ("team_run_path", "team_rollup_path", "team_role_tasks_path", "team_role_results_path")},
        "operation_id": row["operation_id"]}
    if (type(record) is not dict or set(record) != set(projected) | {"recorded_at", "team_rollup_markdown"}
        or any(record.get(key) != value for key, value in projected.items())
        or type(record["team_run"]) is not dict or record["team_run"].get("work_item_id") != sid):
        raise ValueError("latest workflow record disagrees with latest settlement")
    _RecoveryProtocol.text(record["recorded_at"], "workflow recorded_at")
    return {"record": record, "paths": paths}


def _admit_cycle_recovery(pins: dict, frozen: dict, *, journal, boot_id: str, monotonic, cancellation) -> dict:
    """Stage current trust; return either a sealed candidate or read-only observation."""
    observation = {"validated": False, "old_tail_acknowledgment": "unknown"}
    def result(status, reason, seed=None):
        return {"status": status, "reason": reason, "observation": copy.deepcopy(observation), "seed": seed}
    def clock():
        try:
            return monotonic()
        except Exception as exc:
            raise ValueError("recovery monotonic observation failed") from exc
    try:
        if type(journal) is not _RecoverableCycleJournal or not journal._recovered or not journal._awaiting_recovery:
            raise ValueError("recovery validation requires an adopted unadmitted journal")
        evidence = journal.recovery_evidence()
        if evidence["local_recovery_ack"] is not None:
            raise ValueError("recovery validation cannot reuse an acknowledged epoch")
        observed_tail = evidence["tail"]
        observation.update({key: copy.deepcopy(observed_tail[key]) for key in ("cycle_id", "seq", "origin", "limits", "counters", "elapsed_seconds")})
        observation.update(frontier=observed_tail["event"], prefix_sha256=evidence["prefix_sha256"],
                           controller_epoch=evidence["controller_epoch"], prior_controller_epoch=observed_tail["controller_epoch"])
        candidate = _validate_recovery_candidate(evidence["raw"], boot_id=boot_id, monotonic=clock())
        observation["elapsed_seconds"] = candidate["elapsed_seconds"]
        if candidate["status"] == "reconciliation_required":
            return result("reconciliation_required", candidate["reason"])
        state, tail = candidate["recovery_state"], evidence["tail"]
        _RecoveryProtocol.exact(frozen, {"pins_path", "pins_raw_sha256", "cycle_id", "source_snapshot", "progress_by_item"}, "live frozen context")
        if (frozen["pins_path"] != tail["origin"]["pins_path"] or frozen["pins_raw_sha256"] != tail["pins_sha256"]
            or frozen["cycle_id"] != tail["cycle_id"]):
            raise ValueError("recovery pins path or identity differs from original")
        raw_pins = _cycle_guard_read(frozen["pins_path"])
        if hashlib.sha256(raw_pins).hexdigest() != tail["pins_sha256"] or _decode_cycle_pins(raw_pins) != pins or pins != journal._pins:
            raise ValueError("recovery pins bytes or decoded identity changed")
        _recovery_bind_snapshot(pins, state)
        staged = {key: copy.deepcopy(frozen[key]) for key in ("pins_path", "pins_raw_sha256", "cycle_id")}
        staged.update(source_snapshot=copy.deepcopy(state["source_snapshot"]), progress_by_item=copy.deepcopy(state["progress_by_item"]))
        staged_bytes = _CycleJournal._line(staged)
        stopped, inspection_error = False, False
        def check_stop():
            nonlocal stopped, inspection_error
            try:
                value = cancellation.is_set()
                if type(value) is not bool:
                    raise ValueError("invalid recovery stop observation")
                stopped |= value
            except Exception:
                inspection_error = True
        check_stop()
        queue_raw, by_id = _recovery_queue(pins["queue_path"])
        latest, prior, claimed, observed = {}, None, None, 0
        for row in evidence["events"]:
            if row["event"] == "claimed":
                claimed = row
            if row["event"] == "claim_settled":
                sid, settlement = row["source_id"], row["recovery_state"]["settlement"]
                expected = staged["source_snapshot"]["expected_static"][sid] | {
                    "run_id": prior["progress_by_item"][sid]["run_id"], "completed_roles_before": prior["progress_by_item"][sid]["completed_roles"]}
                assessment = (_bounded_result_assessment(settlement["result"], expected) if row["effects"]["launch"]["attempted"]
                              else {"decision": "stop", "reason": None, "new_completed_roles": []})
                if settlement["trusted_expectation"] != expected or settlement["assessment"] != assessment:
                    raise ValueError("settlement lineage differs from freshly bound expectations")
                observed += len(assessment["new_completed_roles"])
                latest[sid] = (row, row["counters"]["roles_reserved"] - claimed["counters"]["roles_reserved"])
            if row["recovery_state"] is not None:
                prior = row["recovery_state"]
        if observed != tail["counters"]["observed_completed_roles"]:
            raise ValueError("accepted role count differs from settled lineage")
        selectors = _bounded_cli_selectors(pins, staged)
        metadata = []
        for sid, (row, allowance) in latest.items():
            if sid not in by_id:
                raise ValueError("settled item disappeared")
            metadata.append(_recovery_settlement_metadata(by_id[sid], row, pins=pins, staged=staged, selectors=selectors, allowance=allowance))
        healthy = {"changed": False, "reason": None, "head_changed": False, "trusted_expectation": None}
        for pass_number in range(2):
            if _observe_cycle_inputs(pins, staged, "before_step", None) != healthy or _CycleJournal._line(staged) != staged_bytes:
                raise ValueError("recovery source, workflow or held progress changed")
            if pass_number == 0:
                for entry in metadata:
                    if entry is not None:
                        import atlas_workflows
                        templates = [atlas_workflows.TeamTemplate.from_dict(_cycle_guard_json(_cycle_guard_read(path)))
                                     for path in pins["template_source"]["candidates"]]
                        selected = [template for template in templates if template.id == entry["record"]["team_run"]["template_id"]]
                        if len(selected) != 1:
                            raise ValueError("settlement template is ambiguous")
                        run = atlas_workflows.TeamRun.from_dict(_cycle_guard_json(_cycle_guard_read(entry["paths"]["team_run_path"])))
                        text = _cycle_guard_read(entry["paths"]["team_rollup_path"]).decode("utf-8", errors="strict")
                        if text != run.rollup_markdown(selected[0]) or entry["record"]["team_rollup_markdown"] != text[:20000]:
                            raise ValueError("latest workflow rollup disagrees with current artifact")
        if _cycle_guard_read(pins["queue_path"]) != queue_raw:
            raise ValueError("recovery queue changed during validation")
        final_evidence = journal.recovery_evidence()
        if final_evidence["owner_token"] is not evidence["owner_token"] or final_evidence["prefix_sha256"] != evidence["prefix_sha256"]:
            raise ValueError("recovery custody changed during validation")
        elapsed = _same_boot_recovery_elapsed(tail["origin"], boot_id, clock(), max(tail["elapsed_seconds"], candidate["elapsed_seconds"]))
        check_stop()
        observation.update(validated=True, elapsed_seconds=elapsed, progress_by_item=copy.deepcopy(state["progress_by_item"]),
                           done_ids=list(state["done_ids"]), disposition=copy.deepcopy(state["disposition"]))
        queue_blocked = any(atlas_work_items.item_state(item) in atlas_work_items.ACTIVE_STATES
            or (item.get("claim") is not None and atlas_work_items.item_state(item) not in atlas_work_items.TERMINAL_STATES | {"blocked"})
            or (item.get("process_uncertainty") is not None and (type(item["process_uncertainty"]) is not dict or item["process_uncertainty"].get("status") != "resolved")) for item in by_id.values())
        if candidate["status"] == "report_only":
            return result("report_only", candidate["reason"])
        if inspection_error or stopped or elapsed >= tail["limits"]["cycle_seconds"]:
            return result("report_only", "stop_inspection_error" if inspection_error else "stop" if stopped else "deadline")
        if queue_blocked:
            return result("reconciliation_required", "queue retains active claim or process uncertainty")
        payload = {"queue_path": pins["queue_path"], "pins_path": frozen["pins_path"], "pins_raw_sha256": tail["pins_sha256"],
            "cycle_id": tail["cycle_id"], "controller_epoch": evidence["controller_epoch"], "origin": tail["origin"], "limits": tail["limits"],
            "admitted_item_ids": pins["admitted_item_ids"], "prefix_sha256": evidence["prefix_sha256"], "seq": tail["seq"],
            "elapsed_seconds": elapsed, "frozen": staged, "capsule": state, "counters": tail["counters"],
            "tail_patch": {key: tail[key] for key in _RecoverableCycleJournal._PATCH}, "selectors": selectors,
            "settled_item_ids": sorted(latest), "settlement_bindings": {
                sid: {key: copy.deepcopy(row[key]) for key in ("seq", "operation_id", "claim_key", "invocation_id", "result_sha256", "stored_result_sha256")}
                for sid, (row, _) in latest.items()}}
        seed = _CycleRecoverySeed(payload, evidence["owner_token"], journal, cancellation, seal=_CycleRecoverySeed._SEAL)
        return result("continuation_candidate", None, seed)
    except (ValueError, OSError, TypeError, KeyError, AttributeError, UnicodeError, RecursionError, OverflowError) as exc:
        return result("reconciliation_required", str(exc))



