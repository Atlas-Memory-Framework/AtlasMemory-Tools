        action="store_true",
        help="Post the triage Teams payload with local TEAMS_WEBHOOK_URL when configured.",
    )
    parser.add_argument("--atlas-bounded", action="store_true", help="Run one explicitly bounded, pinned local cycle.")
    parser.add_argument("--atlas-recoverable", action="store_true", help="Record a v2 cycle with conservative same-boot recovery.")
    parser.add_argument("--atlas-resume-cycle", help="Independently validate this exact v2 cycle under --atlas-bounded --atlas-recoverable.")
    parser.add_argument("--atlas-cycle-pins")
    parser.add_argument("--atlas-max-steps", type=int)
    parser.add_argument("--atlas-max-claims", type=int)
    parser.add_argument("--atlas-max-roles", type=int)
    parser.add_argument("--atlas-cycle-seconds", type=float)
    parser.add_argument("--atlas-worker-timeout-seconds", type=float)
    parser.add_argument("--atlas-worker-termination-grace-seconds", type=float)
    parser.add_argument("--atlas-stop-file")
    import sys
    argv = sys.argv[1:]
    args = parser.parse_args(argv)
    if args.atlas_bounded:
        try:
            result = _run_bounded_cli(args, argv)
        except (ValueError, OSError, RuntimeError) as exc:
            parser.exit(2, "Bounded supervisor refused: " + str(exc) + "\n")
        print(json.dumps(result, sort_keys=True, allow_nan=False), flush=True)
        if result["unresolved"] or result["terminal_outcome"] in {"blocked", "failed", "input_changed"}:
            raise SystemExit(2)
        return
    bounded_only = {"--atlas-cycle-pins", "--atlas-max-steps", "--atlas-max-claims", "--atlas-max-roles",
        "--atlas-cycle-seconds", "--atlas-worker-timeout-seconds", "--atlas-worker-termination-grace-seconds", "--atlas-stop-file"}
    if (args.atlas_recoverable or args.atlas_resume_cycle is not None
        or any(getattr(args, option[2:].replace("-", "_")) is not None for option in bounded_only)):
        parser.error("bounded-only options require --atlas-bounded")

    if not args.once and not args.daemon:
        args.once = True

    while True:
        count = process_once(args)
        stamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        print(f"{stamp} Processed {count} issue(s).", flush=True)
        if args.once:
            return
        time.sleep(args.sleep_seconds)


