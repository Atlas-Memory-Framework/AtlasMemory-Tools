    )


def process_atlas_work_items_once(args: argparse.Namespace) -> int:
    store = atlas_work_items.AtlasWorkItemStore(args.atlas_work_items)
    provider = atlas_work_items.AtlasWorkItemOperationProvider(store)
    if getattr(args, "dry_run", False):
        operations = provider.ready_operations(limit=max(1, int(getattr(args, "max_items", 1))))
        if not operations:
            print("DRY-RUN local Atlas work items: no ready items.", flush=True)
            return 0
        print(f"DRY-RUN local Atlas work items: {len(operations)} ready item(s).", flush=True)
        for operation in operations:
            print(
                f"DRY-RUN {operation.source_id}: {operation.title} [{operation.operation_id}]",
                flush=True,
            )
        return len(operations)
    command = shlex.split(args.atlas_work_item_command) if args.atlas_work_item_command else None
    if command is None and getattr(args, "atlas_role_command_config", None):
        command_config = str(Path(args.atlas_role_command_config).resolve())
        command = [
            str(common.RUNTIME_DIR / "atlas-agent-role-runner"),
            "--command-config",
            command_config,
            "--max-roles",
            str(max(1, int(getattr(args, "atlas_role_max", 1)))),
        ]
    templates_dir = args.team_templates or str(common.RUNTIME_DIR / "team-templates")
    worker = atlas_work_items.LocalCommandOperationWorker(
        command,
        jobs_dir=common.jobs_dir(),
        templates_dir=templates_dir,
        agent_registry_path=getattr(args, "agent_registry", None),
        agent_root=getattr(args, "agent_root", None),
    )
    processed = atlas_work_items.run_worker_daemon_once(
        provider,
        worker,
        limit=max(1, int(getattr(args, "max_items", 1))),
    )
    if processed:
        print(f"Processed {processed} local Atlas work item(s).", flush=True)
    else:
        print("No ready local Atlas work items.", flush=True)
    return processed


def process_once(args: argparse.Namespace) -> int:
    if getattr(args, "atlas_work_items", None):
        return process_atlas_work_items_once(args)

    processed = 0
    queued = 0
    max_per_repo = getattr(args, "max_per_repo", 1)
    lease_stale_seconds = getattr(args, "lease_stale_seconds", 6 * 60 * 60)
    dispatch_preview = {
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "next_runnable": [],
        "blocked": [],
        "counts": {"runnable": 0, "blocked": 0},
    }
    if args.triage_needs_human:
        triage_cmd = [str(common.RUNTIME_DIR / "atlas-agent-triage"), "--limit", str(args.limit)]
        if args.repos_file:
            triage_cmd.extend(["--repos-file", args.repos_file])
        if args.triage_apply_stale and not getattr(args, "dry_run", False):
            triage_cmd.append("--apply-stale")
        if args.triage_approve_review_before_dispatch and not getattr(args, "dry_run", False):
            triage_cmd.append("--approve-review-before-dispatch")
        if args.triage_clean_pause_labels and not getattr(args, "dry_run", False):
            triage_cmd.append("--clean-pause-labels")
        if args.triage_comment and not getattr(args, "dry_run", False):
            triage_cmd.append("--comment")
        if args.triage_summary:
            triage_cmd.extend(["--summary", args.triage_summary])
        if args.triage_teams_preview:
            triage_cmd.append("--teams-preview")
        if args.triage_post_teams:
            triage_cmd.append("--post-teams")
        subprocess.run(triage_cmd, cwd=str(common.RUNTIME_DIR), check=False)

    for repo in target_repos(args.repos_file):
        repo_processed = 0
        if not getattr(args, "dry_run", False):
            ensure_agent_labels(repo)

        if args.auto_queue_label and queued < args.auto_queue_max:
            candidates = queue_candidate_issues(repo, args.auto_queue_label, args.limit)
            for issue in candidates:
                if maybe_queue_issue(repo, issue, args):
                    queued += 1
                if queued >= args.auto_queue_max:
                    break

        repo_failed = failed_issues(repo, args.limit) if args.inspect_failed else []
        if repo_failed is None:
            print(f"Skipping {repo}: failed issue query did not complete.", flush=True)
            continue
        repo_ready = ready_issues(repo, args.limit)
        if repo_ready is None:
            print(f"Skipping {repo}: ready issue query did not complete.", flush=True)
            continue
        blockers_by_number: dict[int, list[str]] = {}
        repo_runnable = 0
        for issue in repo_ready:
            execution_repo = execution_repo_for_issue(repo, issue)
            reasons = dispatch_blockers(
                repo,
                issue,
                args,
                check_open_pr=bool(args.auto_queue_skip_open_pr),
            )
            blockers_by_number[int(issue["number"])] = reasons
            if reasons:
                dispatch_preview["blocked"].append(dispatch_preview_record(repo, issue, reasons))
            elif repo_runnable < max_per_repo and len(dispatch_preview["next_runnable"]) < args.max_items:
                record = dispatch_preview_record(repo, issue, [])
                record["execution_repo"] = execution_repo
                dispatch_preview["next_runnable"].append(record)
                repo_runnable += 1
        dispatch_preview["counts"] = {
            "runnable": len(dispatch_preview["next_runnable"]),
            "blocked": len(dispatch_preview["blocked"]),
        }
        write_dispatch_preview(getattr(args, "triage_summary", None), dispatch_preview)
        print_dispatch_preview(dispatch_preview)

        if args.inspect_failed:
            for issue in repo_failed:
                labels = common.label_names(issue)
                reasons = failed_inspection_hard_reasons(
                    issue,
                    require_one_point=bool(getattr(args, "require_one_point", False)),
                )
                if reasons:
                    print(
                        f"Skipping failed inspection for {repo}#{issue['number']}: {', '.join(reasons)}.",
                        flush=True,
                    )
                    continue
                admin_inspect(
                    repo,
                    issue["number"],
                    args.auto_create_missing_base,
                    args.auto_allow_policy_labels,
                )

        for issue in repo_ready:
            if repo_processed >= max_per_repo:
                break
            labels = common.label_names(issue)
            reasons = blockers_by_number.get(int(issue["number"]), [])
            if "agent:running" in labels or reasons:
                if reasons:
                    print(f"Skipping {repo}#{issue['number']}: {', '.join(reasons)}.", flush=True)
                    if not getattr(args, "dry_run", False) and not any("missing policy allow label" in reason for reason in reasons):
                        common.run(
                            ["gh", "issue", "edit", str(issue["number"]), "--repo", repo, "--remove-label", "agent:ready"],
                            check=False,
                        )
                continue
            if getattr(args, "dry_run", False):
                execution_repo = execution_repo_for_issue(repo, issue)
                print(
                    f"DRY-RUN process {repo}#{issue['number']} in {execution_repo}: {issue['title']}",
                    flush=True,
                )
                processed += 1
                repo_processed += 1
                if processed >= args.max_items:
                    return processed
                continue
            execution_repo = execution_repo_for_issue(repo, issue)
            print(f"Processing {repo}#{issue['number']} in {execution_repo}: {issue['title']}")
            lease = acquire_issue_lease(repo, issue, lease_stale_seconds)
            if not lease:
                continue
            if args.auto_queue_skip_open_pr and has_open_pr_for_issue(repo, issue["number"]):
                print(f"Skipping {repo}#{issue['number']}: open PR appeared before worker start.", flush=True)
                release_issue_lease(lease)
                common.run(
                    ["gh", "issue", "edit", str(issue["number"]), "--repo", repo, "--remove-label", "agent:ready"],
                    check=False,
                )
                continue
            base_branch = dispatch_base_branch(execution_repo, issue)
            scope_lease: list[Path] = []
            if getattr(args, "write_scope_locks", True):
                scope_lease, scope_blocker = acquire_write_scope_lease(
                    execution_repo,
                    issue,
                    base_branch,
                    lease_stale_seconds,
                )
                if scope_blocker:
                    print(f"Skipping {repo}#{issue['number']}: {scope_blocker}.", flush=True)
                    release_issue_lease(lease)
                    continue
            maybe_dispatch_deploy_candidate(repo, issue, args)
            common.update_issue_automation_state(repo, int(issue["number"]), "Running", status="In Progress")
            try:
                rc = run_worker(
                    repo,
                    execution_repo,
                    issue["number"],
                    publish=args.publish,
                    base_branch=common.issue_body_base_branch(issue),
                )
                processed += 1
                repo_processed += 1
                notify_worker_result(repo, issue, rc)
                if rc != 0:
                    admin_inspect(
                        repo,
                        issue["number"],
                        args.auto_create_missing_base,
                        args.auto_allow_policy_labels,
                    )
            finally:
                release_write_scope_lease(scope_lease)
                release_issue_lease(lease)
            if processed >= args.max_items:
                return processed
    return processed


def _bounded_cli_selectors(pins: dict, frozen: dict) -> dict:
    """Reuse B4's admitted read/selection seams for canonical worker arguments."""
    import atlas_workflows
    source = pins["template_source"]
    if source["mode"] == "directory":
        _cycle_guard_directory(source["path"])
        candidates = sorted(str(Path(source["path"]) / name) for name in os.listdir(source["path"]) if name.endswith(".json"))
    else:
        candidates = [source["path"]]
    registries = [row for row in pins["inputs"] if row["kind"] == "registry"]
    if candidates != source["candidates"] or len(registries) > 1:
        raise ValueError("bounded selector membership or cardinality changed")
    for path in candidates:
        os.close(_cycle_guard_open(path))
    declarations = {row["path"]: row for row in pins["inputs"]}
    def read(path):
        if path not in declarations:
            raise ValueError("undeclared bounded selector")
        raw = _cycle_guard_read(path)
        if hashlib.sha256(raw).hexdigest() != declarations[path]["sha256"]:
            raise ValueError("bounded selector digest changed")
        return _cycle_guard_json(raw)
    templates = [atlas_workflows.TeamTemplate.from_dict(read(path)) for path in candidates]
    if any(template.validate() for template in templates):
        raise ValueError("invalid bounded template")
    registry = atlas_workflows.AgentRegistry.from_dict(read(registries[0]["path"])) if registries else None
    selected = []
    for source_id in pins["admitted_item_ids"]:
        immutable = frozen["source_snapshot"]["immutable_inputs"][source_id]
        item = {"id": source_id, "scheduler": immutable["scheduling"]}
        template = atlas_workflows.select_team_template_for_work_item(templates, item)
        if template is None or template.id != frozen["source_snapshot"]["expected_static"][source_id]["template_id"]:
            raise ValueError("bounded selected template changed")
        selected.append(template)
    return _cycle_guard_selectors(pins, selected, registry)


class _BoundedCliCancellation:
    def __init__(self, stop_file: str):
        self.stop_file, self.latched, self.error = stop_file, False, None

    def signal(self, signum, frame):
        self.latched = True

    def is_set(self) -> bool:
        if self.error is not None:
            raise self.error
        if self.latched:
            return True
        try:
            parent = str(Path(self.stop_file).parent)
            fd = (os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW) if parent == "/"
                  else _cycle_guard_open(parent, directory=True))
            try:
                os.listdir(fd)  # Absence is trusted only under an inspectable parent.
                try:
                    os.stat(Path(self.stop_file).name, dir_fd=fd, follow_symlinks=False)
                except FileNotFoundError:
                    return False
                self.latched = True
                return True
            finally:
                os.close(fd)
        except Exception as exc:
            self.error = exc
            raise


def _bounded_cli_jobs(root: Path, identity=None):
    """Initialize once under the journal lock, then verify the same directory."""
    if identity is None:
        parent = _cycle_guard_open(str(root.parent), directory=True)
        try:
            os.mkdir(root.name, mode=0o700, dir_fd=parent)
            child = os.open(root.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
            try:
                os.fsync(child)
                os.fsync(parent)
                value = os.fstat(child)
                return value.st_dev, value.st_ino
            finally:
                os.close(child)
        finally:
            os.close(parent)
    child = _cycle_guard_open(str(root), directory=True)
    try:
        value = os.fstat(child)
        if (value.st_dev, value.st_ino) != identity:
            raise ValueError("bounded jobs root changed")
        return identity
    finally:
        os.close(child)


def _bounded_cli_runtime() -> Path:
    runtime = Path(__file__).resolve().parent
    if (Path(__file__).resolve() != runtime / "atlas-agent-orchestrator"
        or runtime != Path(common.RUNTIME_DIR).resolve() or runtime != Path(atlas_work_items.__file__).resolve().parent):
        raise ValueError("bounded runtime modules have different source roots")
    return runtime


def _bounded_cli_boot_id() -> str:
    """Read the actual Linux monotonic-domain identity, without a fallback."""
    boot = Path("/proc/sys/kernel/random/boot_id").read_text(encoding="ascii").strip()
    if re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", boot) is None:
        raise ValueError("invalid current Linux boot UUID")
    return boot


def _bounded_cli_recovery_observation(status: str, reason, observation: dict) -> dict:
    """Serialize independent read-only evidence; never issue a historical witness."""
    observation = copy.deepcopy(observation)
    disposition = observation.get("disposition", {})
    terminal = disposition.get("outcome") if status == "report_only" else None
    if terminal is None:
        terminal = "cancelled" if status == "report_only" else "blocked"
    failure = disposition.get("reason") if disposition.get("outcome") == terminal else reason
    return {"terminal_outcome": terminal, "unresolved": status != "report_only", "closure_witness": None,
        "failure": failure, "counters": observation.get("counters"),
        "elapsed_seconds": observation.get("elapsed_seconds"), "progress_by_item": observation.get("progress_by_item", {}),
        "recovery": observation | {"status": status, "reason": reason}}


def _run_recoverable_cli(args: argparse.Namespace, argv: list[str]) -> dict:
    """Compose explicit v2 custody, fresh trust admission and the existing worker."""
    import signal
    import uuid
    entry = time.monotonic()
    if type(entry) not in (int, float) or not math.isfinite(entry) or entry < 0:
        raise ValueError("invalid recoverable entry clock")
    mandatory = {"--atlas-bounded", "--atlas-recoverable", "--atlas-work-items", "--atlas-role-command-config", "--atlas-cycle-pins",
        "--atlas-max-steps", "--atlas-max-claims", "--atlas-max-roles", "--atlas-role-max", "--atlas-cycle-seconds",
        "--atlas-worker-timeout-seconds", "--atlas-worker-termination-grace-seconds", "--atlas-stop-file"}
    options = [token.split("=", 1)[0] for token in argv if token.startswith("--")]
    allowed = mandatory | {"--atlas-resume-cycle", "--once", "--team-templates", "--agent-registry", "--agent-root"}
    if not mandatory.issubset(options) or len(options) != len(set(options)) or set(options) - allowed:
        raise ValueError("recoverable mode requires explicit unique options and forbids legacy/mixed modes")
    resume = args.atlas_resume_cycle
    if resume is not None and (type(resume) is not str or re.fullmatch("[0-9a-f]{32}", resume) is None):
        raise ValueError("invalid explicit recovery cycle")
    limits = {"max_steps": args.atlas_max_steps, "max_claims": args.atlas_max_claims, "max_roles": args.atlas_max_roles,
        "role_max": args.atlas_role_max, "cycle_seconds": args.atlas_cycle_seconds,
        "worker_timeout_seconds": args.atlas_worker_timeout_seconds,
        "worker_termination_grace_seconds": args.atlas_worker_termination_grace_seconds, "stop_file": args.atlas_stop_file}
    _bounded_budget_reduce({key: limits[key] for key in ("max_steps", "max_claims", "max_roles", "role_max", "cycle_seconds")},
        {"steps": 0, "claims_reserved": 0, "roles_reserved": 0, "cancelled": False, "cancel_reason": None},
        {"kind": "check", "elapsed_seconds": 0, "stop_requested": False})
    for key in ("worker_timeout_seconds", "worker_termination_grace_seconds"):
        value = limits[key]
        if type(value) not in (int, float) or not math.isfinite(value) or value < 0 or (key == "worker_timeout_seconds" and value == 0):
            raise ValueError("invalid explicit worker duration")
    for path in (args.atlas_work_items, args.atlas_role_command_config, args.atlas_cycle_pins, args.atlas_stop_file,
                 args.team_templates, args.agent_registry, args.agent_root):
        if path is not None:
            _cycle_guard_path(path)
    cancellation = _BoundedCliCancellation(args.atlas_stop_file)
    prior_handlers, candidate, journal = {}, None, None
    observation = {"validated": False, "cycle_id": resume, "controller_epoch": None,
        "old_tail_acknowledgment": "unknown", "evidence_source": "selected_existing_history",
        "origin": None, "frontier": None, "seq": None, "prefix_sha256": None,
        "counters": None, "limits": None, "elapsed_seconds": None}
    try:
        for signum in (signal.SIGINT, signal.SIGTERM):
            previous = signal.getsignal(signum)
            signal.signal(signum, cancellation.signal)
            prior_handlers[signum] = previous
        try:
            if resume is not None:
                # No pins or selected artifact is read before existing-only
                # lock acquisition and original pathname admission.
                candidate = _RecoverableCycleJournal.acquire_for_recovery(args.atlas_work_items, resume)
                selected = candidate.snapshot()
                tail = selected["tail"]
                observation.update({key: copy.deepcopy(tail[key]) for key in ("cycle_id", "controller_epoch", "seq", "origin", "limits", "counters", "elapsed_seconds")})
                observation.update(frontier=tail["event"], prefix_sha256=selected["prefix_sha256"])
                if tail["origin"]["pins_path"] != args.atlas_cycle_pins:
                    raise ValueError("recovery pins path differs from original before pins read")
                if _CycleJournal._line(limits) != _CycleJournal._line(tail["limits"]):
                    raise ValueError("explicit recovery limits differ from original")
            raw = _cycle_guard_read(args.atlas_cycle_pins)
            pins = _decode_cycle_pins(raw)
            if pins["queue_path"] != args.atlas_work_items:
                raise ValueError("bounded queue differs from pins")
            raw_digest = hashlib.sha256(raw).hexdigest()
            cycle = resume or uuid.uuid4().hex
            epoch = uuid.uuid4().hex
            _RecoveryProtocol.hex(cycle, {32}, "internally generated cycle")
            _RecoveryProtocol.hex(epoch, {32}, "internally generated epoch")
            queue, pins_path = pins["queue_path"], args.atlas_cycle_pins
            if resume is not None:
                journal = _RecoverableCycleJournal.from_recovery_candidate(candidate, pins, raw_digest, limits,
                    controller_epoch=epoch, acknowledged_closures={})
            runtime = _bounded_cli_runtime()
            if pins["runtime"]["checkout_path"] != str(runtime.parent.parent):
                raise ValueError("pins do not bind the executing runtime checkout")
            declared_configs = [row["path"] for row in pins["inputs"] if row["kind"] == "role_command_config"]
            if declared_configs != [args.atlas_role_command_config]:
                raise ValueError("bounded command config differs from declaration")
            boot = _bounded_cli_boot_id()
            progress = {}
            frozen = {"pins_path": pins_path, "pins_raw_sha256": raw_digest, "cycle_id": cycle,
                "source_snapshot": None, "progress_by_item": progress}
            seed, selectors = None, None
            def check_selectors(selected):
                for argument, derived in ((args.team_templates, selected["templates_dir"]),
                    (args.agent_registry, selected["agent_registry_path"]), (args.agent_root, selected["agent_root"])):
                    if argument is not None and argument != derived:
                        raise ValueError("bounded selector conflicts with pinned derivation")
            if resume is not None:
                state = tail["recovery_state"]
                if state is not None:
                    staged = frozen | {"source_snapshot": copy.deepcopy(state["source_snapshot"]),
                        "progress_by_item": copy.deepcopy(state["progress_by_item"])}
                    check_selectors(_bounded_cli_selectors(pins, staged))
                admitted = _admit_cycle_recovery(pins, frozen, journal=journal, boot_id=boot,
                    monotonic=time.monotonic, cancellation=cancellation)
                observation = admitted["observation"] | {"evidence_source": "held_existing_history"}
                if admitted["status"] != "continuation_candidate":
                    return _bounded_cli_recovery_observation(admitted["status"], admitted["reason"], observation)
                seed = admitted["seed"]
                elapsed = _same_boot_recovery_elapsed(tail["origin"], boot, time.monotonic(), observation["elapsed_seconds"])
                observation["elapsed_seconds"] = elapsed
                try:
                    stopped = cancellation.is_set()
                except Exception:
                    return _bounded_cli_recovery_observation("report_only", "stop_inspection_error", observation)
                if stopped or elapsed >= limits["cycle_seconds"]:
                    return _bounded_cli_recovery_observation("report_only", "stop" if stopped else "deadline", observation)
                admission = seed.admission_patch(elapsed_seconds=elapsed)
                journal.acknowledge_recovery(admission, expected_prefix_sha256=observation["prefix_sha256"])
                restored = _recovery_seed_state(seed, journal=journal)
                # Stage every copy before installing either live map. These
                # maps preserve the original source authority and share progress.
                installed = copy.deepcopy(restored["frozen"])
                selectors = copy.deepcopy(restored["selectors"])
                check_selectors(selectors)
                inputs = {key: copy.deepcopy(restored[key]) for key in ("queue_path", "pins_path", "pins_raw_sha256", "cycle_id", "limits", "admitted_item_ids")}
                inputs.update(entry_monotonic=restored["origin"]["entry_monotonic"], progress_by_item=installed["progress_by_item"])
                frozen, progress = installed, installed["progress_by_item"]
            else:
                origin = {"boot_id": boot, "entry_monotonic": entry, "pins_path": pins_path}
                journal = _RecoverableCycleJournal(queue, pins, raw_digest, limits, cycle_id=cycle,
                    acknowledged_closures={}, controller_epoch=epoch, origin=origin)
                inputs = {"queue_path": queue, "pins_path": pins_path, "pins_raw_sha256": raw_digest, "cycle_id": cycle,
                    "entry_monotonic": entry, "limits": limits, "admitted_item_ids": list(pins["admitted_item_ids"]), "progress_by_item": progress}
            queue_key = hashlib.sha256(queue.encode("utf-8")).hexdigest()
            jobs = Path(queue).parent / ".atlas-supervisor" / queue_key / (cycle + ".jobs")
            store = atlas_work_items.AtlasWorkItemStore(queue)
            provider = atlas_work_items.AtlasWorkItemOperationProvider(store)
            def guard(checkpoint, operation):
                nonlocal selectors
                if (frozen.get("cycle_id") != cycle or inputs.get("cycle_id") != cycle or inputs.get("queue_path") != queue
                    or pins.get("queue_path") != queue or inputs.get("pins_path") != pins_path
                    or inputs.get("pins_raw_sha256") != raw_digest or frozen.get("pins_path") != pins_path
                    or frozen.get("pins_raw_sha256") != raw_digest or inputs.get("progress_by_item") is not frozen.get("progress_by_item")):
                    return {"changed": True, "reason": "input_changed", "head_changed": False, "trusted_expectation": None}
                if checkpoint != "entry":
                    identity = journal.owned_jobs_identity()
                    _bounded_cli_jobs(jobs, (identity["device"], identity["inode"]))
                frame = _observe_cycle_inputs(pins, frozen, checkpoint, operation)
                if checkpoint == "entry" and not frame["changed"]:
                    import atlas_local_sizing
                    for source_id in pins["admitted_item_ids"]:
                        context = frozen["source_snapshot"]["immutable_inputs"][source_id]["context"]
                        expected = frozen["source_snapshot"]["expected_static"][source_id]
                        if type(context.get("local_execution_v1")) is not dict or atlas_local_sizing.qualify(context,
                            [{"role_id": role["role_id"], "goal_gate": role["goal_gate"]} for role in expected["roles"]])["status"] != "qualified":
                            raise ValueError("bounded work requires qualified explicit local model routing")
                    selectors = _bounded_cli_selectors(pins, frozen)
                    check_selectors(selectors)
                return frame
            def capsule_factory(*, progress_by_item, done_ids, cancellation, disposition, settlement):
                return {"source_snapshot": copy.deepcopy(frozen["source_snapshot"]), "progress_by_item": progress_by_item,
                    "done_ids": done_ids, "cancellation": cancellation, "jobs_identity": None, "disposition": disposition, "settlement": settlement}
            def worker_factory(allowance):
                return atlas_work_items.LocalCommandOperationWorker(
                    [str(runtime / "atlas-agent-role-runner"), "--command-config", selectors["command_config"],
                     "--max-roles", str(allowance)], jobs_dir=jobs, templates_dir=selectors["templates_dir"],
                    agent_registry_path=selectors["agent_registry_path"], agent_root=selectors["agent_root"],
                    timeout_seconds=limits["worker_timeout_seconds"], termination_grace_seconds=limits["worker_termination_grace_seconds"])
            result = _run_bounded_cycle(inputs, provider=provider, worker_factory=worker_factory, monotonic=time.monotonic,
                cancellation=cancellation, journal=journal, guard=guard, recovery_seed=seed,
                recovery_capsule_factory=capsule_factory if resume is None else None)
            # The adapter released custody. These are retained memory copies,
            # not a fresh disk observation or authority. Old acknowledgment
            # remains unknown; local admission means this process's return only.
            memory = journal._events[-1] if journal._events else None
            report = {"cycle_id": cycle, "controller_epoch": epoch, "old_tail_acknowledgment": "unknown" if resume else None,
                "evidence_source": "controller_memory_after_release", "validated": False,
                "local_recovery_admitted": journal._local_recovery_ack is not None,
                "frontier": None, "seq": None, "prefix_sha256": None,
                "origin": copy.deepcopy(journal._owned["origin"]), "limits": copy.deepcopy(limits),
                "counters": copy.deepcopy(result["counters"])}
            if memory is not None:
                report.update({key: copy.deepcopy(memory[key]) for key in ("seq", "origin", "limits", "counters")})
                report.update(frontier=memory["event"], prefix_sha256=hashlib.sha256(journal._raw).hexdigest())
            status = "reconciliation_required" if result["unresolved"] else "resumed" if resume else "new_cycle"
            return result | {"recovery": report | {"status": status, "mode": "resume" if resume else "fresh", "reason": result["failure"]}}
        except (ValueError, OSError, RuntimeError, UnicodeError) as exc:
            if resume is None:
                raise
            return _bounded_cli_recovery_observation("reconciliation_required", str(exc), observation)
    finally:
        errors = []
        for owner in (journal, candidate):
            if owner is not None:
                try:
                    owner.release()
                except Exception as exc:
                    errors.append(exc)
        for signum, handler in prior_handlers.items():
            try:
                signal.signal(signum, handler)
            except Exception as exc:
                errors.append(exc)
        if errors:
            raise errors[0]


def _run_bounded_cli(args: argparse.Namespace, argv: list[str]) -> dict:
    """Compose exactly one local finite cycle without entering legacy startup."""
    if getattr(args, "atlas_recoverable", False) or getattr(args, "atlas_resume_cycle", None) is not None:
        return _run_recoverable_cli(args, argv)
    import signal
    import uuid
    entry = time.monotonic()
    if type(entry) not in (int, float) or not math.isfinite(entry):
        raise ValueError("invalid bounded entry clock")
    mandatory = {"--atlas-bounded", "--atlas-work-items", "--atlas-role-command-config", "--atlas-cycle-pins",
        "--atlas-max-steps", "--atlas-max-claims", "--atlas-max-roles", "--atlas-role-max", "--atlas-cycle-seconds",
        "--atlas-worker-timeout-seconds", "--atlas-worker-termination-grace-seconds", "--atlas-stop-file"}
    options = [token.split("=", 1)[0] for token in argv if token.startswith("--")]
    allowed = mandatory | {"--once", "--team-templates", "--agent-registry", "--agent-root"}
    if not mandatory.issubset(options) or len(options) != len(set(options)) or set(options) - allowed:
        raise ValueError("bounded mode requires explicit unique options and forbids legacy/mixed modes")
    limits = {"max_steps": args.atlas_max_steps, "max_claims": args.atlas_max_claims, "max_roles": args.atlas_max_roles,
        "role_max": args.atlas_role_max, "cycle_seconds": args.atlas_cycle_seconds,
        "worker_timeout_seconds": args.atlas_worker_timeout_seconds,
        "worker_termination_grace_seconds": args.atlas_worker_termination_grace_seconds, "stop_file": args.atlas_stop_file}
    _bounded_budget_reduce({key: limits[key] for key in ("max_steps", "max_claims", "max_roles", "role_max", "cycle_seconds")},
        {"steps": 0, "claims_reserved": 0, "roles_reserved": 0, "cancelled": False, "cancel_reason": None},
        {"kind": "check", "elapsed_seconds": 0, "stop_requested": False})
    for key in ("worker_timeout_seconds", "worker_termination_grace_seconds"):
        value = limits[key]
        if type(value) not in (int, float) or not math.isfinite(value) or value < 0 or (key == "worker_timeout_seconds" and value == 0):
            raise ValueError("invalid explicit worker duration")
    for path in (args.atlas_work_items, args.atlas_role_command_config, args.atlas_cycle_pins, args.atlas_stop_file):
        _cycle_guard_path(path)
    cancellation = _BoundedCliCancellation(args.atlas_stop_file)
    prior_handlers = {}
    try:
        for signum in (signal.SIGINT, signal.SIGTERM):
            previous = signal.getsignal(signum)
            signal.signal(signum, cancellation.signal)
            prior_handlers[signum] = previous
        raw = _cycle_guard_read(args.atlas_cycle_pins)
        pins = _decode_cycle_pins(raw)
        if pins["queue_path"] != args.atlas_work_items:
            raise ValueError("bounded queue differs from pins")
        runtime = _bounded_cli_runtime()
        if pins["runtime"]["checkout_path"] != str(runtime.parent.parent):
            raise ValueError("pins do not bind the executing runtime checkout")
        declared_configs = [row["path"] for row in pins["inputs"] if row["kind"] == "role_command_config"]
        if declared_configs != [args.atlas_role_command_config]:
            raise ValueError("bounded command config differs from declaration")
        cycle = uuid.uuid4().hex
        if type(cycle) is not str or re.fullmatch("[0-9a-f]{32}", cycle) is None:
            raise ValueError("invalid internally generated cycle")
        queue, pins_path, raw_digest = pins["queue_path"], args.atlas_cycle_pins, hashlib.sha256(raw).hexdigest()
        queue_key = hashlib.sha256(queue.encode("utf-8")).hexdigest()
        jobs = Path(queue).parent / ".atlas-supervisor" / queue_key / (cycle + ".jobs")
        progress = {}
        frozen = {"pins_path": pins_path, "pins_raw_sha256": raw_digest, "cycle_id": cycle,
            "source_snapshot": None, "progress_by_item": progress}
        inputs = {"queue_path": queue, "pins_path": pins_path, "pins_raw_sha256": raw_digest, "cycle_id": cycle,
            "entry_monotonic": entry, "limits": limits, "admitted_item_ids": list(pins["admitted_item_ids"]),
            "progress_by_item": progress}
        journal = _CycleJournal(queue, pins, raw_digest, limits, cycle_id=cycle, acknowledged_closures={})
        store = atlas_work_items.AtlasWorkItemStore(queue)
        provider = atlas_work_items.AtlasWorkItemOperationProvider(store)
        selectors, jobs_identity = None, None
        def guard(checkpoint, operation):
            nonlocal selectors, jobs_identity
            if (frozen.get("cycle_id") != cycle or inputs.get("cycle_id") != cycle or inputs.get("queue_path") != queue
                or pins.get("queue_path") != queue or inputs.get("pins_path") != pins_path
                or inputs.get("pins_raw_sha256") != raw_digest or frozen.get("pins_path") != pins_path
                or frozen.get("pins_raw_sha256") != raw_digest):
                return {"changed": True, "reason": "input_changed", "head_changed": False, "trusted_expectation": None}
            if checkpoint == "before_step" or jobs_identity is not None:
                jobs_identity = _bounded_cli_jobs(jobs, jobs_identity)
            frame = _observe_cycle_inputs(pins, frozen, checkpoint, operation)
            if checkpoint == "entry" and not frame["changed"]:
                import atlas_local_sizing
                for source_id in pins["admitted_item_ids"]:
                    context = frozen["source_snapshot"]["immutable_inputs"][source_id]["context"]
                    expected = frozen["source_snapshot"]["expected_static"][source_id]
                    if type(context.get("local_execution_v1")) is not dict or atlas_local_sizing.qualify(context,
                        [{"role_id": role["role_id"], "goal_gate": role["goal_gate"]} for role in expected["roles"]])["status"] != "qualified":
                        raise ValueError("bounded work requires qualified explicit local model routing")
                selectors = _bounded_cli_selectors(pins, frozen)
                for argument, selected in ((args.team_templates, selectors["templates_dir"]),
                    (args.agent_registry, selectors["agent_registry_path"]), (args.agent_root, selectors["agent_root"])):
                    if argument is not None:
                        _cycle_guard_path(argument)
                        if argument != selected:
                            raise ValueError("bounded selector conflicts with pinned derivation")
            return frame
        def worker_factory(allowance):
            return atlas_work_items.LocalCommandOperationWorker(
                [str(runtime / "atlas-agent-role-runner"), "--command-config", selectors["command_config"],
                 "--max-roles", str(allowance)], jobs_dir=jobs, templates_dir=selectors["templates_dir"],
                agent_registry_path=selectors["agent_registry_path"], agent_root=selectors["agent_root"],
                timeout_seconds=limits["worker_timeout_seconds"], termination_grace_seconds=limits["worker_termination_grace_seconds"])
        return _run_bounded_cycle(inputs, provider=provider, worker_factory=worker_factory, monotonic=time.monotonic,
            cancellation=cancellation, journal=journal, guard=guard)
    finally:
        errors = []
        for signum, handler in prior_handlers.items():
            try:
                signal.signal(signum, handler)
            except Exception as exc:
                errors.append(exc)
        if errors:
            raise errors[0]


