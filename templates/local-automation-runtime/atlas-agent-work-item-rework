#!/usr/bin/env python3
"""Request the single explicit local rework attempt for a blocked work item."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
import atlas_work_items


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("store")
    parser.add_argument("--id", required=True)
    parser.add_argument("--reason", required=True)
    parser.add_argument("--evidence", action="append", required=True)
    args = parser.parse_args()
    provider = atlas_work_items.AtlasWorkItemOperationProvider(atlas_work_items.AtlasWorkItemStore(args.store))
    try:
        item = provider.requeue_for_rework(args.id, reason=args.reason, evidence=args.evidence)
    except ValueError as exc:
        parser.error(str(exc))
    print(json.dumps({"id": args.id, "state": item["state"], "rework_count": item["lifecycle"]["rework_count"]}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
