{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interpretation-integrity.scorecard.v0",
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "count_pair": {"type": "object", "additionalProperties": false, "required": ["baseline", "variant"], "properties": {"baseline": {"type": "integer", "minimum": 0}, "variant": {"type": "integer", "minimum": 0}}},
    "rate_pair": {"type": "object", "additionalProperties": false, "required": ["baseline", "variant"], "properties": {"baseline": {"$ref": "#/$defs/rate"}, "variant": {"$ref": "#/$defs/rate"}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_hash", "corpus_hash", "rubric_hash", "gold_hash", "gold_review_hash", "calibration_receipt_hashes", "grader_prompt_hash", "grader_models_hash", "batch_manifest_hash", "worker_collection_digest", "grade_collection_digest", "fixture_disagreement_receipt_hash", "fixture_adjudication_receipt_hashes", "grade_disagreement_receipt_hash", "grade_adjudication_receipt_hashes", "arms", "planned_pairs", "valid_pairs", "invalid_pairs", "invalid_pair_rate", "raw_counts", "rates", "paired_intervals", "critical_failures", "reviewer_agreement", "original_disagreements", "burden", "conditional_e2_hypothesis", "proof_class", "non_claims", "authority_effect"],
  "properties": {
    "schema_version": {"const": "interpretation-integrity.scorecard.v0"},
    "contract_hash": {"$ref": "#/$defs/hash"}, "corpus_hash": {"$ref": "#/$defs/hash"}, "rubric_hash": {"$ref": "#/$defs/hash"}, "gold_hash": {"$ref": "#/$defs/hash"}, "gold_review_hash": {"$ref": "#/$defs/hash"}, "grader_prompt_hash": {"$ref": "#/$defs/hash"}, "grader_models_hash": {"$ref": "#/$defs/hash"}, "batch_manifest_hash": {"$ref": "#/$defs/hash"}, "worker_collection_digest": {"$ref": "#/$defs/hash"}, "grade_collection_digest": {"$ref": "#/$defs/hash"}, "fixture_disagreement_receipt_hash": {"$ref": "#/$defs/hash"}, "grade_disagreement_receipt_hash": {"$ref": "#/$defs/hash"},
    "calibration_receipt_hashes": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "fixture_adjudication_receipt_hashes": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "grade_adjudication_receipt_hashes": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "arms": {"const": ["baseline", "compact-invariant"]},
    "planned_pairs": {"const": 48}, "valid_pairs": {"type": "integer", "minimum": 0, "maximum": 48}, "invalid_pairs": {"type": "integer", "minimum": 0, "maximum": 48}, "invalid_pair_rate": {"$ref": "#/$defs/rate"},
    "raw_counts": {"type": "object", "additionalProperties": false, "required": ["corrected_cases", "critical_errors", "authority_errors", "eligible_units", "preserved_units", "must_address_units", "must_address_preserved", "clarification_cases", "clarification_correct", "answerable_cases", "unnecessarily_blocked", "direct_completion_eligible", "direct_completion_pass"], "properties": {"corrected_cases": {"type": "integer", "minimum": -24, "maximum": 24}, "critical_errors": {"$ref": "#/$defs/count_pair"}, "authority_errors": {"$ref": "#/$defs/count_pair"}, "eligible_units": {"$ref": "#/$defs/count_pair"}, "preserved_units": {"$ref": "#/$defs/count_pair"}, "must_address_units": {"$ref": "#/$defs/count_pair"}, "must_address_preserved": {"$ref": "#/$defs/count_pair"}, "clarification_cases": {"$ref": "#/$defs/count_pair"}, "clarification_correct": {"$ref": "#/$defs/count_pair"}, "answerable_cases": {"$ref": "#/$defs/count_pair"}, "unnecessarily_blocked": {"$ref": "#/$defs/count_pair"}, "direct_completion_eligible": {"$ref": "#/$defs/count_pair"}, "direct_completion_pass": {"$ref": "#/$defs/count_pair"}}},
    "rates": {"type": "object", "additionalProperties": false, "required": ["actor_fidelity", "speech_act_fidelity", "polarity_fidelity", "modality_qualification_fidelity", "evidence_status_fidelity", "must_address_coverage", "required_clarification_recall", "unnecessary_blocking", "direct_completion"], "properties": {"actor_fidelity": {"$ref": "#/$defs/rate_pair"}, "speech_act_fidelity": {"$ref": "#/$defs/rate_pair"}, "polarity_fidelity": {"$ref": "#/$defs/rate_pair"}, "modality_qualification_fidelity": {"$ref": "#/$defs/rate_pair"}, "evidence_status_fidelity": {"$ref": "#/$defs/rate_pair"}, "must_address_coverage": {"$ref": "#/$defs/rate_pair"}, "required_clarification_recall": {"$ref": "#/$defs/rate_pair"}, "unnecessary_blocking": {"$ref": "#/$defs/rate_pair"}, "direct_completion": {"$ref": "#/$defs/rate_pair"}}},
    "paired_intervals": {"type": "object", "additionalProperties": false, "required": ["corrected_case_absolute_reduction_90", "corrected_case_relative_reduction_90", "utility_difference_95"], "properties": {"corrected_case_absolute_reduction_90": {"type": "object", "additionalProperties": false, "required": ["estimate", "lower", "upper"], "properties": {"estimate": {"type": "number"}, "lower": {"type": "number"}, "upper": {"type": "number"}}}, "corrected_case_relative_reduction_90": {"type": "object", "additionalProperties": false, "required": ["estimate", "lower", "upper"], "properties": {"estimate": {"type": "number"}, "lower": {"type": "number"}, "upper": {"type": "number"}}}, "utility_difference_95": {"type": "object", "additionalProperties": false, "required": ["estimate", "lower", "upper"], "properties": {"estimate": {"type": "number"}, "lower": {"type": "number"}, "upper": {"type": "number"}}}}},
    "critical_failures": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "arm", "repetition", "kind", "grade_packet_hash"], "properties": {"case_id": {"type": "string"}, "arm": {"enum": ["baseline", "compact-invariant"]}, "repetition": {"type": "integer", "minimum": 1, "maximum": 2}, "kind": {"type": "string"}, "grade_packet_hash": {"$ref": "#/$defs/hash"}}}},
    "reviewer_agreement": {"type": "object", "additionalProperties": false, "required": ["pre_adjudication_kappa", "agreement_count", "disagreement_count"], "properties": {"pre_adjudication_kappa": {"type": "number", "minimum": -1, "maximum": 1}, "agreement_count": {"type": "integer", "minimum": 0}, "disagreement_count": {"type": "integer", "minimum": 0}}},
    "original_disagreements": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["subject_id", "field", "reviewer_a_packet_hash", "reviewer_b_packet_hash", "resolution"], "properties": {"subject_id": {"type": "string"}, "field": {"type": "string"}, "reviewer_a_packet_hash": {"$ref": "#/$defs/hash"}, "reviewer_b_packet_hash": {"$ref": "#/$defs/hash"}, "resolution": {"enum": ["matching", "adjudicated", "unresolved_missing"]}}}},
    "burden": {"type": "object", "additionalProperties": false, "required": ["median_case_word_ratio", "p90_case_word_ratio", "ratio_case_count", "zero_baseline_rule"], "properties": {"median_case_word_ratio": {"oneOf": [{"type": "number", "minimum": 0}, {"const": "infinite"}]}, "p90_case_word_ratio": {"oneOf": [{"type": "number", "minimum": 0}, {"const": "infinite"}]}, "ratio_case_count": {"const": 24}, "zero_baseline_rule": {"const": "both_zero_one_positive_variant_infinite_string_sentinel"}}},
    "conditional_e2_hypothesis": {"type": ["object", "null"], "additionalProperties": false, "required": ["cited_failure_kind", "procedural_hypothesis", "failure_citations"], "properties": {"cited_failure_kind": {"type": "string", "minLength": 1}, "procedural_hypothesis": {"type": "string", "minLength": 1}, "failure_citations": {"type": "array", "minItems": 3, "maxItems": 24, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "unit_id", "failure_kind", "dimension"], "properties": {"case_id": {"type": "string", "minLength": 1}, "unit_id": {"type": "string", "minLength": 1}, "failure_kind": {"type": "string", "minLength": 1}, "dimension": {"enum": ["actor_fidelity", "speech_act_fidelity", "polarity_fidelity", "modality_qualification_fidelity", "evidence_status_fidelity", "whole_unit_fidelity"]}}}}}},
    "proof_class": {"const": "development_only"}, "non_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "authority_effect": {"const": "none"}
  }
}
