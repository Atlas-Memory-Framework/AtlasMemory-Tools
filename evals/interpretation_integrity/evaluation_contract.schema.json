{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interpretation-integrity.evaluation-contract.v0",
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "positive_integer": {"type": "integer", "minimum": 1}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "eval_id", "decision", "proof_class", "system", "arms", "artifact_hashes", "development_design", "confirmatory_stub", "budgets", "thresholds", "gates", "formulas", "invalidation_reasons", "terminal_dispositions", "non_claims", "authority_effect"],
  "properties": {
    "schema_version": {"const": "interpretation-integrity.evaluation-contract.v0"},
