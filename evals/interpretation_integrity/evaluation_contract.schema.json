      }
    },
    "development_design": {"type": "object", "additionalProperties": false, "required": ["cases", "arms", "repetitions", "worker_outputs", "seed"], "properties": {"cases": {"const": 24}, "arms": {"const": 2}, "repetitions": {"const": 2}, "worker_outputs": {"const": 96}, "seed": {"const": 20260801}}},
    "confirmatory_stub": {"type": "object", "additionalProperties": false, "required": ["cases", "arms", "repetitions", "outputs", "state", "labels_present"], "properties": {"cases": {"const": 72}, "arms": {"const": 2}, "repetitions": {"const": 3}, "outputs": {"const": 432}, "state": {"const": "blocked_missing_protected_worker_boundary"}, "labels_present": {"const": false}}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["e1_logical_invocations", "e1_max_service_attempts", "e2_logical_invocations_no_reuse", "e2_max_service_attempts_no_reuse", "e2_logical_invocations_with_reuse", "e2_max_service_attempts_with_reuse", "e3_logical_invocations", "e3_max_service_attempts", "max_concurrent_attempts", "worker_timeout_seconds", "grader_timeout_seconds", "wall_seconds", "continuous_loop_cycles", "continuous_loop_wall_seconds", "response_words", "input_tokens", "output_tokens", "provider_retries", "max_live_adjudicator_batches", "max_live_adjudicated_outputs"], "properties": {"e1_logical_invocations": {"const": 131}, "e1_max_service_attempts": {"const": 262}, "e2_logical_invocations_no_reuse": {"const": 129}, "e2_max_service_attempts_no_reuse": {"const": 258}, "e2_logical_invocations_with_reuse": {"const": 123}, "e2_max_service_attempts_with_reuse": {"const": 246}, "e3_logical_invocations": {"const": 37}, "e3_max_service_attempts": {"const": 74}, "max_concurrent_attempts": {"const": 3}, "worker_timeout_seconds": {"const": 300}, "grader_timeout_seconds": {"const": 600}, "wall_seconds": {"const": 7200}, "continuous_loop_cycles": {"const": 6}, "continuous_loop_wall_seconds": {"const": 9000}, "response_words": {"const": 600}, "input_tokens": {"const": 1000000}, "output_tokens": {"const": 250000}, "provider_retries": {"const": 1}, "max_live_adjudicator_batches": {"const": 3}, "max_live_adjudicated_outputs": {"const": 24}}},
    "thresholds": {"type": "object", "additionalProperties": false, "required": ["gold_accuracy", "gold_critical_recall", "gold_false_critical_rate", "gold_reviewer_kappa", "fixture_reviewer_kappa", "reviewer_kappa", "invalid_pair_rate", "net_corrected_cases", "absolute_reduction", "relative_reduction", "actor_fidelity", "other_fidelity", "must_address", "clarification_recall", "unnecessary_blocking", "unnecessary_blocking_max_baseline_increase", "direct_completion_max_drop", "median_word_ratio", "p90_word_ratio", "utility_lower_bound"], "properties": {"gold_accuracy": {"const": 0.9}, "gold_critical_recall": {"const": 1.0}, "gold_false_critical_rate": {"const": 0.05}, "gold_reviewer_kappa": {"const": 0.8}, "fixture_reviewer_kappa": {"const": 0.8}, "reviewer_kappa": {"const": 0.75}, "invalid_pair_rate": {"const": 0.1}, "net_corrected_cases": {"const": 3}, "absolute_reduction": {"const": 0.125}, "relative_reduction": {"const": 0.25}, "actor_fidelity": {"const": 0.98}, "other_fidelity": {"const": 0.95}, "must_address": {"const": 0.9}, "clarification_recall": {"const": 0.9}, "unnecessary_blocking": {"const": 0.05}, "unnecessary_blocking_max_baseline_increase": {"const": 0.02}, "direct_completion_max_drop": {"const": 0.03}, "median_word_ratio": {"const": 1.25}, "p90_word_ratio": {"const": 1.5}, "utility_lower_bound": {"const": -0.25}}},
    "gates": {"type": "object", "additionalProperties": false, "required": ["fixture_label_review", "gold_label_review", "live_grading", "e2_admission"], "properties": {
      "fixture_label_review": {"type": "object", "additionalProperties": false, "required": ["independent_reviewers", "full_case_count", "pooled_noncritical_kappa_minimum", "max_noncritical_adjudicated_cases", "critical_disagreements_allowed", "unresolved_fields_allowed", "post_output_relabeling_allowed"], "properties": {"independent_reviewers": {"const": 2}, "full_case_count": {"const": 24}, "pooled_noncritical_kappa_minimum": {"const": 0.8}, "max_noncritical_adjudicated_cases": {"const": 8}, "critical_disagreements_allowed": {"const": 0}, "unresolved_fields_allowed": {"const": 0}, "post_output_relabeling_allowed": {"const": false}}},
      "gold_label_review": {"type": "object", "additionalProperties": false, "required": ["independent_reviewers", "gold_count", "overall_correct_minimum", "critical_recall_required", "noncritical_false_critical_allowed", "pre_adjudication_kappa_minimum", "max_adjudicated_items", "critical_overall_mismatches_allowed"], "properties": {"independent_reviewers": {"const": 2}, "gold_count": {"const": 24}, "overall_correct_minimum": {"const": 22}, "critical_recall_required": {"const": 8}, "noncritical_false_critical_allowed": {"const": 0}, "pre_adjudication_kappa_minimum": {"const": 0.8}, "max_adjudicated_items": {"const": 8}, "critical_overall_mismatches_allowed": {"const": 0}}},
      "live_grading": {"type": "object", "additionalProperties": false, "required": ["independent_reviewers", "pre_adjudication_kappa_minimum", "max_adjudicated_outputs", "max_adjudicator_batches", "personal_intent_adjudication_allowed"], "properties": {"independent_reviewers": {"const": 2}, "pre_adjudication_kappa_minimum": {"const": 0.75}, "max_adjudicated_outputs": {"const": 24}, "max_adjudicator_batches": {"const": 3}, "personal_intent_adjudication_allowed": {"const": false}}},
      "e2_admission": {"type": "object", "additionalProperties": false, "required": ["requires_complete_e1_scorecard", "requires_material_cited_failure", "requires_procedural_hypothesis"], "properties": {"requires_complete_e1_scorecard": {"const": true}, "requires_material_cited_failure": {"const": true}, "requires_procedural_hypothesis": {"const": true}}}
    }},
    "formulas": {"type": "object", "additionalProperties": false, "required": ["complete_collection_digest", "fixture_kappa_order", "word_burden", "primary_incremental_rule", "terminal_precedence"], "properties": {"complete_collection_digest": {"type": "string", "minLength": 1}, "fixture_kappa_order": {"type": "string", "minLength": 1}, "word_burden": {"type": "string", "minLength": 1}, "primary_incremental_rule": {"type": "string", "minLength": 1}, "terminal_precedence": {"type": "string", "minLength": 1}}},
    "invalidation_reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "terminal_dispositions": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"enum": ["development_candidate_pass", "behaviorally_acceptable_no_incremental_evidence", "candidate_fail", "evaluation_inconclusive", "operationally_blocked"]}},
    "non_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_effect": {"const": "none"}
  }
}
