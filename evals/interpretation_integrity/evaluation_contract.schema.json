    "proof_class": {"const": "development_only"},
    "system": {"type": "object", "additionalProperties": false, "required": ["code_ref", "worker_model", "worker_reasoning", "grader_model", "grader_reasoning", "adjudicator_reasoning", "tool_boundary", "authority_policy"], "properties": {"code_ref": {"type": "string", "minLength": 1}, "worker_model": {"const": "gpt-5.6-terra"}, "worker_reasoning": {"const": "medium"}, "grader_model": {"const": "gpt-5.6-sol"}, "grader_reasoning": {"const": "medium"}, "adjudicator_reasoning": {"const": "high"}, "tool_boundary": {"type": "string", "minLength": 1}, "authority_policy": {"const": "interpretation-integrity.privacy-policy.v0"}}},
    "arms": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["arm_id", "version", "intervention_hash"], "properties": {"arm_id": {"enum": ["baseline", "compact-invariant"]}, "version": {"const": "v0"}, "intervention_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}}}},
    "artifact_hashes": {
