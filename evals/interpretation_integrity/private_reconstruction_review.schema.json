{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "interpretation-integrity.private-reconstruction-review.v0",
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "result": {"enum": ["pass", "fail", "disputed"]}},
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "assignment_hash", "packet_hash", "reviewer_session_binding", "source_results", "case_results", "unit_results", "leakage_checks", "mosaic_result", "complete_coverage", "structural_fidelity", "reconstructability", "authority_effect"],
  "properties": {
    "schema_version": {"const": "interpretation-integrity.private-reconstruction-review.v0"}, "assignment_hash": {"$ref": "#/$defs/hash"}, "packet_hash": {"$ref": "#/$defs/hash"}, "reviewer_session_binding": {"$ref": "#/$defs/hash"},
    "source_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_alias", "disposition_result"], "properties": {"source_alias": {"type": "string", "pattern": "^source-[0-9]{3}$"}, "disposition_result": {"$ref": "#/$defs/result"}}}},
    "case_results": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "origin_result", "failure_family_result"], "properties": {"case_id": {"type": "string", "minLength": 1}, "origin_result": {"$ref": "#/$defs/result"}, "failure_family_result": {"$ref": "#/$defs/result"}}}},
    "unit_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "unit_id", "actor", "expression_act", "stance", "modality", "evidence_status", "qualification", "frame_origin", "response_requirement", "severity"], "properties": {"case_id": {"type": "string", "minLength": 1}, "unit_id": {"type": "string", "minLength": 1}, "actor": {"$ref": "#/$defs/result"}, "expression_act": {"$ref": "#/$defs/result"}, "stance": {"$ref": "#/$defs/result"}, "modality": {"$ref": "#/$defs/result"}, "evidence_status": {"$ref": "#/$defs/result"}, "qualification": {"$ref": "#/$defs/result"}, "frame_origin": {"$ref": "#/$defs/result"}, "response_requirement": {"$ref": "#/$defs/result"}, "severity": {"$ref": "#/$defs/result"}}}},
    "leakage_checks": {"type": "object", "additionalProperties": false, "required": ["verbatim_near_verbatim", "unique_names_entities", "distinctive_numbers_dates", "distinctive_analogy_narrative"], "properties": {"verbatim_near_verbatim": {"$ref": "#/$defs/result"}, "unique_names_entities": {"$ref": "#/$defs/result"}, "distinctive_numbers_dates": {"$ref": "#/$defs/result"}, "distinctive_analogy_narrative": {"$ref": "#/$defs/result"}}},
    "mosaic_result": {"$ref": "#/$defs/result"}, "complete_coverage": {"type": "boolean"}, "structural_fidelity": {"$ref": "#/$defs/result"}, "reconstructability": {"enum": ["not_reconstructive", "reconstructive", "disputed"]}, "authority_effect": {"const": "none"}
  }
}
