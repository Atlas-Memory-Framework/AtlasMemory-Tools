{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "interpretation-integrity.run-state.v0",
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["count", "digest"], "properties": {"count": {"type": "integer", "minimum": 0}, "digest": {"$ref": "#/$defs/hash"}}},
    "usage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}}},
    "nullable_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "trial_key", "case_id", "arm", "repetition", "schedule_position", "pair_key", "contract_hash", "corpus_hash", "common_prompt_hash", "intervention_hash", "stage_identity_hash", "worker_model", "worker_reasoning", "configuration_hash", "instruction_inventory", "started_at_epoch_ms", "finished_at_epoch_ms", "usage", "attempts", "terminal_state", "terminal_reason", "elapsed_ms", "opaque_artifact_id", "excluded_inventory_before_digest", "excluded_inventory_after_digest", "proof_class", "non_claims", "authority_effect"],
  "properties": {
    "schema_version": {"const": "interpretation-integrity.run-state.v0"}, "trial_key": {"$ref": "#/$defs/hash"}, "case_id": {"type": "string", "minLength": 1}, "arm": {"enum": ["baseline", "compact-invariant", "procedural-skill"]}, "repetition": {"type": "integer", "minimum": 1, "maximum": 3}, "schedule_position": {"type": "integer", "minimum": 1}, "pair_key": {"$ref": "#/$defs/hash"}, "contract_hash": {"$ref": "#/$defs/hash"}, "corpus_hash": {"$ref": "#/$defs/hash"}, "common_prompt_hash": {"$ref": "#/$defs/hash"}, "intervention_hash": {"$ref": "#/$defs/nullable_hash"}, "stage_identity_hash": {"$ref": "#/$defs/hash"}, "worker_model": {"type": "string", "minLength": 1}, "worker_reasoning": {"type": "string", "minLength": 1}, "configuration_hash": {"$ref": "#/$defs/hash"}, "instruction_inventory": {"$ref": "#/$defs/inventory"}, "started_at_epoch_ms": {"type": "integer", "minimum": 0}, "finished_at_epoch_ms": {"type": "integer", "minimum": 0}, "usage": {"$ref": "#/$defs/usage"},
    "attempts": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["attempt_number", "attempt_key", "reason", "returncode", "violation_codes", "terminal_reason", "usage", "instruction_inventory"], "properties": {"attempt_number": {"type": "integer", "minimum": 1, "maximum": 2}, "attempt_key": {"$ref": "#/$defs/hash"}, "reason": {"enum": ["initial", "provider_timeout", "provider_transport"]}, "returncode": {"type": ["integer", "null"]}, "violation_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "terminal_reason": {"type": "string", "minLength": 1}, "usage": {"$ref": "#/$defs/usage"}, "instruction_inventory": {"$ref": "#/$defs/inventory"}}}},
    "terminal_state": {"enum": ["complete", "blocked", "failed", "invalid"]}, "terminal_reason": {"type": "string", "minLength": 1}, "elapsed_ms": {"type": "integer", "minimum": 0}, "opaque_artifact_id": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"}, "excluded_inventory_before_digest": {"$ref": "#/$defs/nullable_hash"}, "excluded_inventory_after_digest": {"$ref": "#/$defs/nullable_hash"}, "proof_class": {"const": "development_only"}, "non_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "authority_effect": {"const": "none"}
  }
}
