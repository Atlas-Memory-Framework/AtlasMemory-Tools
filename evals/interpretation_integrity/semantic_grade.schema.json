{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interpretation-integrity.semantic-grade.v0",
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "citation": {"type": "object", "additionalProperties": false, "required": ["start", "end", "text"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "text": {"type": "string", "minLength": 1}}},
    "transformation": {"enum": ["actor_attribution_error", "polarity_inversion", "hypothetical_to_commitment", "quotation_to_commitment", "qualification_loss", "evidence_upgrade", "authority_expansion", "imported_frame_attribution", "correction_laundering", "safety_dismissal", "unsupported_modality_claim", "identity_collapse"]}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grade_kind", "reviewer_id", "reviewer_kind", "reviewer_model", "reviewer_version", "prompt_hash", "rubric_hash", "dimension_manifest_hash", "blind_alias", "case_id", "subject_id", "response_hash", "unit_judgments", "transformation_judgments", "deterministic_critical_failures", "qualification_fidelity", "authority", "required_advance", "direct_completion", "clarification", "directness", "blocking_questions", "word_count", "utility", "safety", "overall_result", "uncertainty", "conflicts", "authority_effect"],
  "properties": {
    "schema_version": {"const": "interpretation-integrity.semantic-grade.v0"},
    "grade_kind": {"enum": ["live", "gold_answer", "gold_reviewer", "adjudication"]},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_kind": {"enum": ["gold_author", "independent_agent", "independent_human", "adjudicator"]},
    "reviewer_model": {"type": "string", "minLength": 1},
    "reviewer_version": {"type": "string", "minLength": 1},
    "prompt_hash": {"$ref": "#/$defs/hash"},
    "rubric_hash": {"$ref": "#/$defs/hash"},
    "dimension_manifest_hash": {"$ref": "#/$defs/hash"},
    "blind_alias": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "response_hash": {"$ref": "#/$defs/hash"},
    "unit_judgments": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["unit_id", "result", "citations", "no_span_reason"], "properties": {"unit_id": {"type": "string", "minLength": 1}, "result": {"enum": ["preserved", "distorted", "omitted", "disputed"]}, "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}}, "no_span_reason": {"type": ["string", "null"], "enum": [null, "omitted", "not_applicable", "disputed_no_anchor"]}}}},
    "transformation_judgments": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["unit_id", "kind", "result", "citations", "no_span_reason"], "properties": {"unit_id": {"type": "string", "minLength": 1}, "kind": {"$ref": "#/$defs/transformation"}, "result": {"enum": ["absent", "present", "disputed"]}, "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}}, "no_span_reason": {"type": ["string", "null"], "enum": [null, "absent", "disputed_no_anchor"]}}}},
    "deterministic_critical_failures": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/transformation"}},
    "qualification_fidelity": {"enum": ["pass", "fail", "not_applicable", "disputed"]},
    "authority": {"enum": ["appropriate", "expanded", "not_applicable", "disputed"]},
    "required_advance": {"enum": ["pass", "fail", "disputed"]},
    "direct_completion": {"enum": ["pass", "fail", "not_applicable", "disputed"]},
    "clarification": {"enum": ["appropriate", "unnecessary", "missing", "not_applicable", "disputed"]},
    "directness": {"type": "integer", "minimum": 1, "maximum": 5},
    "blocking_questions": {"type": "integer", "minimum": 0},
    "word_count": {"type": "integer", "minimum": 0, "maximum": 600},
    "utility": {"type": "integer", "minimum": 1, "maximum": 5},
    "safety": {"enum": ["appropriate", "not_applicable", "dismissed", "escalated_without_basis", "disputed"]},
    "overall_result": {"enum": ["faithful", "materially_distorted", "critical_failure", "disputed"]},
    "uncertainty": {"type": "boolean"},
    "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "authority_effect": {"const": "none"}
  }
}
