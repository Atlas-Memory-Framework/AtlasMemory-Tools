{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "interpretation-integrity.worker-output.v0",
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "inventory": {"type": "object", "additionalProperties": false, "required": ["count", "digest"], "properties": {"count": {"type": "integer", "minimum": 0}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, "usage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}}}},
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "trial_key", "case_id", "arm", "repetition", "schedule_position", "contract_hash", "corpus_hash", "response_text", "word_count", "instruction_inventory", "usage", "proof_class", "non_claims", "authority_effect"],
  "properties": {"schema_version": {"const": "interpretation-integrity.worker-output.v0"}, "trial_key": {"$ref": "#/$defs/hash"}, "case_id": {"type": "string", "minLength": 1}, "arm": {"enum": ["baseline", "compact-invariant", "procedural-skill"]}, "repetition": {"type": "integer", "minimum": 1, "maximum": 3}, "schedule_position": {"type": "integer", "minimum": 1}, "contract_hash": {"$ref": "#/$defs/hash"}, "corpus_hash": {"$ref": "#/$defs/hash"}, "response_text": {"type": "string", "maxLength": 12000}, "word_count": {"type": "integer", "minimum": 0, "maximum": 600}, "instruction_inventory": {"$ref": "#/$defs/inventory"}, "usage": {"$ref": "#/$defs/usage"}, "proof_class": {"const": "development_only"}, "non_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "authority_effect": {"const": "none"}}
}
