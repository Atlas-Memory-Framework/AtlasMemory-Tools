{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interpretation-integrity.private-selection.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root_session_id", "source_prefix_length", "source_prefix_digest", "complete_record_count", "selections"],
  "properties": {
    "schema_version": {"const": "interpretation-integrity.private-selection.v0"},
    "root_session_id": {"type": "string", "minLength": 1},
    "source_prefix_length": {"type": "integer", "minimum": 1},
    "source_prefix_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "complete_record_count": {"type": "integer", "minimum": 1},
    "selections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["turn_id", "message_id", "envelope_digest"], "properties": {"turn_id": {"type": "string", "minLength": 1}, "message_id": {"type": "string", "minLength": 1}, "envelope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}
  }
}
